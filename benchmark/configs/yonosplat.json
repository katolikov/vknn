{
  "defaults": {
    "device": {
      "serial": "",
      "dir": "/data/local/tmp/vknn/bench",
      "cooldown": 22
    },
    "run": {
      "backend": "vulkan",
      "precision": "normal",
      "cache_mode": "full",
      "generate_cache": true,
      "max_submit_nodes": 500,
      "tolerance": 0.999
    }
  },
  "stages": [
    {
      "name": "yonosplat_encoder8_validate",
      "model": "models/encoder8_fp16.vxm",
      "inputs": {
        "image": "models/image8.npy",
        "intrinsics": "models/intr8.npy"
      },
      "golden": {
        "means": "models/means_gold.npy",
        "covariances": "models/covariances_gold.npy",
        "harmonics": "models/harmonics_gold.npy",
        "opacities": "models/opacities_gold.npy",
        "rotations": "models/rotations_gold.npy",
        "scales": "models/scales_gold.npy"
      },
      "metrics": [
        "cosine",
        "psnr",
        "snr",
        "relL2",
        "max"
      ],
      "save": [
        "npy"
      ],
      "run": {
        "iters": 3,
        "warmup": 1
      }
    },
    {
      "name": "yonosplat_encoder8_runtime_only",
      "model": "models/encoder8_fp16.vxm",
      "run": {
        "iters": 5,
        "warmup": 1
      }
    }
  ]
}
