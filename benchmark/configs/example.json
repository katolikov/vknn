{
  "defaults": {
    "device": {
      "serial": "",
      "dir": "/data/local/tmp/vknn/bench"
    },
    "run": {
      "backend": "vulkan",
      "precision": "low",
      "iters": 10,
      "warmup": 2,
      "tolerance": 0.999
    }
  },
  "stages": [
    {
      "name": "encoder8_dl3dv",
      "model": "models/encoder8_dl3dv_fp16.vxm",
      "inputs": [
        "models/dl3dv"
      ],
      "metrics": [
        "cosine",
        "psnr",
        "snr"
      ],
      "save": [
        "npy"
      ],
      "pull": [
        "cache"
      ]
    },
    {
      "name": "encoder8_runtime_only",
      "model": "models/encoder8_dl3dv_fp16.vxm",
      "run": {
        "iters": 5,
        "warmup": 1
      }
    }
  ]
}
