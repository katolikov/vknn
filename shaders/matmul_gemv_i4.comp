#version 450
#define VKNN_NO_RTE 1 // this kernel avoids the float-controls execution mode (miscompiled by some drivers); TO_STORE rounds explicitly
#include "precision.glsl"
#ifdef PW_EPI
#define PW_EPI_BASE 6
#include "pw_epilogue.glsl"
#endif
// Split-K mat-vec over an int4-packed weight (vknn_compile -Os): the matmul_gemv_wq_core.glsl body
// with the int4 decode surface (core/quant_int4.h). A lane's 8-output block is ONE packed 32-bit
// word — 8 sign-extended nibbles, unpacked with bitfieldExtract — so 4-bit packing moves a quarter
// of the bytes the fp16 kernel does. Thread layout, addressing, and the interior-lane / whole-group
// specializations are documented in the head/core includes.
#include "common.glsl"
#include "matmul_gemv_wq_head.glsl"

// Sign-extended int4 lanes 0..3 / 4..7 of a packed word.
vec4 nibLo(uint w) {
  return vec4(bitfieldExtract(int(w), 0, 4), bitfieldExtract(int(w), 4, 4),
              bitfieldExtract(int(w), 8, 4), bitfieldExtract(int(w), 12, 4));
}
vec4 nibHi(uint w) {
  return vec4(bitfieldExtract(int(w), 16, 4), bitfieldExtract(int(w), 20, 4),
              bitfieldExtract(int(w), 24, 4), bitfieldExtract(int(w), 28, 4));
}

#define WQ_WORD_T uint
#define WQ_LOAD_W(idx) bp[idx]
#define WQ_DEC_LO nibLo
#define WQ_DEC_HI nibHi
#define WQ_BLOCK_COL(n) ((n) / 8) // one word per 8-output block

#include "matmul_gemv_wq_core.glsl"
