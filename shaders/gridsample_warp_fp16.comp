#version 450
// Warp-mode GridSample (NC4HW4 fp16 data, fused scaled-flow coordinate source). Instead of a
// materialized grid this reads an NCHW flow [N,2,OH,OW] (binding 1, NC4HW4) and a base grid
// [.,OH,OW,2] (binding 2, fp32) and computes the sample coordinate coord = base + scale*flow inline
// (fuseGridSampleWarp). The product reproduces the standalone flat_binary Mul it replaces bit for bit:
// flow (fp16) times the fp16-narrowed scale (baked in pc.scale), rounded to fp16 through the same
// integer-exact vknnRte16, then widened and added to the fp32 base — the fp32 grid the split
// Mul+Transpose+Add stored. The sampler body (fetch/cubic/reflection) is identical to gridsample_fp16,
// so the warp output is byte-identical to the materialized-grid path. MODE: 0=bilinear 1=nearest
// 2=cubic. PADMODE: 0=zeros 1=border 2=reflection.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"
#ifdef PW_EPI
#define STORE float16_t
#define PW_EPI_BASE 4
#include "pw_epilogue.glsl"
#endif
layout(constant_id = 0) const int MODE = 0;
layout(constant_id = 1) const int PADMODE = 0;
// FLOW_FP32 selects the flow buffer's storage decode, exactly like the plain kernel's GRID_FP32:
// pinSampleCoordFp32 pins the flow cone to fp32 storage, and fp16-quantized flow drifts the
// sample point ~0.5-1 px at 2k-wide inputs. The buffer binds as raw words; one NC4HW4 block per
// pixel is 2 words at fp16 (lanes x/y in word 0) or 4 words at fp32 (x, y in words 0/1).
layout(constant_id = 2) const int FLOW_FP32 = 0;
layout(local_size_x = 64, local_size_x_id = 3) in; // trailing spec = device-resolved lane width (env.convLocalSize)
layout(std430, binding = 0) readonly  buffer Src  { f16vec4 src[]; };
layout(std430, binding = 1) readonly  buffer Flow { uint flowWords[]; };
layout(std430, binding = 2) readonly  buffer Base { float base[]; };
layout(std430, binding = 3) writeonly buffer Dst  { f16vec4 dst[]; };
layout(push_constant) uniform PC { int N, C, Hin, Win, OH, OW, align; float scale; int baseNStride; } pc;

float reflectc(float x, float lo, float hi) {
  if (hi <= lo) return lo;
  float rng = hi - lo, t = mod(x - lo, 2.0 * rng);
  if (t < 0.0) t += 2.0 * rng;
  if (t > rng) t = 2.0 * rng - t;
  return lo + t;
}
float handle(float c, int S) {
  if (PADMODE == 2) return reflectc(c, pc.align == 1 ? 0.0 : -0.5, pc.align == 1 ? float(S - 1) : float(S) - 0.5);
  return c;
}
// fetch a channel-block vec4 at (px,py) with padding behaviour; returns vec4(0) for zeros-OOB.
// Reflection reflects each tap (cubic taps reach +-2 px past the mapped coordinate, where a clamp
// diverges from the reflected pixel; for linear/nearest the two agree).
vec4 fetchBlk(int sb, int px, int py, int Cb) {
  if (PADMODE == 0) { if (px < 0 || px >= pc.Win || py < 0 || py >= pc.Hin) return vec4(0.0); }
  else if (PADMODE == 2) {
    px = clamp(int(round(reflectc(float(px), pc.align == 1 ? 0.0 : -0.5, pc.align == 1 ? float(pc.Win - 1) : float(pc.Win) - 0.5))), 0, pc.Win - 1);
    py = clamp(int(round(reflectc(float(py), pc.align == 1 ? 0.0 : -0.5, pc.align == 1 ? float(pc.Hin - 1) : float(pc.Hin) - 0.5))), 0, pc.Hin - 1);
  }
  else { px = clamp(px, 0, pc.Win - 1); py = clamp(py, 0, pc.Hin - 1); }
  return vec4(src[sb + py * pc.Win + px]);
}
// Cubic convolution weights (alpha = -0.75): taps at floor-1..floor+2 per axis.
void cubicW(float t, out float w[4]) {
  const float A = -0.75;
  float t1 = 1.0 + t, t2 = 2.0 - t;
  w[0] = A * t1 * t1 * t1 - 5.0 * A * t1 * t1 + 8.0 * A * t1 - 4.0 * A;
  w[1] = (A + 2.0) * t * t * t - (A + 3.0) * t * t + 1.0;
  w[2] = (A + 2.0) * (1.0 - t) * (1.0 - t) * (1.0 - t) - (A + 3.0) * (1.0 - t) * (1.0 - t) + 1.0;
  w[3] = A * t2 * t2 * t2 - 5.0 * A * t2 * t2 + 8.0 * A * t2 - 4.0 * A;
}

void main() {
  int Cb = (pc.C + 3) / 4;
  // One lane per output PIXEL, looping the channel blocks inside: the flow/base fetch, the
  // coordinate normalize/handle and (in cubic mode) the two weight fans carry no channel term, so a
  // lane-per-block-pixel map replayed all of it Cb times in waves OH*OW apart that share no cache.
  // The lane count in gridsample.cpp is N*OH*OW and every variant of this kernel must agree with it.
  uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (i >= uint(pc.N * pc.OH * pc.OW)) return;
  int ox = int(i) % pc.OW;
  int oy = (int(i) / pc.OW) % pc.OH;
  int n = int(i) / (pc.OW * pc.OH);
  // Coordinate = base + scale*flow. flow is NC4HW4 with C=2, so one block per pixel holds
  // (flow_x, flow_y) in lanes .x/.y. The product rounds to fp16 exactly as the standalone Mul did
  // (vknnRte16 == flat_binary's VKNN_NO_RTE store), then widens into the fp32 base add.
  int fb = n * pc.OH * pc.OW + oy * pc.OW + ox;
  float fscx, fscy;
  if (FLOW_FP32 != 0) {
    // Pinned flow: full-precision coordinates, no parity rounding - the pin exists to remove it.
    fscx = uintBitsToFloat(flowWords[4 * fb + 0]) * pc.scale;
    fscy = uintBitsToFloat(flowWords[4 * fb + 1]) * pc.scale;
  } else {
    vec2 f = unpackHalf2x16(flowWords[2 * fb]);
    fscx = float(vknnRte16(f.x * pc.scale));
    fscy = float(vknnRte16(f.y * pc.scale));
  }
  int bi = n * pc.baseNStride + 2 * (oy * pc.OW + ox);
  int a = pc.align == 1 ? 1 : 0, b = 1 - a;
  float ix = handle(((1.0 + (base[bi + 0] + fscx)) * float(pc.Win - a) - float(b)) * 0.5, pc.Win);
  float iy = handle(((1.0 + (base[bi + 1] + fscy)) * float(pc.Hin - a) - float(b)) * 0.5, pc.Hin);
  // Tap positions and weights: identical fp32 arithmetic to the per-block form, evaluated once.
  int rx = 0, ry = 0, x0 = 0, y0 = 0;
  float wxc[4], wyc[4];
  float wxl = 0.0, wyl = 0.0;
  if (MODE == 1) {
    rx = int(floor(ix + 0.5)); ry = int(floor(iy + 0.5));
  } else if (MODE == 2) {
    x0 = int(floor(ix)); y0 = int(floor(iy));
    cubicW(ix - float(x0), wxc);
    cubicW(iy - float(y0), wyc);
  } else {
    x0 = int(floor(ix)); y0 = int(floor(iy));
    wxl = ix - float(x0); wyl = iy - float(y0);
  }
  for (int cb = 0; cb < Cb; ++cb) {
    int sb = (n * Cb + cb) * pc.Hin * pc.Win;
    vec4 v;
    if (MODE == 1) {
      v = fetchBlk(sb, rx, ry, Cb);
    } else if (MODE == 2) {
      v = vec4(0.0);
      for (int j = 0; j < 4; ++j)
        for (int i2 = 0; i2 < 4; ++i2)
          v += wyc[j] * wxc[i2] * fetchBlk(sb, x0 - 1 + i2, y0 - 1 + j, Cb);
    } else {
      vec4 v00 = fetchBlk(sb, x0, y0, Cb), v01 = fetchBlk(sb, x0 + 1, y0, Cb);
      vec4 v10 = fetchBlk(sb, x0, y0 + 1, Cb), v11 = fetchBlk(sb, x0 + 1, y0 + 1, Cb);
      v = (1.0 - wyl) * ((1.0 - wxl) * v00 + wxl * v01) + wyl * ((1.0 - wxl) * v10 + wxl * v11);
    }
    int outIdx = (n * Cb + cb) * pc.OH * pc.OW + oy * pc.OW + ox;
#ifdef PW_EPI
    v = pw_apply4(v, outIdx);
#endif
    // TO_STORE4 saturates the cubic kernel's negative-lobe overshoot (up to ~1.06x the input
    // range), so a near-fp16-max activation never stores as +/-inf; byte-identical in range.
    dst[outIdx] = TO_STORE4(v);
  }
}
