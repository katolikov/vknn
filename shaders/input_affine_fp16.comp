#version 450
// Standalone application of a conv's input-affine prologue (input_affine.glsl) into a scratch
// tensor, for the conv kernel families without a _pro variant: the same unit, one thread per
// NC4HW4 vec4, so every conv path stays correct while only the common families fold it inline.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"
#define PRO_BASE 2
#define PRO_VEC f16vec4
#include "input_affine.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Src { f16vec4 src[]; };
layout(std430, binding = 1) writeonly buffer Dst { f16vec4 dst[]; };
layout(push_constant) uniform PC { int N, Cinb, HW, flags, act; float lo, hi; } pc;
void main() {
  uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (gid >= uint(pc.N * pc.Cinb * pc.HW)) return;
  int blk = int(gid) / pc.HW;
  int icb = blk % pc.Cinb, n = blk / pc.Cinb;
  vec4 s = proScaleOf(pc.flags, n, icb, pc.Cinb), b = proShiftOf(pc.flags, n, icb, pc.Cinb);
  dst[gid] = TO_STORE4(proApply(vec4(src[gid]), s, b, pc.flags, pc.act, pc.lo, pc.hi));
}
