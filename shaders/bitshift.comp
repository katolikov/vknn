#version 450
// Integer results store through the explicit integer-exact rounding (vknnRte16) in the fp16 variant.
#define VKNN_NO_RTE 1
#include "precision.glsl"
// Flat broadcasting BitShift of operand a by operand b at the operand's integer width (push constant
// intBits, from the node's int_bits attribute; directionLeft is 1 for LEFT, 0 for RIGHT). Power-of-two
// float scaling reproduces the CPU oracle's bit arithmetic on the integer values (see bitShiftValue) and
// stores the oracle's fp32 lane for every operand. The per-axis output dims and operand strides live in a
// geometry SSBO (binding 3) packed back-to-back: outDim = geometry[0..rank), aStride =
// geometry[rank..2*rank), bStride = geometry[2*rank..3*rank).
#include "bitwise_int.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer OperandA { STORE operandA[]; };
layout(std430, binding = 1) readonly  buffer OperandB { STORE operandB[]; };
layout(std430, binding = 2) writeonly buffer Destination { STORE destination[]; };
layout(std430, binding = 3) readonly  buffer Geometry { int geometry[]; };
layout(push_constant) uniform PC { int rank, total, directionLeft, intBits; } pc;

// Index of operand B's stride array inside the geometry SSBO, in units of rank (operand A's strides
// directly follow outDim, at index 1).
const int kGeomBStrideArray = 2;

// INT64_MAX (0x7FFF...F, the oracle's value of a lane saturated at +2^63) shifted by shiftBits at 64 bits:
// itself (stored as 2^63) for shiftBits == 0; LEFT wraps to -2^shiftBits; RIGHT is 2^(63 - shiftBits) - 1.
float int64MaxShifted(int shiftBits, int directionLeft) {
  if (shiftBits == 0) return kTwoPow63;
  if (directionLeft != 0) return -powerOfTwo(shiftBits);
  precise float shifted = powerOfTwo(kInt64SignBit - shiftBits) - 1.0;
  return shifted;
}

// value shifted by shift at intBits width. A shift count outside [0, intBits) yields 0 (checked on the
// float before any int conversion). A zero shift is value's own intBits-wide wrap (signed at 64 bits, like
// the oracle's int64 view). LEFT: the low intBits bits of value * 2^shiftBits. RIGHT: the logical shift of
// value's low intBits bits, which equals floor(value / 2^shiftBits) reduced modulo 2^(intBits - shiftBits).
float bitShiftValue(float value, float shift, int directionLeft, int intBits) {
  float shiftCount = integerOperand(shift);
  if (shiftCount < 0.0 || shiftCount >= float(intBits)) return 0.0;
  int shiftBits = int(shiftCount);
  float integer = integerOperand(value);
  if (intBits >= kInt64Bits && integer >= kTwoPow63) return int64MaxShifted(shiftBits, directionLeft);
  float operand = narrowWidthOperand(integer);
  if (shiftBits == 0) return wrapToWidth(operand, intBits);
  if (directionLeft != 0) {
    precise float shifted = operand * powerOfTwo(shiftBits);
    return wrapToWidth(shifted, intBits);
  }
  precise float quotient = floor(operand / powerOfTwo(shiftBits));
  return residueModPowerOfTwo(quotient, intBits - shiftBits);
}

void main() {
  uint elementIndex = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (elementIndex >= uint(pc.total)) return;
  int remainingIndex = int(elementIndex), operandAIndex = 0, operandBIndex = 0;
  for (int axis = pc.rank - 1; axis >= 0; --axis) {
    int axisCoordinate = remainingIndex % geometry[axis];
    remainingIndex /= geometry[axis];
    operandAIndex += axisCoordinate * geometry[pc.rank + axis];
    operandBIndex += axisCoordinate * geometry[kGeomBStrideArray * pc.rank + axis];
  }
  destination[elementIndex] = TO_STORE(bitShiftValue(float(operandA[operandAIndex]), float(operandB[operandBIndex]), pc.directionLeft, pc.intBits));
}
