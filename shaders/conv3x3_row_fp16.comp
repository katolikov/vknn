#version 450
// 3x3 dilation-1 group-1 conv with horizontal halo reuse (NC4HW4, fp16 storage).
//
// The tile is WTILE output pixels along ONE output row, so it spans COLS = (WTILE-1)*SW + 3 input
// columns: each (icb, ky) loads that row segment into registers once and every (kx, pixel) pair reads
// it there. Input loads per output pixel per channel-block drop from conv_reg's 9 to COLS/WTILE (1.5
// at WTILE=4, stride 1), which is the wall on tiny-channel maps -- the reduction over Cin is too short
// to hide the L2 round trips. Weights load once per (icb, ky, kx) and are reused across WTILE pixels.
//
// Bit-exact with conv_reg: same loop nest, same tap order, same out-of-bounds skip (accumulating a
// zero instead would flip an accumulator's -0.0 to +0.0). Only the source of `inv` changes.
//
// SW is a spec constant because COLS sizes a register array; SH stays in the push constants.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"
#ifdef PW_EPI
#define STORE float16_t
#define PW_EPI_BASE 4
#include "pw_epilogue.glsl"
#endif
#ifdef PW_PRO
#define PRO_BASE 4
#define PRO_VEC f16vec4
#include "input_affine.glsl"
#endif
// Specialization-constant mirrors of src/core/conv_dispatch_rules.h (keep in lockstep):
// CONV_ROW_*_SPEC are kConvRowOcbSpecIndex, kConvRowPixelTileSpecIndex, kConvRowStrideSpecIndex and
// kConvRowLaneWidthSpecIndex. The host states every slot through convRowSpecConstants(), so the
// DECLARED lane width only stands in for a standalone compile - a pipeline built without it would
// run at a width its dispatch does not divide by and leave the outputs past that width unwritten.
#define CONV_ROW_OCB_SPEC 0
#define CONV_ROW_WTILE_SPEC 1
#define CONV_ROW_SW_SPEC 2
#define CONV_ROW_TILES_PER_WG_SPEC 3
#define CONV_ROW_LANE_WIDTH_SPEC 4
#define CONV_ROW_DECLARED_TILES_PER_WG 16
#define CONV_ROW_DECLARED_LANE_WIDTH 64
layout(constant_id = CONV_ROW_OCB_SPEC) const int OCB_BLK = 1; // output channel-blocks (of 4 oc) computed per thread
layout(constant_id = CONV_ROW_WTILE_SPEC) const int WTILE = 4; // output pixels per thread, consecutive along W
layout(constant_id = CONV_ROW_SW_SPEC) const int SW_SPEC = 1;  // horizontal stride (sizes the row segment)
// Column-tiles per workgroup: a workgroup covers TILES_PER_WG tiles of LANE_WIDTH / TILES_PER_WG
// consecutive output rows, so one wave's loads span a 2-D patch of the input rather than one long
// strip of a single row (raced per shape; both values divide the lane width).
layout(constant_id = CONV_ROW_TILES_PER_WG_SPEC) const int TILES_PER_WG = CONV_ROW_DECLARED_TILES_PER_WG;
layout(local_size_x = CONV_ROW_DECLARED_LANE_WIDTH, local_size_x_id = CONV_ROW_LANE_WIDTH_SPEC) in;
#define COLS ((WTILE - 1) * SW_SPEC + 3)
layout(std430, binding = 0) readonly buffer Src { f16vec4 src[]; };
layout(std430, binding = 1) readonly buffer Wt { f16vec4 wt[]; };
layout(std430, binding = 2) readonly buffer Bs { f16vec4 bias[]; };
layout(std430, binding = 3) writeonly buffer Dst { f16vec4 dst[]; };
layout(push_constant) uniform PC {
  int N, Cin, H, W, Cout, OH, OW, KH, KW, SH, SW, PT, PL, DH, DW, act;
  float actLo, actHi;
  int gidBase; // first flat gid of this dispatch's OC-split slice (0 = whole range)
#ifdef PW_PRO
  int proFlags, proAct; // input-affine prologue (input_affine.glsl): flags and activation
  float proLo, proHi;
#endif
} pc;

void main() {
  int Cinb = (pc.Cin + 3) / 4;
  int Coutb = (pc.Cout + 3) / 4;
  int HW = pc.OH * pc.OW;
  int nTX = (pc.OW + WTILE - 1) / WTILE;
  int ocbGroups = (Coutb + OCB_BLK - 1) / OCB_BLK;
  // Workgroup decode. The output-channel block group sits INSIDE the row-block: every group of
  // one row-block runs back to back, so the input rows a group re-reads are still in cache from
  // the previous group instead of being streamed from DRAM once per group (the whole input map is
  // read ocbGroups times either way; only the distance between the reads changes).
  int nTXg = (nTX + TILES_PER_WG - 1) / TILES_PER_WG;
  int rowsPerWg = int(gl_WorkGroupSize.x) / TILES_PER_WG;
  int nOYg = (pc.OH + rowsPerWg - 1) / rowsPerWg;
  uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x + uint(pc.gidBase);
  if (gid >= uint(pc.N * ocbGroups * nOYg * nTXg * int(gl_WorkGroupSize.x))) return;
  int lane = int(gid % gl_WorkGroupSize.x);
  int grp = int(gid / gl_WorkGroupSize.x);
  int tx = (grp % nTXg) * TILES_PER_WG + lane % TILES_PER_WG;
  int ocbg = (grp / nTXg) % ocbGroups;
  int oy = ((grp / (nTXg * ocbGroups)) % nOYg) * rowsPerWg + lane / TILES_PER_WG;
  int n = grp / (nTXg * ocbGroups * nOYg);
  if (tx >= nTX || oy >= pc.OH) return;
  int ocb0 = ocbg * OCB_BLK;
  int ox0 = tx * WTILE;
  int ixBase = ox0 * SW_SPEC - pc.PL; // input column of tap kx=0 for the tile's first pixel

  vec4 acc[WTILE][OCB_BLK];
  int ocStride = Cinb * 9;
  // Clamp: the last block group can overhang Coutb; its accumulator is never stored.
  int wbj[OCB_BLK];
  for (int j = 0; j < OCB_BLK; ++j) {
    wbj[j] = min(ocb0 + j, Coutb - 1) * 4 * ocStride;
    vec4 b = (ocb0 + j < Coutb) ? vec4(bias[ocb0 + j]) : vec4(0.0);
    for (int p = 0; p < WTILE; ++p) acc[p][j] = b;
  }

  for (int icb = 0; icb < Cinb; ++icb) {
#ifdef PW_PRO
    vec4 proS = proScaleOf(pc.proFlags, n, icb, Cinb), proB = proShiftOf(pc.proFlags, n, icb, Cinb);
#endif
    int sb = (n * Cinb + icb) * pc.H * pc.W;
    for (int ky = 0; ky < 3; ++ky) {
      int iy = oy * pc.SH - pc.PT + ky;
      // Row segment for the whole tile; colOk carries conv_reg's per-tap bounds test forward.
      bool rowOk = uint(iy) < uint(pc.H);
      int rowOff = sb + iy * pc.W;
      vec4 row[COLS];
      bool colOk[COLS];
      for (int c = 0; c < COLS; ++c) {
        int ix = ixBase + c;
        bool ok = rowOk && uint(ix) < uint(pc.W);
        colOk[c] = ok;
        row[c] = ok ? vec4(src[rowOff + ix]) : vec4(0.0);
#ifdef PW_PRO
        if (ok) row[c] = proApply(row[c], proS, proB, pc.proFlags, pc.proAct, pc.proLo, pc.proHi); // padding stays zero
#endif
      }
      for (int kx = 0; kx < 3; ++kx) {
        int wtap = (icb * 3 + ky) * 3 + kx;
        vec4 w[OCB_BLK][4];
        for (int j = 0; j < OCB_BLK; ++j) {
          w[j][0] = vec4(wt[wbj[j] + wtap * 4 + 0]);
          w[j][1] = vec4(wt[wbj[j] + wtap * 4 + 1]);
          w[j][2] = vec4(wt[wbj[j] + wtap * 4 + 2]);
          w[j][3] = vec4(wt[wbj[j] + wtap * 4 + 3]);
        }
        for (int p = 0; p < WTILE; ++p) {
          int c = p * SW_SPEC + kx;
          if (colOk[c]) {
            vec4 inv = row[c];
            for (int j = 0; j < OCB_BLK; ++j) {
              acc[p][j] = fma(vec4(inv.x), w[j][0], acc[p][j]);
              acc[p][j] = fma(vec4(inv.y), w[j][1], acc[p][j]);
              acc[p][j] = fma(vec4(inv.z), w[j][2], acc[p][j]);
              acc[p][j] = fma(vec4(inv.w), w[j][3], acc[p][j]);
            }
          }
        }
      }
    }
  }
  for (int j = 0; j < OCB_BLK; ++j) {
    if (ocb0 + j >= Coutb) continue;
    int dbase = (n * Coutb + (ocb0 + j)) * HW;
    for (int p = 0; p < WTILE; ++p) {
      int ox = ox0 + p;
      if (ox < pc.OW) {
        int pix = oy * pc.OW + ox;
        vec4 v = vec4(vx_act(acc[p][j].x, pc.act, pc.actLo, pc.actHi),
                      vx_act(acc[p][j].y, pc.act, pc.actLo, pc.actHi),
                      vx_act(acc[p][j].z, pc.act, pc.actLo, pc.actHi),
                      vx_act(acc[p][j].w, pc.act, pc.actLo, pc.actHi));
#ifdef PW_EPI
        v = pw_apply4(v, dbase + pix);
#endif
        dst[dbase + pix] = TO_STORE4(v);
      }
    }
  }
}
