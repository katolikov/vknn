#version 450
// General group=1 conv, register-tiled like conv1x1: each thread computes OCB_BLK output channel-blocks
// (4*OCB_BLK oc) for WTILE output pixels, looping the KHxKW taps and gathering input from NC4HW4
// (implicit im2col, no patch buffer, no LDS). Each input vec4 is loaded once per (pixel,icb,ky,kx) and
// reused across all 4*OCB_BLK output-channel dots (OCB widening trades registers for input reuse); each
// weight vec4 is loaded once per (icb,ky,kx) and reused across all WTILE pixels. Per-pixel output coords
// are hoisted out of the hot loop. OCB_BLK is a spec constant (1 = the classic one-block kernel). fp16.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"
#ifdef PW_EPI
#define STORE float16_t
#define PW_EPI_BASE 4
#include "pw_epilogue.glsl"
#endif
layout(constant_id = 0) const int OCB_BLK = 1; // output channel-blocks (of 4 oc) computed per thread
layout(constant_id = 1) const int WTILE = 4;   // output pixels per thread (autotuned per shape)
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Src { f16vec4 src[]; };
layout(std430, binding = 1) readonly buffer Wt { f16vec4 wt[]; };
layout(std430, binding = 2) readonly buffer Bs { f16vec4 bias[]; };
layout(std430, binding = 3) writeonly buffer Dst { f16vec4 dst[]; };
layout(push_constant) uniform PC {
  int N, Cin, H, W, Cout, OH, OW, KH, KW, SH, SW, PT, PL, DH, DW, act;
  float actLo, actHi;
} pc;

void main() {
  int Cinb = (pc.Cin + 3) / 4;
  int Coutb = (pc.Cout + 3) / 4;
  int HW = pc.OH * pc.OW;
  int nTiles = (HW + WTILE - 1) / WTILE;
  int ocbGroups = (Coutb + OCB_BLK - 1) / OCB_BLK;
  uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (gid >= uint(pc.N * ocbGroups * nTiles)) return;
  int tile = int(gid) % nTiles;
  int ocbg = (int(gid) / nTiles) % ocbGroups;
  int n = int(gid) / (nTiles * ocbGroups);
  int ocb0 = ocbg * OCB_BLK;
  int p0 = tile * WTILE;

  int oyv[WTILE], oxv[WTILE];
  for (int p = 0; p < WTILE; ++p) {
    int pix = min(p0 + p, HW - 1);
    oyv[p] = pix / pc.OW;
    oxv[p] = pix - oyv[p] * pc.OW;
  }

  // acc[p][j] = pixel p, channel-block j.
  vec4 acc[WTILE][OCB_BLK];
  // Weight-row bases hoisted out of the tap loop. clamp: the last thread's block group can
  // overhang Coutb; re-read a valid block (the overhanging accumulator is never stored).
  int ocStride = Cinb * pc.KH * pc.KW;
  int wbj[OCB_BLK];
  for (int j = 0; j < OCB_BLK; ++j) {
    wbj[j] = min(ocb0 + j, Coutb - 1) * 4 * ocStride;
    vec4 b = (ocb0 + j < Coutb) ? vec4(bias[ocb0 + j]) : vec4(0.0);
    for (int p = 0; p < WTILE; ++p) acc[p][j] = b;
  }

  for (int icb = 0; icb < Cinb; ++icb) {
    int sb = (n * Cinb + icb) * pc.H * pc.W;
    for (int ky = 0; ky < pc.KH; ++ky) {
      for (int kx = 0; kx < pc.KW; ++kx) {
        int wtap = (icb * pc.KH + ky) * pc.KW + kx;
        // weights for the OCB_BLK blocks (4 oc each), loaded once, reused across WTILE pixels.
        vec4 w[OCB_BLK][4];
        for (int j = 0; j < OCB_BLK; ++j) {
          w[j][0] = vec4(wt[wbj[j] + 0 * ocStride + wtap]);
          w[j][1] = vec4(wt[wbj[j] + 1 * ocStride + wtap]);
          w[j][2] = vec4(wt[wbj[j] + 2 * ocStride + wtap]);
          w[j][3] = vec4(wt[wbj[j] + 3 * ocStride + wtap]);
        }
        for (int p = 0; p < WTILE; ++p) {
          int iy = oyv[p] * pc.SH - pc.PT + ky * pc.DH;
          int ix = oxv[p] * pc.SW - pc.PL + kx * pc.DW;
          if (uint(iy) < uint(pc.H) && uint(ix) < uint(pc.W)) {
            vec4 inv = vec4(src[sb + iy * pc.W + ix]);
            for (int j = 0; j < OCB_BLK; ++j) {
              acc[p][j].x += dot(inv, w[j][0]);
              acc[p][j].y += dot(inv, w[j][1]);
              acc[p][j].z += dot(inv, w[j][2]);
              acc[p][j].w += dot(inv, w[j][3]);
            }
          }
        }
      }
    }
  }
  for (int j = 0; j < OCB_BLK; ++j) {
    if (ocb0 + j >= Coutb) continue;
    int dbase = (n * Coutb + (ocb0 + j)) * HW;
    for (int p = 0; p < WTILE; ++p) {
      int pix = p0 + p;
      if (pix < HW) {
        vec4 v = vec4(vx_act(acc[p][j].x, pc.act, pc.actLo, pc.actHi),
                      vx_act(acc[p][j].y, pc.act, pc.actLo, pc.actHi),
                      vx_act(acc[p][j].z, pc.act, pc.actLo, pc.actHi),
                      vx_act(acc[p][j].w, pc.act, pc.actLo, pc.actHi));
#ifdef PW_EPI
        v = pw_apply4(v, dbase + pix);
#endif
        dst[dbase + pix] = TO_STORE4(v);
      }
    }
  }
}
