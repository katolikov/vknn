#version 450
// PRelu over NC4HW4 (fp16). slope is per-channel, packed [Cb][4]; element i belongs to block (i/HW)%Cb.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define VKNN_NO_RTE 1 // stores round via vknnRte16: must match the fused-unit per-step rounding exactly
#include "store16.glsl"
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer Src { f16vec4 src[]; };
layout(std430, binding = 1) readonly  buffer Slope { f16vec4 slope[]; };
layout(std430, binding = 2) writeonly buffer Dst { f16vec4 dst[]; };
layout(push_constant) uniform PC { int count, HW, Cb; } pc;
void main() {
  uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (i >= uint(pc.count)) return;
  int cb = (int(i) / pc.HW) % pc.Cb;
  vec4 s = vec4(slope[cb]);
  vec4 x = vec4(src[i]);
  vec4 r = mix(s * x, x, greaterThan(x, vec4(0.0)));
  dst[i] = f16vec4(TO_STORE(r.x), TO_STORE(r.y), TO_STORE(r.z), TO_STORE(r.w));
}
