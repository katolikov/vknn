#version 450
#include "precision.glsl"
// Flat broadcast for Expand (mode 0) and Tile (mode 1):
//   Expand: out[i] = in[ sum_k clamp(outCoord_k - (outDim[k] - inDim[k]), 0, inDim[k]-1) * inStride[k] ]
//   Tile:   out[i] = in[ sum_k (outCoord_k % inDim[k]) * inStride[k] ]
// Both reduce to the plain broadcast on a size-1 source axis. They differ only where the target
// widens an axis the source neither matches nor broadcasts: Tile repeats the axis (its whole
// purpose), while Expand right-aligns the source into the axis — the alignment ONNX already applies
// to the ranks — and repeats the first element ahead of it. See src/backend/cpu/ops/expand.cpp for
// why the alignment is the rule that makes the ORT transformer mask subgraph's [1,1,S,S] causal
// triangle land correctly on an [1,1,S,P+S] score mask at any cache fill P.
// STORE selects fp16/fp32 storage; values are read and written via float. Geometry
// (outDim/inDim/inStride) rides a content-deduped SSBO (binding 2), not the push constant, so the
// decodable rank is unbounded (see flat::uploadFlatGeom). Arrays pack back-to-back:
// outDim = g[0..rank), inDim = g[rank..2*rank), inStride = g[2*rank..3*rank).
#include "common.glsl"
layout(local_size_x = 256, local_size_x_id = 0) in; // spec 0 = device-resolved family width
layout(std430, binding = 0) readonly  buffer S { STORE s[]; };
layout(std430, binding = 1) writeonly buffer D { STORE d[]; };
layout(std430, binding = 2) readonly  buffer G { int g[]; } geom;
layout(push_constant) uniform PC { int rank, total, mode; } pc;

// ITEMS elements per lane, one slot apart (the fused_pw walk): independent items cover the
// per-element div/mod chain's memory latency; slots stride by the lane count so every item stays
// a coalesced wave-wide access. ITEMS is a specialization constant (the host resolves it per node
// at load, same rule as before), so the common single-item pipeline compiles the straight-line
// body below with no loop or slot division — the runtime-bound loop was measured to cost the
// driver its div/mod-chain optimization even at one item. The workgroup width is spec constant 0,
// resolved by the host at load from device caps (env.flatLocalSize).
layout(constant_id = 1) const int ITEMS = 1;
void processOne(uint gid) {
    int rem = int(gid), inIdx = 0;
    for (int k = pc.rank - 1; k >= 0; --k) {
      int c = rem % geom.g[k];
      rem /= geom.g[k];
      int inDim = geom.g[pc.rank + k];
      int src = (pc.mode == 1) ? (c % inDim) : clamp(c - (geom.g[k] - inDim), 0, inDim - 1);
      inIdx += src * geom.g[2 * pc.rank + k];
    }
    d[gid] = STORE(float(s[inIdx]));
}

void main() {
  uint lane = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (ITEMS == 1) {
    if (lane >= uint(pc.total)) return;
    processOne(lane);
    return;
  }
  uint slot = (uint(pc.total) + uint(ITEMS) - 1u) / uint(ITEMS);
  if (lane >= slot) return;
  for (int it = 0; it < ITEMS; ++it) {
    uint gid = lane + uint(it) * slot;
    if (gid >= uint(pc.total)) break;
    processOne(gid);
  }
}
