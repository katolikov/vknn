#version 450
// Row-tiled Resize (spatial) over NC4HW4, nearest + bilinear — the raced twin of resize.comp
// (resize.cpp pickResizeRow; the cubic arm stays on the scalar kernel, see resizeRowKernelOk).
//
// One lane computes RESIZE_ROW_TILE consecutive output pixels of ONE row of ONE channel block.
// Resize source coordinates are uniform arithmetic in the output position: consecutive outputs
// along a row advance the source column monotonically by 1/scale, so an upscale re-needs one or
// both of the previous output's tap columns. The lane holds the previous output's resolved columns
// in registers and loads each needed input column once per tile instead of once per output.
//
// BYTE-IDENTITY CONTRACT with resize.comp: sharing moves only WHEN a tap is loaded, never what is
// accumulated. Each output pixel's taps, weights and accumulation expression are line-for-line the
// scalar kernel's (the vertical terms carry no x and hoist unchanged); a held column is the same
// vec4 the scalar kernel re-loads. The mode/coord codes and the integer nearest index are the
// rules in src/core/resize_rule.h, copied here because GLSL cannot include the C++ header.
#include "common.glsl"
#ifdef PW_EPI
#define PW_EPI_BASE 2
#include "pw_epilogue.glsl"
#endif
// Output pixels one lane computes along its row; mirrors kResizeRowTile in
// src/backend/vulkan/ops/resize.cpp (the host derives this kernel's lane count from it).
#define RESIZE_ROW_TILE 4
// Held-column tag for "nothing held yet"; valid columns are 0..IW-1.
#define RESIZE_ROW_COL_NONE -1
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly  buffer Src { vec4 src[]; };
layout(std430, binding = 1) writeonly buffer Dst { vec4 dst[]; };
// Full ResizePC block for byte layout; cubicA/excludeOutside/perPixel are unread here (this kernel
// has one lane map and no cubic arm).
layout(push_constant) uniform PC { int N, C, IH, IW, OH, OW, mode, cm; float cubicA; int excludeOutside, perPixel, nm; } pc;

float coord(int d, int outS, int inS, int cm) {
  float scale = float(outS) / float(inS);
  if (cm == 1) return outS > 1 ? float(d) * float(inS - 1) / float(outS - 1) : 0.0;
  if (cm == 2) return float(d) / scale;
  if (cm == 3) return outS > 1 ? (float(d) + 0.5) / scale - 0.5 : 0.0;
  return (float(d) + 0.5) / scale - 0.5;
}
int clampi(int v, int lo, int hi) { return clamp(v, lo, hi); }
// Nearest source index in exact integer arithmetic -- vxResizeNearestSrc in
// src/backend/cpu/ops/resize.cpp, kept identical here. coord() cannot decide it: an integer
// downsample factor under half_pixel puts every output pixel exactly on the round_prefer_floor
// tie, this driver evaluates the divide through a reciprocal, and one ulp there moves the sample
// a whole pixel. Integers make the index a pure function of the shape on any driver.
int nearestSrc(int d, int outS, int inS, int cm, int nm) {
  int num, den;
  if (cm == 1)      { num = d * (inS - 1);            den = outS - 1; }
  else if (cm == 2) { num = d * inS;                  den = outS; }
  else              { num = (2 * d + 1) * inS - outS; den = 2 * outS; }
  if (den <= 0 || (cm == 3 && outS <= 1)) return 0;
  int q = num / den, r = num - q * den;
  if (r < 0) { q--; r += den; }   // GLSL division truncates toward zero; the rule needs floor
  // The four ONNX nearest_mode roundings over the exact fraction q + r/den (codes in
  // src/core/resize_rule.h): 0 round_prefer_floor, 1 round_prefer_ceil, 2 floor, 3 ceil.
  if (nm == 1) return 2 * r >= den ? q + 1 : q;
  if (nm == 2) return q;
  if (nm == 3) return r > 0 ? q + 1 : q;
  return 2 * r > den ? q + 1 : q;
}

void main() {
  int Cb = (pc.C + 3) / 4;
  int tiles = (pc.OW + RESIZE_ROW_TILE - 1) / RESIZE_ROW_TILE;
  // One lane per (n, channel block, output row, RESIZE_ROW_TILE-wide row tile). The bound below
  // must stay one expression: it is the lane count resize.cpp dispatches for this kernel
  // (resizeRowLanes).
  uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (i >= uint(pc.N * Cb * pc.OH * ((pc.OW + RESIZE_ROW_TILE - 1) / RESIZE_ROW_TILE))) return;
  int tx = int(i) % tiles;
  int oy = (int(i) / tiles) % pc.OH;
  int cb = (int(i) / (tiles * pc.OH)) % Cb;
  int n  = int(i) / (tiles * pc.OH * Cb);
  int sb = (n * Cb + cb) * pc.IH * pc.IW;
  int outRow = (n * Cb + cb) * pc.OH * pc.OW + oy * pc.OW;
  int ox0 = tx * RESIZE_ROW_TILE;
  if (pc.mode == 0) {
    // Nearest. The vertical index carries no x term: one integer row for the whole tile,
    // identical to the scalar kernel's per-pixel evaluation at this oy.
    int nearY = clampi(nearestSrc(oy, pc.OH, pc.IH, pc.cm, pc.nm), 0, pc.IH - 1);
    int rowBase = sb + nearY * pc.IW;
    // nearX is monotone non-decreasing in ox, so one held column captures every repeat.
    int heldX = RESIZE_ROW_COL_NONE;
    vec4 held = vec4(0.0);
    for (int t = 0; t < RESIZE_ROW_TILE; ++t) {
      int ox = ox0 + t;
      if (ox >= pc.OW) break;   // tail tile of a width not divisible by the tile
      int nearX = clampi(nearestSrc(ox, pc.OW, pc.IW, pc.cm, pc.nm), 0, pc.IW - 1);
      if (nearX != heldX) { held = vec4(src[rowBase + nearX]); heldX = nearX; }
      vec4 v = held;
      int outIdx = outRow + ox;
#ifdef PW_EPI
      v = pw_apply4(v, outIdx);
#endif
      dst[outIdx] = vec4(v);
    }
  } else {
    // Bilinear (the host predicate keeps cubic on resize.comp). Vertical geometry (fy, iy0, wyl)
    // carries no x term: computed once, the identical fp32 expressions the scalar kernel
    // evaluates per pixel.
    float fy = coord(oy, pc.OH, pc.IH, pc.cm);
    int iy0 = int(floor(fy));
    float wyl = fy - float(iy0);
    int cy0 = clampi(iy0, 0, pc.IH - 1), iy1 = clampi(iy0 + 1, 0, pc.IH - 1);
    int r0 = sb + cy0 * pc.IW, r1 = sb + iy1 * pc.IW;
    // Held columns of the previous output: left = its cx0, right = its ix1, each as the (row y0,
    // row y1) vec4 pair. The tags are exact column indices, so a hit returns precisely the value
    // a fresh load would; a miss just loads. Reuse never depends on the scale factor.
    int heldLX = RESIZE_ROW_COL_NONE, heldRX = RESIZE_ROW_COL_NONE;
    vec4 heldL0 = vec4(0.0), heldL1 = vec4(0.0), heldR0 = vec4(0.0), heldR1 = vec4(0.0);
    for (int t = 0; t < RESIZE_ROW_TILE; ++t) {
      int ox = ox0 + t;
      if (ox >= pc.OW) break;   // tail tile of a width not divisible by the tile
      float fx = coord(ox, pc.OW, pc.IW, pc.cm);
      int ix0 = int(floor(fx));
      float wxl = fx - float(ix0);
      int cx0 = clampi(ix0, 0, pc.IW - 1), ix1 = clampi(ix0 + 1, 0, pc.IW - 1);
      // The scalar kernel's four taps: a/b = row y0 at columns cx0/ix1, c/d = row y1. ix1 equal
      // to a held LEFT tag implies ix1 == cx0 (columns are monotone), which the first arm covers.
      vec4 a, b, c, d;
      if (cx0 == heldLX)      { a = heldL0; c = heldL1; }
      else if (cx0 == heldRX) { a = heldR0; c = heldR1; }
      else                    { a = vec4(src[r0 + cx0]); c = vec4(src[r1 + cx0]); }
      if (ix1 == cx0)         { b = a; d = c; }
      else if (ix1 == heldRX) { b = heldR0; d = heldR1; }
      else                    { b = vec4(src[r0 + ix1]); d = vec4(src[r1 + ix1]); }
      heldLX = cx0; heldL0 = a; heldL1 = c;
      heldRX = ix1; heldR0 = b; heldR1 = d;
      vec4 v = a * (1.0 - wyl) * (1.0 - wxl) + b * (1.0 - wyl) * wxl + c * wyl * (1.0 - wxl) + d * wyl * wxl;
      int outIdx = outRow + ox;
#ifdef PW_EPI
      v = pw_apply4(v, outIdx);
#endif
      dst[outIdx] = vec4(v);
    }
  }
}
