#version 450
#include "precision.glsl"
// Flat row-major Pad with a RUNTIME constant value: identical to flat_pad.comp except the fill value
// comes from a single-element SSBO (binding 1) read at dispatch rather than a baked push constant.
// The pad GEOMETRY stays static (output shape known at plan time); only the constant value is runtime.
// Geometry (outDim/inDim/inStride/padBegin) rides a content-deduped SSBO (binding 3): the arrays pack
// back-to-back exactly as in flat_pad.comp (outDim = g[0..rank), inDim = g[rank..2*rank),
// inStride = g[2*rank..3*rank), padBegin = g[3*rank..4*rank)).
#include "common.glsl"
layout(local_size_x = 256, local_size_x_id = 0) in; // spec 0 = device-resolved family width
layout(std430, binding = 0) readonly  buffer S { STORE s[]; };
layout(std430, binding = 1) readonly  buffer V { STORE cv[]; };
layout(std430, binding = 2) writeonly buffer D { STORE d[]; };
layout(std430, binding = 3) readonly  buffer G { int g[]; } geom;
layout(push_constant) uniform PC {
  int rank, total, mode;
  float cval;                   // unused on this path; kept so the block byte-matches flat::Pad::PC
  int items;
} pc;

// pc.items elements per lane, one slot apart (the fused_pw walk); spec 0 carries the
// device-resolved workgroup width (env.flatLocalSize).
void main() {
  uint lane = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint slot = (uint(pc.total) + uint(pc.items) - 1u) / uint(pc.items);
  if (lane >= slot) return;
  for (int it = 0; it < pc.items; ++it) {
    uint gid = lane + uint(it) * slot;
    if (gid >= uint(pc.total)) break;
      int rem = int(gid), inIdx = 0;
      bool oob = false;
      for (int k = pc.rank - 1; k >= 0; --k) {
        int oc = rem % geom.g[k];
        rem /= geom.g[k];
        int n = geom.g[pc.rank + k];
        int ic = oc - geom.g[3 * pc.rank + k];
        if (ic < 0 || ic >= n) {
          if (pc.mode == 1) {              // edge: clamp to the border
            ic = clamp(ic, 0, n - 1);
          } else if (pc.mode == 2) {       // reflect across the border (excludes the edge)
            if (n == 1) {
              ic = 0;
            } else {
              int p = 2 * (n - 1);
              int r = ((ic % p) + p) % p;
              ic = (r < n) ? r : (p - r);
            }
          } else {                          // constant
            oob = true;
            ic = 0;                         // keep inIdx in-bounds; the value is discarded
          }
        }
        inIdx += ic * geom.g[2 * pc.rank + k];
      }
      d[gid] = oob ? cv[0] : s[inIdx];
  }
}
