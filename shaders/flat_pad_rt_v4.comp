#version 450
#include "precision.glsl"
// Vectorized twin of flat_pad_rt: identical to flat_pad_v4.comp except the fill value comes from
// a single-element SSBO (binding 1) read at dispatch rather than a baked push constant — the same
// relation flat_pad_rt.comp bears to flat_pad.comp. Quad mapping, border fallback and tail
// handling are flat_pad_v4's; indices and pad-value selection — and therefore bytes — are
// identical to flat_pad_rt for every element, so the two variants are byte-interchangeable and
// the host (flat::Pad::pickQuad) may pick either on measured speed alone.
#include "common.glsl"
// Storage vector of FLAT_MOVE_QUAD consecutive output elements (the fp32 variant stores plain
// vec4).
#ifdef USE_FP16
#define STORE_QUAD f16vec4
#else
#define STORE_QUAD vec4
#endif
// Elements per lane-quad; mirrored by kFlatMoveQuad in src/backend/vulkan/ops/flat_ops.h.
#define FLAT_MOVE_QUAD 4
layout(local_size_x = 256, local_size_x_id = 0) in; // spec 0 = device-resolved family width
layout(std430, binding = 0) readonly  buffer S { STORE s[]; };       // pad reads are arbitrary-stride: scalar-indexed
layout(std430, binding = 1) readonly  buffer V { STORE cv[]; };      // runtime pad value, single element
layout(std430, binding = 2) writeonly buffer D { STORE_QUAD d4[]; }; // whole-vec4 stores over consecutive elements
layout(std430, binding = 3) readonly  buffer G { int g[]; } geom;    // outDim = g[0..rank), inDim = g[rank..2*rank), inStride = g[2*rank..3*rank), padBegin = g[3*rank..4*rank)
// Same push-constant contract as flat_pad_rt.comp.
layout(push_constant) uniform PC {
  int rank, total, mode;
  float cval;                   // unused on this path; kept so the block byte-matches flat::Pad::PC
} pc;

// ITEMS quads per lane, one slot apart — the scalar twin's walk, over quads. The movement family
// pins ITEMS = 1 (flat_ops.h kMovementItemsPerLane); the spec constant stays so a future shape
// rule can re-enable the walk per node without a kernel change.
layout(constant_id = 1) const int ITEMS = 1;

// The scalar kernel's per-axis index resolution (flat_pad_rt.comp processOne): identical
// statements, mapping output element gid to an input element and marking `oob` in the
// constant-mode pad region (the returned index stays in-bounds there; the value is discarded).
int padIndex(int gid, out bool oob) {
  int rem = gid, inIdx = 0;
  oob = false;
  for (int k = pc.rank - 1; k >= 0; --k) {
    int oc = rem % geom.g[k];
    rem /= geom.g[k];
    int n = geom.g[pc.rank + k];
    int ic = oc - geom.g[3 * pc.rank + k];
    if (ic < 0 || ic >= n) {
      if (pc.mode == 1) {              // edge: clamp to the border
        ic = clamp(ic, 0, n - 1);
      } else if (pc.mode == 2) {       // reflect across the border (excludes the edge)
        if (n == 1) {
          ic = 0;
        } else {
          int p = 2 * (n - 1);
          int r = ((ic % p) + p) % p;
          ic = (r < n) ? r : (p - r);
        }
      } else {                          // constant
        oob = true;
        ic = 0;                         // keep inIdx in-bounds; the value is discarded
      }
    }
    inIdx += ic * geom.g[2 * pc.rank + k];
  }
  return inIdx;
}

// The scalar kernel's per-element body, value-returning: identical statements with the store
// lifted to the caller.
STORE padOne(int gid) {
  bool oob;
  int  inIdx = padIndex(gid, oob);
  return oob ? cv[0] : s[inIdx];
}

void processQuad(int q) {
  int e0 = q * FLAT_MOVE_QUAD;
  if (e0 + FLAT_MOVE_QUAD > pc.total) {
    // Tail quad: the scalar body per element behind the bounds guard; component stores compile to
    // scalar accesses, so nothing writes past total.
    for (int j = 0; j < FLAT_MOVE_QUAD; ++j) {
      if (e0 + j >= pc.total) break;
      d4[q][j] = padOne(e0 + j);
    }
    return;
  }
  // Row-interior full quad whose innermost coordinates all map inside the input axis: one walk
  // resolves the quad — no innermost border branch can fire — and the innermost input stride
  // steps it. (pc.rank == 0 never reaches here: its total is 1, which the tail path above
  // handles.)
  int lastDim = geom.g[pc.rank - 1];
  int lastIn  = geom.g[2 * pc.rank - 1];
  int lastPos = e0 - (e0 / lastDim) * lastDim;
  int icFirst = lastPos - geom.g[4 * pc.rank - 1];
  if (lastPos + FLAT_MOVE_QUAD <= lastDim && icFirst >= 0 && icFirst + FLAT_MOVE_QUAD <= lastIn) {
    bool oob;
    int  inIdx = padIndex(e0, oob);
    if (oob) { // an outer axis lies in the constant pad region: all four elements take the fill value
      STORE fill = cv[0];
      d4[q] = STORE_QUAD(fill, fill, fill, fill);
      return;
    }
    int st = geom.g[3 * pc.rank - 1];
    d4[q] = STORE_QUAD(s[inIdx], s[inIdx + st], s[inIdx + 2 * st], s[inIdx + 3 * st]);
    return;
  }
  // Quad touching the innermost pad border, or straddling a row: the scalar kernel's four
  // independent per-element walks; the store stays one whole-vec4 transaction.
  d4[q] = STORE_QUAD(padOne(e0), padOne(e0 + 1), padOne(e0 + 2), padOne(e0 + 3));
}

void main() {
  uint lane = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  int quadTotal = (pc.total + FLAT_MOVE_QUAD - 1) / FLAT_MOVE_QUAD;
  if (ITEMS == 1) {
    if (lane >= uint(quadTotal)) return;
    processQuad(int(lane));
    return;
  }
  uint slot = (uint(quadTotal) + uint(ITEMS) - 1u) / uint(ITEMS);
  if (lane >= slot) return;
  for (int it = 0; it < ITEMS; ++it) {
    uint q = lane + uint(it) * slot;
    if (q >= uint(quadTotal)) break;
    processQuad(int(q));
  }
}
