#version 450
// Winograd transform-domain matmul as a register-tiled batched GEMM with NO shared-memory
// staging: every thread reads its V and U operands straight from global memory through L1/L2
// inside the K loop (MNN's mobile GEMM structure, SA=SB=0). Same logical output tile as
// wino_gemm_fp16.comp — 64 threads (MDIM 8 x NDIM 8), RM tiles x 1 output channel-block per
// thread, TILE_NB = 8 ocb per workgroup — the same U pack ("#winoT": [pos][ocb][icb][ic lane],
// vec4 over 4 output channels; winoGemmUVec4Index in core/conv_dispatch_rules.h) and the SAME
// per-output accumulation: fp32 vec4 accumulators, per input channel-block k the four fmas
// acc = fma(vec4(a.c), u_c, acc) in lane order x, y, z, w, k ascending one channel-block at a time
// over the whole Cinb range. The LDS kernel's KWG chunking keeps k contiguous and ascending inside
// each chunk with chunks ascending, so this straight k loop reproduces its per-output operation
// sequence exactly; only the operand staging differs, making the kernel a bit-neutral member of
// tuneWino's GEMM-body race. fp32 accumulation only: the fp16-accumulate (ACC16) variant stays
// LDS-only.
//
// Specialization constant RM (id 0) = 4 or 8 tiles per thread, exactly like the LDS kernel:
// bit-neutral, it only remaps threads to outputs.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"

layout(constant_id = 0) const int RM = 4; // tiles per thread (M micro-tile): 4 or 8

#define NC4 4       // channels per NC4HW4 block: the lane count of every vec4 operand here
#define MDIM 8      // threads in M
#define NDIM 8      // threads in N   (MDIM*NDIM = 64)
#define RM_MAX 8
#define TILE_M (MDIM * RM)   // output tiles (M) per workgroup
#define TILE_NB NDIM         // output channel-blocks (N) per workgroup

layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer V { f16vec4 vbuf[]; };
layout(std430, binding = 1) readonly buffer U { f16vec4 ubuf[]; };
layout(std430, binding = 2) writeonly buffer M { f16vec4 mbuf[]; };
layout(push_constant) uniform PC { int Cin, Cout, nT; } pc;

void main() {
  int Cinb = (pc.Cin + NC4 - 1) / NC4;
  int Coutb = (pc.Cout + NC4 - 1) / NC4;
  int p = int(gl_WorkGroupID.z);
  int m0 = int(gl_WorkGroupID.x) * TILE_M;       // first tile
  int nb0 = int(gl_WorkGroupID.y) * TILE_NB;     // first ocb

  uint lid = gl_LocalInvocationID.x;
  int tIdM = int(lid) % MDIM;   // 0..7
  int tIdN = int(lid) / MDIM;   // 0..7

  int ocb = nb0 + tIdN;         // this thread's output channel-block
  if (ocb >= Coutb) return;     // no barriers here, so an out-of-range thread may exit early

  // This block's U rows: ubuf[uBase + k*NC4 + c], channel-block k's 4 vec4s contiguous. The pack
  // zero-fills the output channels past Cout inside the last block, so a partial block's stored
  // M lanes are the same zeros the LDS kernel's zero-padded sB entries yield.
  int uBase = (p * Coutb + ocb) * Cinb * NC4;

  int vBaseP = p * Cinb * pc.nT;        // vbuf[(p*Cinb + k)*nT + m]

  vec4 acc[RM_MAX];
  for (int r = 0; r < RM; ++r) acc[r] = vec4(0.0);

  // Straight k loop over the whole Cinb range: per k the block's 4 U vec4s load once and stay in
  // registers across the RM tiles; each tile then costs one V load + four widened fmas, the same
  // in-register multiply the LDS kernel runs on its staged copies.
  // Two input channel-blocks per trip: both blocks' U rows and V tiles are requested before
  // either block's fmas, doubling the loads a thread keeps in flight. A deep 16-tile GEMM (512
  // channels at 7x7) streams an 8 MB U from DRAM through 256 workgroups, and the outstanding
  // loads, not the arithmetic, set how close it runs to that stream. Each output's fma sequence
  // is unchanged: block k's four lanes, then block k+1's, k ascending.
  int kPair = Cinb & ~1;
  for (int k = 0; k < kPair; k += 2) {
    int uRow = uBase + k * NC4;
    vec4 u0 = vec4(ubuf[uRow + 0]);
    vec4 u1 = vec4(ubuf[uRow + 1]);
    vec4 u2 = vec4(ubuf[uRow + 2]);
    vec4 u3 = vec4(ubuf[uRow + 3]);
    vec4 u4 = vec4(ubuf[uRow + 4]);
    vec4 u5 = vec4(ubuf[uRow + 5]);
    vec4 u6 = vec4(ubuf[uRow + 6]);
    vec4 u7 = vec4(ubuf[uRow + 7]);
    int vRow = vBaseP + k * pc.nT;
    for (int r = 0; r < RM; ++r) {
      int m = m0 + tIdM + r * MDIM;
      // A tile past nT reads nothing (keeps the load in-bounds) and its accumulator is never
      // stored; the LDS kernel zero-pads the same entries.
      bool live = m < pc.nT;
      vec4 a = live ? vec4(vbuf[vRow + m]) : vec4(0.0);
      vec4 b = live ? vec4(vbuf[vRow + pc.nT + m]) : vec4(0.0);
      acc[r] = fma(vec4(a.x), u0, acc[r]);
      acc[r] = fma(vec4(a.y), u1, acc[r]);
      acc[r] = fma(vec4(a.z), u2, acc[r]);
      acc[r] = fma(vec4(a.w), u3, acc[r]);
      acc[r] = fma(vec4(b.x), u4, acc[r]);
      acc[r] = fma(vec4(b.y), u5, acc[r]);
      acc[r] = fma(vec4(b.z), u6, acc[r]);
      acc[r] = fma(vec4(b.w), u7, acc[r]);
    }
  }
  if (kPair < Cinb) { // odd block count: the last block alone
    int uRow = uBase + kPair * NC4;
    vec4 u0 = vec4(ubuf[uRow + 0]);
    vec4 u1 = vec4(ubuf[uRow + 1]);
    vec4 u2 = vec4(ubuf[uRow + 2]);
    vec4 u3 = vec4(ubuf[uRow + 3]);
    int vRow = vBaseP + kPair * pc.nT;
    for (int r = 0; r < RM; ++r) {
      int m = m0 + tIdM + r * MDIM;
      vec4 a = (m < pc.nT) ? vec4(vbuf[vRow + m]) : vec4(0.0);
      acc[r] = fma(vec4(a.x), u0, acc[r]);
      acc[r] = fma(vec4(a.y), u1, acc[r]);
      acc[r] = fma(vec4(a.z), u2, acc[r]);
      acc[r] = fma(vec4(a.w), u3, acc[r]);
    }
  }

  // ---- store M[p][ocb][tile] ----  mbuf[(p*Coutb + ocb)*nT + tile]; same coalesced layout and
  // the same f16vec4 narrowing (RoundingModeRTE via store16.glsl) as the LDS kernel's store.
  int cBase = (p * Coutb + ocb) * pc.nT;
  int m = m0 + tIdM;
  for (int r = 0; r < RM; ++r)
    if (m + r * MDIM < pc.nT) mbuf[cBase + (m + r * MDIM)] = f16vec4(acc[r]);
}
