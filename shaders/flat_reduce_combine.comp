#version 450
#include "precision.glsl"
#ifdef PW_EPI
#define PW_EPI_BASE 2
#include "pw_epilogue.glsl"
#endif
// Pass 2 of the cooperative flat reduce (see reduce.cpp / flat_reduce_partial.comp). One workgroup per
// output element folds that output's `groups` fp32 partials, applies the op finalise (Mean divides by
// the reduced count, L2 takes the root), runs any fused pointwise epilogue, and stores the result.
#include "common.glsl"
layout(local_size_x = 256, local_size_x_id = 0) in; // spec = device-resolved width (pow2 for the tree fold)
layout(std430, binding = 0) readonly  buffer P { float part[]; };
layout(std430, binding = 1) writeonly buffer D { STORE d[]; };
layout(push_constant) uniform PC {
  int total, op, groups, rcount;
} pc;

// Reduce wire codes carried in pc.op (kept in sync with vknn::ReduceType, include/vknn/reduce_type.h).
#define REDUCE_MEAN 0
#define REDUCE_SUM  1
#define REDUCE_MAX  2
#define REDUCE_MIN  3
#define REDUCE_PROD 4
#define REDUCE_L2   5

#define WG_MAX 256 // shared-array ceiling: must be >= the spec-0 width; the host guarantees
                   // flatLocalSize = min(256, caps), pow2-clamped for the tree fold (vk_op_env.h)
shared float red[WG_MAX];

void main() {
  uint outIdx = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
  if (outIdx >= uint(pc.total)) return;
  uint t = gl_LocalInvocationID.x;

  // Fold this output's `groups` partials; lanes past the group count seed the op identity.
  float acc = (pc.op == REDUCE_MAX) ? VX_NEG_INF : (pc.op == REDUCE_MIN) ? VX_POS_INF : (pc.op == REDUCE_PROD) ? 1.0 : 0.0;
  for (int gi = int(t); gi < pc.groups; gi += int(gl_WorkGroupSize.x)) {
    float v = part[outIdx * uint(pc.groups) + uint(gi)];
    acc = (pc.op == REDUCE_MAX) ? max(acc, v) : (pc.op == REDUCE_MIN) ? min(acc, v) : (pc.op == REDUCE_PROD) ? acc * v : acc + v;
  }
  red[t] = acc;
  barrier();
  for (uint stride = gl_WorkGroupSize.x / 2u; stride > 0u; stride >>= 1) {
    if (t < stride) {
      float a = red[t], b = red[t + stride];
      red[t] = (pc.op == REDUCE_MAX) ? max(a, b) : (pc.op == REDUCE_MIN) ? min(a, b) : (pc.op == REDUCE_PROD) ? a * b : a + b;
    }
    barrier();
  }
  if (t == 0u) {
    float r = red[0];
    if (pc.op == REDUCE_MEAN && pc.rcount > 0) r /= float(pc.rcount);
    else if (pc.op == REDUCE_L2) r = sqrt(r);
#ifdef PW_EPI
    r = pw_apply(r, int(outIdx));
#endif
    d[outIdx] = TO_STORE(r); // saturating: a Sum/Prod of in-range values can exceed the fp16 range
  }
}
