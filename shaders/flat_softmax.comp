#version 450
#include "precision.glsl"
#ifdef PW_EPI
#define PW_EPI_BASE 2
#include "pw_epilogue.glsl"
#endif
#include "common.glsl"
// Softmax over one axis, two row mappings picked by a deterministic shape rule (spec constant):
//   ROW_MODE 0 - one workgroup per row: the threads cooperatively reduce max + sum through LDS,
//     so a wide attention row (axis up to a few thousand) is parallelised across the workgroup.
//   ROW_MODE 1 - one THREAD per row: a small axis (a detection head's 16-bin distribution) walks
//     the row serially in registers - no LDS, no barriers, and no idle lanes; the many rows supply
//     the parallelism instead. With WG threads per row a 16-wide axis would idle 7/8 of every
//     workgroup and serialize ~14 barrier rounds per row.
// The row index spans a 2D workgroup grid (ComputePipeline::dispatch spills the count into y past
// the per-dim limit), so >65535-row shapes work in both modes.
// pc.outPad is the output buffer's PHYSICAL last-axis extent, non-zero only for a virtualized
// activation the segment allocated at roundUpVec4(axis) so its consuming tiled MatMul can take the
// vec4-load kernels (core/matmul_tile.h). It applies only to a LAST-axis softmax (inner == 1): the
// row then starts at o * outPad instead of o * axis, and the outPad - axis pad elements are stored
// as zero every run, because the liveness pool hands the same buffer to different tensors between
// runs and the consuming GEMM multiplies the A-side pad against its own zeroed k tail.
#define WG_MAX 128                        // shared-array size = the width ceiling
#define WG int(gl_WorkGroupSize.x)         // running width: spec 1, resolved at load (pow2)
layout(constant_id = 0) const int ROW_MODE = 0;
layout(local_size_x = 128, local_size_x_id = 1) in;
layout(std430, binding = 0) readonly buffer S { STORE s[]; };
layout(std430, binding = 1) writeonly buffer D { STORE d[]; };
layout(push_constant) uniform PC { int outer, axis, inner, outPad; } pc;

shared float red[WG_MAX];

void main() {
  if (ROW_MODE == 1) {
    uint row = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    if (row >= uint(pc.outer * pc.inner)) return;
    int o = int(row) / pc.inner, i = int(row) % pc.inner;
    int base = o * pc.axis * pc.inner + i;
    int obase = pc.outPad > 0 ? o * pc.outPad + i : base;

    float m = -3.4e38;
    for (int a = 0; a < pc.axis; ++a)
      m = max(m, float(s[base + a * pc.inner]));
    float sum = 0.0;
    for (int a = 0; a < pc.axis; ++a)
      sum += exp(float(s[base + a * pc.inner]) - m);
    float rsum = 1.0 / sum;
    for (int a = 0; a < pc.axis; ++a) {
      float v = exp(float(s[base + a * pc.inner]) - m) * rsum;
#ifdef PW_EPI
      v = pw_apply(v, base + a * pc.inner);
#endif
      d[obase + a * pc.inner] = STORE(v);
    }
    for (int a = pc.axis; a < pc.outPad; ++a)
      d[obase + a] = STORE(0.0);
    return;
  }

  uint row = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
  if (row >= uint(pc.outer * pc.inner)) return;
  int o = int(row) / pc.inner, i = int(row) % pc.inner;
  int base = o * pc.axis * pc.inner + i;
  int obase = pc.outPad > 0 ? o * pc.outPad + i : base;
  uint t = gl_LocalInvocationID.x;

  float m = -3.4e38;
  for (int a = int(t); a < pc.axis; a += WG)
    m = max(m, float(s[base + a * pc.inner]));
  red[t] = m;
  barrier();
  for (uint stride = WG / 2; stride > 0; stride >>= 1) {
    if (t < stride) red[t] = max(red[t], red[t + stride]);
    barrier();
  }
  m = red[0];
  barrier();

  float sum = 0.0;
  for (int a = int(t); a < pc.axis; a += WG)
    sum += exp(float(s[base + a * pc.inner]) - m);
  red[t] = sum;
  barrier();
  for (uint stride = WG / 2; stride > 0; stride >>= 1) {
    if (t < stride) red[t] += red[t + stride];
    barrier();
  }
  float rsum = 1.0 / red[0];
  barrier();

  for (int a = int(t); a < pc.axis; a += WG) {
    float v = exp(float(s[base + a * pc.inner]) - m) * rsum;
#ifdef PW_EPI
    v = pw_apply(v, base + a * pc.inner);
#endif
    d[obase + a * pc.inner] = STORE(v);
  }
  for (int a = pc.axis + int(t); a < pc.outPad; a += WG)
    d[obase + a] = STORE(0.0);
}
