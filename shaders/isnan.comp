#version 450
#include "precision.glsl"
// Flat elementwise IsNaN (out = isnan(x) ? 1 : 0). A pure 1:1 map over the packed buffer with no
// broadcasting, so it needs no geometry SSBO: one invocation per element, bounds-checked on the
// tail. The bool result is the canonical fp32 1.0/0.0 the flat comparison ops emit.
#include "common.glsl"
layout(local_size_x = 256, local_size_x_id = 0) in; // spec = device-resolved family width
layout(std430, binding = 0) readonly  buffer S { STORE s[]; };
layout(std430, binding = 1) writeonly buffer D { STORE d[]; };
layout(push_constant) uniform PC { int total; } pc;

void main() {
  uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (i >= uint(pc.total)) return;
  d[i] = STORE(isnan(float(s[i])) ? 1.0 : 0.0);
}
