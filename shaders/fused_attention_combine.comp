#version 450
#define VKNN_NO_RTE 1 // matmul-family kernel: avoids the float-controls execution mode (miscompiled by some drivers)
#include "precision.glsl"
#include "common.glsl"
// Fused decode attention, combine pass: folds the per-chunk partials fused_attention.comp wrote —
// {chunk max m, chunk weight sum l, unnormalized context acc[hd]} per (attention row, chunk) —
// into the final context row with the standard flash rescale:
//   M = max_c m_c;  L = sum_c l_c * exp(m_c - M);  out[n] = sum_c acc_c[n] * exp(m_c - M) / L
// One workgroup per attention row; the per-chunk rescale factors stage through shared memory so
// each is computed once. Only this pass stores to the output (fp16 via TO_STORE).
#define WG 256
// Ceiling of the chunk count one combine workgroup reduces; == kFaMaxChunks
// (src/backend/vulkan/ops/fused_attention.cpp), which clamps the split so sFactor
// never indexes past this.
#define FA_MAX_CHUNKS 64
// Layout of one partial record: the chunk max m at the record base, the chunk weight sum l at
// FA_PART_L, then the hd accumulator lanes from FA_PART_HDR on. FA_PART_HDR is both the header's
// float count and the offset of the first accumulator lane, so it is the record STRIDE term
// (hd + FA_PART_HDR) and the accumulator SKIP — every index below is written in terms of these
// names, so a header-layout change moves the reader with it instead of leaving accumulator lanes
// offset into header floats. Mirrors the host scratch allocation rows * chunks * (hd + FA_PART_HDR)
// (kFaPartialHeaderFloats, src/backend/vulkan/ops/fused_attention.cpp); the two must change
// together or every partial lands in the wrong chunk slot with plausible values.
#define FA_PART_L 1
#define FA_PART_HDR 2
layout(local_size_x = WG) in;
layout(std430, binding = 0) readonly buffer P { float part[]; };
layout(std430, binding = 1) writeonly buffer D { STORE d[]; };
layout(push_constant) uniform PC { int rows, hd, chunks; } pc;

shared float sFactor[FA_MAX_CHUNKS];

void main() {
  uint row = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
  if (row >= uint(pc.rows)) return;
  int tid = int(gl_LocalInvocationID.x);
  int base = int(row) * pc.chunks;

  // Global max and rescaled weight sum over the chunks (small count; every lane computes both).
  float gM = -3.4e38; // finite ~-FLT_MAX seed: every chunk max is a finite score above it (chunks >= 1), so the seed never survives the fold
  for (int c = 0; c < pc.chunks; ++c) gM = max(gM, part[(base + c) * (pc.hd + FA_PART_HDR)]);
  float gL = 0.0;
  for (int c = 0; c < pc.chunks; ++c) gL += part[(base + c) * (pc.hd + FA_PART_HDR) + FA_PART_L] * exp(part[(base + c) * (pc.hd + FA_PART_HDR)] - gM);
  if (tid < pc.chunks) sFactor[tid] = exp(part[(base + tid) * (pc.hd + FA_PART_HDR)] - gM);
  barrier();

  float rL = 1.0 / gL;
  for (int n = tid; n < pc.hd; n += WG) {
    float context = 0.0;
    for (int c = 0; c < pc.chunks; ++c)
      context += part[(base + c) * (pc.hd + FA_PART_HDR) + FA_PART_HDR + n] * sFactor[c];
    d[int(row) * pc.hd + n] = TO_STORE(context * rL);
  }
}
