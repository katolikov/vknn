#version 450
// 3x3 dilation-1 group-1 conv whose input has fewer than 4 channels, read from a COMPACT flat plane
// (NCHW row-major) instead of a channel-padded NC4HW4 buffer. Output is NC4HW4 as usual.
//
// With CIN=1 the padded form carries 4x the bytes for the same data and every load fetches 8 bytes to
// use 2, which is the whole cost of a first conv over a large plane. Reading the dense plane cuts the
// input traffic by 4/CIN.
//
// Tiling matches conv3x3_row: WTILE output pixels along one output row, the row segment held in
// registers so all three kx taps read it there.
//
// Bit-exact with conv_reg: the operand is assembled into the SAME vec4 the padded path would load
// (channels beyond CIN are zero, exactly as the NC4HW4 pack leaves them) and fed to the same fma chain in
// the same (ky, kx, pixel) order, so the sum is term-for-term identical. Computing cin*w.x instead
// would drop the zero terms and could flip an accumulator's -0.0.
//
// CIN and SW are spec constants: CIN picks how many planes to gather, SW sizes the row segment.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"
#ifdef PW_EPI
#define STORE float16_t
#define PW_EPI_BASE 4
#include "pw_epilogue.glsl"
#endif
// Specialization-constant mirrors of src/core/conv_dispatch_rules.h (keep in lockstep):
// CONV_COMPACT_*_SPEC are kConvCompactOcbSpecIndex, kConvCompactPixelTileSpecIndex,
// kConvCompactStrideSpecIndex, kConvCompactCinSpecIndex and kConvCompactLaneWidthSpecIndex. The host
// states every slot through convCompactSpecConstants(); the DECLARED lane width only stands in for
// a standalone compile.
#define CONV_COMPACT_OCB_SPEC 0
#define CONV_COMPACT_WTILE_SPEC 1
#define CONV_COMPACT_SW_SPEC 2
#define CONV_COMPACT_CIN_SPEC 3
#define CONV_COMPACT_TILES_PER_WG_SPEC 4
#define CONV_COMPACT_LANE_WIDTH_SPEC 5
#define CONV_COMPACT_DECLARED_TILES_PER_WG 16
#define CONV_COMPACT_DECLARED_LANE_WIDTH 64
#define OCB_BLK 2 // output channel-blocks (of 4 oc) computed per thread
#define WTILE 4 // output pixels per thread, consecutive along W
#define SW_SPEC 2  // horizontal stride (sizes the row segment)
#define CIN 3     // input channels, 1..3
// Column-tiles per workgroup (the row kernel's 2-D wave footprint; see conv3x3_row).
#define TILES_PER_WG 16
layout(local_size_x = 64, local_size_x_id = 0) in;
#define KEXT 3
#define KTAPS (KEXT * KEXT)
#define COLS ((WTILE - 1) * SW_SPEC + KEXT)
layout(std430, binding = 0) readonly buffer Src { float16_t src[]; };
layout(std430, binding = 1) readonly buffer Wt { f16vec4 wt[]; };
layout(std430, binding = 2) readonly buffer Bs { f16vec4 bias[]; };
layout(std430, binding = 3) writeonly buffer Dst { f16vec4 dst[]; };
layout(push_constant) uniform PC {
  int N, Cin, H, W, Cout, OH, OW, KH, KW, SH, SW, PT, PL, DH, DW, act;
  float actLo, actHi;
} pc;

void main() {
  int Coutb = (pc.Cout + 3) / 4;
  int HW = pc.OH * pc.OW;
  int nTX = (pc.OW + WTILE - 1) / WTILE;
  int ocbGroups = (Coutb + OCB_BLK - 1) / OCB_BLK;
  // Workgroup decode as in conv3x3_row: the block group inside the row-block, a 2-D wave footprint.
  int nTXg = (nTX + TILES_PER_WG - 1) / TILES_PER_WG;
  int rowsPerWg = int(gl_WorkGroupSize.x) / TILES_PER_WG;
  int nOYg = (pc.OH + rowsPerWg - 1) / rowsPerWg;
  uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (gid >= uint(pc.N * ocbGroups * nOYg * nTXg * int(gl_WorkGroupSize.x))) return;
  int lane = int(gid % gl_WorkGroupSize.x);
  int grp = int(gid / gl_WorkGroupSize.x);
  int tx = (grp % nTXg) * TILES_PER_WG + lane % TILES_PER_WG;
  int ocbg = (grp / nTXg) % ocbGroups;
  int oy = ((grp / (nTXg * ocbGroups)) % nOYg) * rowsPerWg + lane / TILES_PER_WG;
  int n = grp / (nTXg * ocbGroups * nOYg);
  if (tx >= nTX || oy >= pc.OH) return;
  int ocb0 = ocbg * OCB_BLK;
  int ox0 = tx * WTILE;
  int ixBase = ox0 * SW_SPEC - pc.PL;

  vec4 acc[WTILE][OCB_BLK];
  // One input channel-block, so the weight pack's per-output-channel stride is just the tap count.
  int ocStride = KTAPS;
  int wbj[OCB_BLK];
  for (int j = 0; j < OCB_BLK; ++j) {
    wbj[j] = min(ocb0 + j, Coutb - 1) * 4 * ocStride;
    vec4 b = (ocb0 + j < Coutb) ? vec4(bias[ocb0 + j]) : vec4(0.0);
    for (int p = 0; p < WTILE; ++p) acc[p][j] = b;
  }

  int planeStride = pc.H * pc.W; // dense NCHW: consecutive channels are whole planes apart
  for (int ky = 0; ky < KEXT; ++ky) {
    int iy = oy * pc.SH - pc.PT + ky;
    bool rowOk = uint(iy) < uint(pc.H);
    vec4 row[COLS];
    bool colOk[COLS];
    for (int c = 0; c < COLS; ++c) {
      int ix = ixBase + c;
      bool ok = rowOk && uint(ix) < uint(pc.W);
      colOk[c] = ok;
      vec4 v = vec4(0.0);
      if (ok) {
        int base = (n * CIN * planeStride) + iy * pc.W + ix;
        for (int ci = 0; ci < CIN; ++ci) v[ci] = float(src[base + ci * planeStride]);
      }
      row[c] = v;
    }
    for (int kx = 0; kx < KEXT; ++kx) {
      int wtap = ky * KEXT + kx;
      vec4 w[OCB_BLK][4];
      for (int j = 0; j < OCB_BLK; ++j) {
        w[j][0] = vec4(wt[wbj[j] + wtap * 4 + 0]);
        w[j][1] = vec4(wt[wbj[j] + wtap * 4 + 1]);
        w[j][2] = vec4(wt[wbj[j] + wtap * 4 + 2]);
        w[j][3] = vec4(wt[wbj[j] + wtap * 4 + 3]);
      }
      for (int p = 0; p < WTILE; ++p) {
        int c = p * SW_SPEC + kx;
        if (colOk[c]) {
          vec4 inv = row[c];
          for (int j = 0; j < OCB_BLK; ++j) {
            acc[p][j] = fma(vec4(inv.x), w[j][0], acc[p][j]);
            acc[p][j] = fma(vec4(inv.y), w[j][1], acc[p][j]);
            acc[p][j] = fma(vec4(inv.z), w[j][2], acc[p][j]);
            acc[p][j] = fma(vec4(inv.w), w[j][3], acc[p][j]);
          }
        }
      }
    }
  }
  for (int j = 0; j < OCB_BLK; ++j) {
    if (ocb0 + j >= Coutb) continue;
    int dbase = (n * Coutb + (ocb0 + j)) * HW;
    for (int p = 0; p < WTILE; ++p) {
      int ox = ox0 + p;
      if (ox < pc.OW) {
        int pix = oy * pc.OW + ox;
        vec4 v = vec4((acc[p][j].x * (1.0 / (1.0 + exp2(acc[p][j].x * -1.4426950408889634)))),
                      (acc[p][j].y * (1.0 / (1.0 + exp2(acc[p][j].y * -1.4426950408889634)))),
                      (acc[p][j].z * (1.0 / (1.0 + exp2(acc[p][j].z * -1.4426950408889634)))),
                      (acc[p][j].w * (1.0 / (1.0 + exp2(acc[p][j].w * -1.4426950408889634)))));
#ifdef PW_EPI
        v = pw_apply4(v, dbase + pix);
#endif
        dst[dbase + pix] = TO_STORE4(v);
      }
    }
  }
}
