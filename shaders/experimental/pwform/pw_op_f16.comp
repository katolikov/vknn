#version 450
#include "common_head.glsl"
void main() {
  int Cinb = (pc.Cin + 3) / 4, Coutb = (pc.Cout + 3) / 4, HW = pc.OH * pc.OW;
  int nTiles = (HW + WTILE - 1) / WTILE, ocbGroups = (Coutb + OCB - 1) / OCB;
  uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (gid >= uint(pc.N * ocbGroups * nTiles)) return;
  int tile = int(gid) % nTiles, og = (int(gid) / nTiles) % ocbGroups, n = int(gid) / (nTiles * ocbGroups);
  int p0 = tile * WTILE, ocb0 = og * OCB;
  f16vec4 acc[OCB][WTILE]; int ocbj[OCB];
  for (int j = 0; j < OCB; ++j) { ocbj[j] = min(ocb0 + j, Coutb - 1); f16vec4 b = bias[ocbj[j]]; for (int p = 0; p < WTILE; ++p) acc[j][p] = b; }
  for (int icb = 0; icb < Cinb; ++icb) {
    int sbase = (n * Cinb + icb) * HW;
    int wbase = icb * 4 * Coutb;
    f16vec4 inv[WTILE];
    for (int p = 0; p < WTILE; ++p) inv[p] = src[sbase + min(p0 + p, HW - 1)];
    for (int j = 0; j < OCB; ++j) {
      f16vec4 w0 = wt[wbase + 0 * Coutb + ocbj[j]], w1 = wt[wbase + 1 * Coutb + ocbj[j]];
      f16vec4 w2 = wt[wbase + 2 * Coutb + ocbj[j]], w3 = wt[wbase + 3 * Coutb + ocbj[j]];
      for (int p = 0; p < WTILE; ++p) {
        acc[j][p] = fma(f16vec4(inv[p].x), w0, acc[j][p]);
        acc[j][p] = fma(f16vec4(inv[p].y), w1, acc[j][p]);
        acc[j][p] = fma(f16vec4(inv[p].z), w2, acc[j][p]);
        acc[j][p] = fma(f16vec4(inv[p].w), w3, acc[j][p]);
      }
    }
  }
  for (int j = 0; j < OCB; ++j) { int ocb = ocb0 + j; if (ocb >= Coutb) break; int dbase = (n * Coutb + ocb) * HW;
    for (int p = 0; p < WTILE; ++p) { int pix = p0 + p; if (pix < HW) dst[dbase + pix] = TO_STORE4(vec4(acc[j][p])); } }
}
