#version 450
// 3x3 row probe, RTILE output rows per lane: the (RTILE-1)*STRIDE+3 input rows a lane's rows share
// are loaded once each (input-row outer loop) and applied to every output row they feed. Footprint
// decode from gl_WorkGroupID (block group uniform per workgroup). Microbench-only.
#include "k3_head.glsl"
#ifndef FORM
#define FORM 2
#endif
#define ACC vec4
#define LD(x) vec4(x)
#ifndef TX_PER_WG
#define TX_PER_WG 16
#endif
#define ROWS_PER_WG (64 / TX_PER_WG)
#ifndef RTILE
#define RTILE 2
#endif
#define RSEG ((RTILE - 1) * STRIDE + KEXT)
#define TAPS 9
void main() {
  int Cinb = (pc.Cin + 3) / 4, Coutb = (pc.Cout + 3) / 4, HW = pc.OH * pc.OW;
  int nTX = (pc.OW + PTILE - 1) / PTILE, ocbGroups = (Coutb + OCB_BLK - 1) / OCB_BLK;
  int nTXg = (nTX + TX_PER_WG - 1) / TX_PER_WG;
  int nTY = (pc.OH + RTILE - 1) / RTILE;
  int nOYg = (nTY + ROWS_PER_WG - 1) / ROWS_PER_WG;
  int grp = int(gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x);
  int lane = int(gl_LocalInvocationID.x);
  int tx = (grp % nTXg) * TX_PER_WG + lane % TX_PER_WG;
  int ocbg = (grp / nTXg) % ocbGroups;
  int ty = ((grp / (nTXg * ocbGroups)) % nOYg) * ROWS_PER_WG + lane / TX_PER_WG;
  int n = grp / (nTXg * ocbGroups * nOYg);
  if (tx >= nTX || ty >= nTY || n >= pc.N) return;
  int ocb0 = ocbg * OCB_BLK, ox0 = tx * PTILE, ixBase = ox0 * STRIDE - pc.PL, oy0 = ty * RTILE;
  ACC acc[RTILE][PTILE][OCB_BLK];
  for (int j = 0; j < OCB_BLK; ++j) { ACC b = (ocb0 + j < Coutb) ? LD(bias[ocb0 + j]) : ACC(0.0);
    for (int r = 0; r < RTILE; ++r) for (int p = 0; p < PTILE; ++p) acc[r][p][j] = b; }
  for (int icb = 0; icb < Cinb; ++icb) {
    int sb = (n * Cinb + icb) * pc.H * pc.W;
    for (int iyr = 0; iyr < RSEG; ++iyr) {
      int iy = oy0 * STRIDE - pc.PT + iyr; bool rowOk = uint(iy) < uint(pc.H); int rowOff = sb + iy * pc.W;
      ACC row[SEG]; bool colOk[SEG];
      for (int c = 0; c < SEG; ++c) { int ix = ixBase + c; bool ok = rowOk && uint(ix) < uint(pc.W); colOk[c] = ok; row[c] = ok ? LD(src[rowOff + ix]) : ACC(0.0); }
      for (int r = 0; r < RTILE; ++r) {
        int ky = iyr - r * STRIDE;
        if (ky < 0 || ky >= KEXT) continue;
        for (int kx = 0; kx < 3; ++kx) {
          ACC w[OCB_BLK][4];
          for (int j = 0; j < OCB_BLK; ++j) {
            int wb = ((min(ocb0 + j, Coutb - 1) * Cinb + icb) * TAPS + (ky * 3 + kx)) * 4;
            w[j][0] = LD(wt[wb + 0]); w[j][1] = LD(wt[wb + 1]); w[j][2] = LD(wt[wb + 2]); w[j][3] = LD(wt[wb + 3]);
          }
          for (int p = 0; p < PTILE; ++p) {
            int c = p * STRIDE + kx;
            if (colOk[c]) {
              ACC inv = row[c];
              for (int j = 0; j < OCB_BLK; ++j) {
                acc[r][p][j] = fma(ACC(inv.x), w[j][0], acc[r][p][j]); acc[r][p][j] = fma(ACC(inv.y), w[j][1], acc[r][p][j]);
                acc[r][p][j] = fma(ACC(inv.z), w[j][2], acc[r][p][j]); acc[r][p][j] = fma(ACC(inv.w), w[j][3], acc[r][p][j]);
              }
            }
          }
        }
      }
    }
  }
  for (int j = 0; j < OCB_BLK; ++j) { if (ocb0 + j >= Coutb) continue; int dbase = (n * Coutb + (ocb0 + j)) * HW;
    for (int r = 0; r < RTILE; ++r) { int oy = oy0 + r; if (oy >= pc.OH) continue;
      for (int p = 0; p < PTILE; ++p) { int ox = ox0 + p; if (ox < pc.OW) dst[dbase + oy * pc.OW + ox] = TO_STORE4(vec4(acc[r][p][j])); } } }
}
