#version 450
// Strided pointwise 1x1 conv (group=1, stride>1, no pad), NC4HW4, fp16 — the ResNet downsample
// projection. Same register-tiled scheme as conv1x1 (one thread = OCB output channel-blocks for
// WTILE output pixels), with the input pixel gathered at the stride (output (oh,ow) reads input
// (oh*SH, ow*SW)). OCB == 1 keeps the classic single-block body (specialization branch resolved
// at pipeline build); OCB == 2 halves the strided-gather input traffic per output.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"
#ifdef PW_EPI
#define STORE float16_t
#define PW_EPI_BASE 5
#include "pw_epilogue.glsl"
#endif
#ifdef PW_PRO
#define PRO_BASE 5
#define PRO_VEC f16vec4
#include "input_affine.glsl"
#endif
layout(constant_id = 0) const int HAS_RES = 0;  // fused residual add (out = act(conv + res))
layout(constant_id = 1) const int WTILE = 4;    // output pixels per thread (autotuned per shape)
layout(constant_id = 2) const int OCB = 1;      // output channel-blocks per thread (autotuned per shape)
layout(local_size_x = 64, local_size_x_id = 3) in; // trailing spec = device-resolved lane width (env.convLocalSize), matching the fp32 twin
layout(std430, binding = 0) readonly buffer Src { f16vec4 src[]; };
layout(std430, binding = 1) readonly buffer Wt { f16vec4 wt[]; };
layout(std430, binding = 2) readonly buffer Bs { f16vec4 bias[]; };
layout(std430, binding = 3) writeonly buffer Dst { f16vec4 dst[]; };
layout(std430, binding = 4) readonly buffer Res { f16vec4 res[]; };
layout(push_constant) uniform PC {
  int N, Cin, H, W, Cout, OH, OW, KH, KW, SH, SW, PT, PL, DH, DW, act;
  float actLo, actHi;
#ifdef PW_PRO
  int gidBase;          // conv_reg's slice base; declared here only to place the prologue fields
  int proFlags, proAct; // input-affine prologue (input_affine.glsl): flags and activation
  float proLo, proHi;
#endif
}
pc;

vec4 applyAct(vec4 v) {
  return vec4(vx_act(v.x, pc.act, pc.actLo, pc.actHi),
              vx_act(v.y, pc.act, pc.actLo, pc.actHi),
              vx_act(v.z, pc.act, pc.actLo, pc.actHi),
              vx_act(v.w, pc.act, pc.actLo, pc.actHi));
}

void main() {
  int Cinb = (pc.Cin + 3) / 4;
  int Coutb = (pc.Cout + 3) / 4;
  int IHW = pc.H * pc.W;        // input spatial
  int OHW = pc.OH * pc.OW;      // output spatial
  int nTiles = (OHW + WTILE - 1) / WTILE;
  uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;

  if (OCB == 1) {
    // classic body: one output channel-block per thread.
    // Block group inside a workgroup-sized chunk of pixel tiles: every output block of one chunk
    // runs back to back, so the input a later block re-reads is still in cache instead of
    // being streamed once per block (the last chunk's padding lanes retire on the tile bound).
    int wg = int(gl_WorkGroupSize.x);
    int nChunks = (nTiles + wg - 1) / wg;
    // Chunk width sized to the map: the tiles split evenly over nChunks, so a map with
    // fewer tiles than a workgroup (a 7x7 output has 25 two-pixel tiles) does not pad every
    // block group to wg lanes that retire idle.
    int chunk = (nTiles + nChunks - 1) / nChunks;
    if (gid >= uint(pc.N * Coutb * nChunks * chunk)) return;
    int grp = int(gid / uint(chunk));
    int tile = (grp / Coutb) % nChunks * chunk + int(gid % uint(chunk));
    int ocb = grp % Coutb;
    int n = grp / (Coutb * nChunks);
    if (tile >= nTiles) return;
    int p0 = tile * WTILE;

    vec4 acc[WTILE];
    vec4 b = vec4(bias[ocb]);
    for (int p = 0; p < WTILE; ++p) acc[p] = b;

    int wrow = ocb * 4 * Cinb;
    int sbaseN = n * Cinb * IHW;
    for (int icb = 0; icb < Cinb; ++icb) {
#ifdef PW_PRO
      vec4 proS = proScaleOf(pc.proFlags, n, icb, Cinb), proB = proShiftOf(pc.proFlags, n, icb, Cinb);
#endif
      vec4 w0 = vec4(wt[wrow + icb * 4 + 0]);
      vec4 w1 = vec4(wt[wrow + icb * 4 + 1]);
      vec4 w2 = vec4(wt[wrow + icb * 4 + 2]);
      vec4 w3 = vec4(wt[wrow + icb * 4 + 3]);
      int sbase = sbaseN + icb * IHW;
      for (int p = 0; p < WTILE; ++p) {
        int opix = min(p0 + p, OHW - 1);
        int oh = opix / pc.OW, ow = opix % pc.OW;
        int ipix = (oh * pc.SH) * pc.W + (ow * pc.SW);
        vec4 inv = vec4(src[sbase + ipix]);
#ifdef PW_PRO
        inv = proApply(inv, proS, proB, pc.proFlags, pc.proAct, pc.proLo, pc.proHi);
#endif
        acc[p] = fma(vec4(inv.x), w0, acc[p]);
        acc[p] = fma(vec4(inv.y), w1, acc[p]);
        acc[p] = fma(vec4(inv.z), w2, acc[p]);
        acc[p] = fma(vec4(inv.w), w3, acc[p]);
      }
    }
    int dbase = (n * Coutb + ocb) * OHW;
    for (int p = 0; p < WTILE; ++p) {
      int opix = p0 + p;
      if (opix < OHW) {
        vec4 v = acc[p];
        if (HAS_RES != 0) v += vec4(res[dbase + opix]);
        v = applyAct(v);
#ifdef PW_EPI
        v = pw_apply4(v, dbase + opix);
#endif
        dst[dbase + opix] = TO_STORE4(v);
      }
    }
    return;
  }

  // OCB > 1: tiled body. Weight-row offsets are hoisted out of the K loop.
  int ocbGroups = (Coutb + OCB - 1) / OCB;
  int wg = int(gl_WorkGroupSize.x);
  int nChunks = (nTiles + wg - 1) / wg;
  // Chunk width sized to the map: the tiles split evenly over nChunks, so a map with
  // fewer tiles than a workgroup (a 7x7 output has 25 two-pixel tiles) does not pad every
  // block group to wg lanes that retire idle.
  int chunk = (nTiles + nChunks - 1) / nChunks;
  if (gid >= uint(pc.N * ocbGroups * nChunks * chunk)) return;
  int grp = int(gid / uint(chunk));
  int tile = (grp / ocbGroups) % nChunks * chunk + int(gid % uint(chunk));
  int og = grp % ocbGroups;
  int n = grp / (ocbGroups * nChunks);
  if (tile >= nTiles) return;
  int p0 = tile * WTILE;
  int ocb0 = og * OCB;

  vec4 acc[OCB][WTILE];
  int wrowj[OCB];
  for (int j = 0; j < OCB; ++j) {
    // clamp: the last thread's block group can overhang Coutb; re-read a valid block
    // (the overhanging accumulator is never stored).
    wrowj[j] = min(ocb0 + j, Coutb - 1) * 4 * Cinb;
    vec4 b = vec4(bias[min(ocb0 + j, Coutb - 1)]);
    for (int p = 0; p < WTILE; ++p) acc[j][p] = b;
  }

  int sbaseN = n * Cinb * IHW;
  for (int icb = 0; icb < Cinb; ++icb) {
#ifdef PW_PRO
    vec4 proS = proScaleOf(pc.proFlags, n, icb, Cinb), proB = proShiftOf(pc.proFlags, n, icb, Cinb);
#endif
    int sbase = sbaseN + icb * IHW;
    for (int j = 0; j < OCB; ++j) {
      vec4 w0 = vec4(wt[wrowj[j] + icb * 4 + 0]);
      vec4 w1 = vec4(wt[wrowj[j] + icb * 4 + 1]);
      vec4 w2 = vec4(wt[wrowj[j] + icb * 4 + 2]);
      vec4 w3 = vec4(wt[wrowj[j] + icb * 4 + 3]);
      for (int p = 0; p < WTILE; ++p) {
        int opix = min(p0 + p, OHW - 1);
        int oh = opix / pc.OW, ow = opix % pc.OW;
        int ipix = (oh * pc.SH) * pc.W + (ow * pc.SW);
        vec4 inv = vec4(src[sbase + ipix]);
#ifdef PW_PRO
        inv = proApply(inv, proS, proB, pc.proFlags, pc.proAct, pc.proLo, pc.proHi);
#endif
        acc[j][p] = fma(vec4(inv.x), w0, acc[j][p]);
        acc[j][p] = fma(vec4(inv.y), w1, acc[j][p]);
        acc[j][p] = fma(vec4(inv.z), w2, acc[j][p]);
        acc[j][p] = fma(vec4(inv.w), w3, acc[j][p]);
      }
    }
  }
  for (int j = 0; j < OCB; ++j) {
    int ocb = ocb0 + j;
    if (ocb >= Coutb) break;
    int dbase = (n * Coutb + ocb) * OHW;
    for (int p = 0; p < WTILE; ++p) {
      int opix = p0 + p;
      if (opix < OHW) {
        vec4 v = acc[j][p];
        if (HAS_RES != 0) v += vec4(res[dbase + opix]);
        v = applyAct(v);
#ifdef PW_EPI
        v = pw_apply4(v, dbase + opix);
#endif
        dst[dbase + opix] = TO_STORE4(v);
      }
    }
  }
}
