#version 450
// Winograd F(4x4,3x3) input transform: V = Bt * d * B, 36 transform points per 6x6 input tile
// (4x4 output). vs F(2,3): 0.56x the transform-domain traffic and 4x (vs 2.25x) the FLOP saving,
// at the cost of larger transform coefficients (watched for fp16 precision). Vbuf: [pos(0..35)][icb][tile].
//
// Bt (6x6):
//   [ 4  0 -5  0  1  0]
//   [ 0 -4 -4  1  1  0]
//   [ 0  4 -4 -1  1  0]
//   [ 0 -2 -1  2  1  0]
//   [ 0  2 -1 -2  1  0]
//   [ 0  4  0 -5  0  1]
//
// Separable two-stage form: one (icb, tile) unit is LANES cooperating threads, one per transform
// column in the first stage (Bt * d, staged in shared memory) and one per transform row in the
// second (* B). A deep small map (256 channels at 14x14) has only 1024 units, and one thread per
// unit ran 16 waves of a 36-load/36-store job - latency-bound at a sixth of the memory rate. The
// host sizes the dispatch with winoTransformGroups (src/core/wino_f63.h): UNITS_PER_GROUP units per
// 64-lane workgroup, so LANES and UNITS_PER_GROUP mirror kWinoF43TransformLanes and
// kWinoF43TransformUnitsPerGroup there. Each Bt row keeps the one-expression form of the
// single-thread kernel, so every output is the same fp32 sequence.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"
#define ALPHA 6           // transform edge: 6x6 points per tile
#define LANES 6           // threads per unit (kWinoF43TransformLanes)
#define UNITS_PER_GROUP 10 // units per 64-lane workgroup (kWinoF43TransformUnitsPerGroup)
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Src { f16vec4 src[]; };
layout(std430, binding = 1) writeonly buffer V { f16vec4 vbuf[]; };
layout(push_constant) uniform PC { int N, C, H, W, OH, OW, nTH, nTW; } pc;
shared vec4 sT[UNITS_PER_GROUP][ALPHA][ALPHA]; // [unit][row i][column c], fp32 column-pass staging

void main() {
  int Cinb = (pc.C + 3) / 4;
  int nT = pc.N * pc.nTH * pc.nTW;
  int lid = int(gl_LocalInvocationID.x);
  int unit = lid / LANES;   // 0..UNITS_PER_GROUP-1; the last 64 % LANES lanes belong to no unit
  int lane = lid % LANES;
  int unitId = int(gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * UNITS_PER_GROUP + unit;
  bool unitLive = unit < UNITS_PER_GROUP && unitId < Cinb * nT;
  int tile = unitLive ? unitId % nT : 0;
  int icb = unitLive ? unitId / nT : 0;
  int tx = tile % pc.nTW;
  int ty = (tile / pc.nTW) % pc.nTH;
  int n = tile / (pc.nTH * pc.nTW);
  if (unitLive) {
    // Column pass: this lane's transform column c = lane over the 6 input rows.
    vec4 d[ALPHA];
    int base = (n * Cinb + icb) * pc.H * pc.W;
    int ix = tx * 4 - 1 + lane;
    for (int r = 0; r < ALPHA; ++r) {
      int iy = ty * 4 - 1 + r;
      d[r] = (iy >= 0 && iy < pc.H && ix >= 0 && ix < pc.W)
                 ? vec4(src[base + iy * pc.W + ix])
                 : vec4(0.0);
    }
    sT[unit][0][lane] = 4.0 * d[0] - 5.0 * d[2] + d[4];            // Bt[0]: [ 4  0 -5  0  1  0]
    sT[unit][1][lane] = -4.0 * d[1] - 4.0 * d[2] + d[3] + d[4]; // Bt[1]: [ 0 -4 -4  1  1  0]
    sT[unit][2][lane] = 4.0 * d[1] - 4.0 * d[2] - d[3] + d[4];  // Bt[2]: [ 0  4 -4 -1  1  0]
    sT[unit][3][lane] = -2.0 * d[1] - d[2] + 2.0 * d[3] + d[4]; // Bt[3]: [ 0 -2 -1  2  1  0]
    sT[unit][4][lane] = 2.0 * d[1] - d[2] - 2.0 * d[3] + d[4];  // Bt[4]: [ 0  2 -1 -2  1  0]
    sT[unit][5][lane] = 4.0 * d[1] - 5.0 * d[3] + d[5];            // Bt[5]: [ 0  4  0 -5  0  1]
  }
  barrier();
  if (!unitLive) return;
  // Row pass: this lane's transform row r = lane across the staged columns.
  vec4 t[ALPHA];
  for (int c = 0; c < ALPHA; ++c) t[c] = sT[unit][lane][c];
  vec4 v0 = 4.0 * t[0] - 5.0 * t[2] + t[4];            // Bt[0]
  vec4 v1 = -4.0 * t[1] - 4.0 * t[2] + t[3] + t[4]; // Bt[1]
  vec4 v2 = 4.0 * t[1] - 4.0 * t[2] - t[3] + t[4];  // Bt[2]
  vec4 v3 = -2.0 * t[1] - t[2] + 2.0 * t[3] + t[4]; // Bt[3]
  vec4 v4 = 2.0 * t[1] - t[2] - 2.0 * t[3] + t[4];  // Bt[4]
  vec4 v5 = 4.0 * t[1] - 5.0 * t[3] + t[5];            // Bt[5]
  int b = lane * ALPHA;
  vbuf[((b + 0) * Cinb + icb) * nT + tile] = f16vec4(v0);
  vbuf[((b + 1) * Cinb + icb) * nT + tile] = f16vec4(v1);
  vbuf[((b + 2) * Cinb + icb) * nT + tile] = f16vec4(v2);
  vbuf[((b + 3) * Cinb + icb) * nT + tile] = f16vec4(v3);
  vbuf[((b + 4) * Cinb + icb) * nT + tile] = f16vec4(v4);
  vbuf[((b + 5) * Cinb + icb) * nT + tile] = f16vec4(v5);
}
