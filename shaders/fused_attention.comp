#version 450
#define VKNN_NO_RTE 1 // matmul-family kernel: avoids the float-controls execution mode (miscompiled by some drivers); TO_STORE rounds explicitly
#include "precision.glsl"
#include "common.glsl"
// Fused single-query decode attention (contract in src/core/fused_attention.h):
//   out[row][n] = sum_s softmax_s(q.k^T * scale + mask * maskScale)[s] * v[s][n]
// One workgroup per attention row; the row's q/k/v/mask bases come from the per-axis strides in
// the geometry SSBO (a GQA head group is a zero stride, so K/V read the KV cache in place). The
// row is processed in three token-parallel stages so no lane ever serializes over the context:
//   1. scores: each lane owns whole tokens (256 in flight) and streams one K row contiguously
//      (kK is 1 for the folded KV layout) into a shared score array — the score never leaves the
//      workgroup.
//   2. softmax: workgroup tree max/sum reductions over the shared scores, then an in-place
//      exp(x - max) rewrite; the probabilities stay in shared memory.
//   3. p.V: lane tid owns output n = tid % hd and partial part = tid / hd — adjacent lanes read
//      adjacent V elements (vN is 1), and the WG/hd partials per output fold over a short
//      barrier loop.
// All arithmetic is fp32; only the final context vector is stored (fp16 via TO_STORE).
#define WG 256
#define FA_MAX_HD 256   // == vknn::kFaMaxHeadDim; bounds the q / context shared arrays
#define FA_MAX_C 6144   // == vknn::kFaMaxContext; bounds the shared score array (24 KB)
layout(local_size_x = WG) in;
layout(std430, binding = 0) readonly buffer Q { STORE q[]; };
layout(std430, binding = 1) readonly buffer K { STORE k[]; };
layout(std430, binding = 2) readonly buffer V { STORE v[]; };
layout(std430, binding = 3) writeonly buffer D { STORE d[]; };
layout(std430, binding = 4) readonly buffer M { STORE msk[]; };
// Geometry: g[0..rank) = row dims, then per-row-dim strides of q, k, v, mask (5 arrays total).
layout(std430, binding = 5) readonly buffer G { int g[]; } geom;
layout(push_constant) uniform PC {
  int rank, rows, C, hd;
  int qK, kN, kK, vN, vK, mN, hasMask;
  float scale, maskScale;
} pc;

shared float sQ[FA_MAX_HD];
shared float sScores[FA_MAX_C];
shared float sRed[WG];
shared float sAcc[FA_MAX_HD];

void main() {
  // One workgroup per row; the 1-D grid spills into y past the per-dim workgroup-count limit.
  uint row = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
  if (row >= uint(pc.rows)) return; // uniform per workgroup, so the barriers below stay uniform

  // Row bases from the per-axis strides (computed redundantly by every invocation).
  int qBase = 0, kBase = 0, vBase = 0, mBase = 0;
  {
    int rem = int(row);
    for (int i = pc.rank - 1; i >= 0; --i) {
      int c = rem % geom.g[i];
      rem /= geom.g[i];
      qBase += c * geom.g[pc.rank + i];
      kBase += c * geom.g[2 * pc.rank + i];
      vBase += c * geom.g[3 * pc.rank + i];
      mBase += c * geom.g[4 * pc.rank + i];
    }
  }

  int tid = int(gl_LocalInvocationID.x);
  for (int n = tid; n < pc.hd; n += WG)
    sQ[n] = float(q[qBase + n * pc.qK]);
  barrier();

  // Stage 1: one lane per token — the dot streams K contiguously; 256 tokens stay in flight.
  for (int s = tid; s < pc.C; s += WG) {
    float dot = 0.0;
    int base = kBase + s * pc.kN;
    for (int kk = 0; kk < pc.hd; ++kk)
      dot += sQ[kk] * float(k[base + kk * pc.kK]);
    float x = dot * pc.scale;
    if (pc.hasMask != 0) x += float(msk[mBase + s * pc.mN]) * pc.maskScale;
    sScores[s] = x;
  }
  barrier();

  // Stage 2: workgroup softmax over the shared scores. Tree max, in-place exp, tree sum.
  float localMax = -3.4e38;
  for (int s = tid; s < pc.C; s += WG) localMax = max(localMax, sScores[s]);
  sRed[tid] = localMax;
  barrier();
  for (int step = WG / 2; step > 0; step >>= 1) {
    if (tid < step) sRed[tid] = max(sRed[tid], sRed[tid + step]);
    barrier();
  }
  float gM = sRed[0];
  barrier(); // sRed is reused for the sum below
  float localSum = 0.0;
  for (int s = tid; s < pc.C; s += WG) {
    float p = exp(sScores[s] - gM);
    sScores[s] = p;
    localSum += p;
  }
  sRed[tid] = localSum;
  barrier();
  for (int step = WG / 2; step > 0; step >>= 1) {
    if (tid < step) sRed[tid] += sRed[tid + step];
    barrier();
  }
  float rL = 1.0 / sRed[0];

  // Stage 3: p.V. Lane tid owns output n and context slice `part`; the WG/hd partials per output
  // fold over a short barrier loop (parts is at least 1: hd <= WG).
  int parts = WG / pc.hd > 0 ? WG / pc.hd : 1;
  int n = tid % pc.hd;
  int part = tid / pc.hd;
  float acc = 0.0;
  if (part < parts) {
    for (int s = part; s < pc.C; s += parts)
      acc += sScores[s] * float(v[vBase + s * pc.vK + n * pc.vN]);
  }
  for (int m = tid; m < pc.hd; m += WG) sAcc[m] = 0.0;
  barrier();
  for (int fold = 0; fold < parts; ++fold) {
    if (part == fold) sAcc[n] += acc;
    barrier();
  }
  for (int m = tid; m < pc.hd; m += WG)
    d[int(row) * pc.hd + m] = TO_STORE(sAcc[m] * rL);
}
