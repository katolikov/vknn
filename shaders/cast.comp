#version 450
#include "precision.glsl"
#include "common.glsl"
// Cast to an integer target. The flat GPU path carries logical integers as compute-precision storage
// (STORE = fp32 or fp16), so an integer value is a truncated float here; the graph boundary repacks it
// to the declared output dtype. float->float casts stay a plain buffer copy in the op.
//
// `mode` selects the narrowing so the stored value matches the CPU Cast op followed by the readback
// narrowing (session.cpp readbackOutput), bit-for-bit. The values mirror the kCastMode* constants in
// src/backend/vulkan/ops/cast.cpp:
//   kCastModeWide (0)          wide integer (INT32/INT64/UINT32/UINT64): truncate toward zero, clamp
//                              only to fence off inf/NaN. INT16/UINT16 share it with saturating bounds.
//   kCastModeInt8Wrap (1)      INT8: truncate, then wrap modulo 2^8 into [-128,127] (ONNX Cast to a
//                              smaller int is modulo, matching the C (int8_t) narrowing readbackOutput
//                              applies).
//   kCastModeUInt8Saturate (2) UINT8: truncate, then saturate to [0,255] (matching readbackOutput's
//                              clamp for uint8).
//   kCastModeBool (3)          BOOL: a truth test, not a truncation. 1 for any nonzero value (negative,
//                              fractional, infinite, NaN), 0 for +0 and -0.
// The narrowed result is always small (<=255 magnitude for INT8/UINT8, 0 or 1 for BOOL), hence exact in
// both fp16 and fp32 storage, and the terminal readback re-narrowing is idempotent.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer S { STORE s[]; };
layout(std430, binding = 1) writeonly buffer D { STORE d[]; };
layout(push_constant) uniform PC { int total; float lo, hi; int mode; } pc;

const int kCastModeWide          = 0;
const int kCastModeInt8Wrap      = 1;
const int kCastModeUInt8Saturate = 2;
const int kCastModeBool          = 3;
// Every fp32 bit except the sign bit. A value is zero exactly when these bits are all clear (+0 and -0);
// every other pattern -- subnormals, infinities and NaNs included -- is nonzero.
const uint kCastFloatMagnitudeBits = 0x7FFFFFFFu;

// BOOL truth test on the widened source value. Decided on the bit pattern rather than a float compare,
// so a NaN counts as nonzero without depending on how the driver orders comparisons against NaN.
float castBoolValue(float source) {
  return (floatBitsToUint(source) & kCastFloatMagnitudeBits) != 0u ? 1.0 : 0.0;
}

void main() {
  uint g = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (g >= uint(pc.total)) return;
  float t = trunc(float(s[g]));
  float outv;
  if (pc.mode == kCastModeBool) {
    outv = castBoolValue(float(s[g]));
  } else if (pc.mode == kCastModeInt8Wrap) {
    // INT8 modulo wrap: reinterpret the low 8 bits of the truncated integer as a signed byte.
    int m = int(t) & 0xFF;
    if (m >= 128) m -= 256;
    outv = float(m);
  } else {
    // kCastModeWide (clamp to fence inf/NaN) and kCastModeUInt8Saturate (saturate to [0,255]) both
    // clamp.
    outv = clamp(t, pc.lo, pc.hi);
  }
  d[g] = STORE(outv);
}
