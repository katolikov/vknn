#version 450
#define VKNN_NO_RTE 1 // this kernel avoids the float-controls execution mode (miscompiled by some drivers); TO_STORE rounds explicitly
#include "precision.glsl"
#ifdef PW_EPI
#define PW_EPI_BASE 7
#include "pw_epilogue.glsl"
#endif
// matmul_gemv_i4.comp with a fused rank-1 [N] bias at binding 6: out[r,n] = sum_k A*W + bias[n].
// The bias enters in the reducing lane, before the store, so it is added exactly once regardless
// of I4_KS. Structure, weight addressing, and the interior-lane / whole-group specializations are
// documented in matmul_gemv_i4.comp.
#include "common.glsl"
#define I4_NX 8  // lanes along n, 8 outputs each: 64 outputs per workgroup
#define I4_KS 16 // lanes reducing over k; 8 x 16 = 128 == the Vulkan-guaranteed workgroup size
#define I4_U 8   // k steps a lane loads before it consumes any of them (memory-level parallelism)
layout(local_size_x = I4_NX, local_size_y = I4_KS) in;
layout(std430, binding = 0) readonly  buffer A  { STORE a[]; };
layout(std430, binding = 1) readonly  buffer BP { uint bp[]; };
layout(std430, binding = 2) writeonly buffer D  { STORE d[]; };
layout(std430, binding = 3) readonly  buffer SC { STORE sc[]; };
layout(std430, binding = 4) readonly  buffer OI { int oi[]; };
layout(std430, binding = 5) readonly  buffer OV { STORE ov[]; };
layout(std430, binding = 6) readonly  buffer BS { STORE bias[]; };
layout(push_constant) uniform PC {
  int total, M, N, K, group, nOut, rowWords, nGroups;
} pc;

shared vec4 part0[I4_KS][I4_NX];
shared vec4 part1[I4_KS][I4_NX];

// Sign-extended int4 lanes 0..3 / 4..7 of a packed word.
vec4 nibLo(uint w) {
  return vec4(bitfieldExtract(int(w), 0, 4), bitfieldExtract(int(w), 4, 4),
              bitfieldExtract(int(w), 8, 4), bitfieldExtract(int(w), 12, 4));
}
vec4 nibHi(uint w) {
  return vec4(bitfieldExtract(int(w), 16, 4), bitfieldExtract(int(w), 20, 4),
              bitfieldExtract(int(w), 24, 4), bitfieldExtract(int(w), 28, 4));
}

// 4 adjacent group scales, unguarded — interior lanes only (n0 + 8 <= N). idx = g*N + n0 (+4).
vec4 scaleQuad(int idx) {
  return vec4(float(sc[idx]), float(sc[idx + 1]), float(sc[idx + 2]), float(sc[idx + 3]));
}

// One I4_U-deep k slice; load/FMA split and rationale in matmul_gemv_i4.comp.
#define I4_LOAD8(aIdx, wIdx) \
    float a0 = float(a[(aIdx)]); \
    float a1 = float(a[(aIdx) + I4_KS]); \
    float a2 = float(a[(aIdx) + 2 * I4_KS]); \
    float a3 = float(a[(aIdx) + 3 * I4_KS]); \
    float a4 = float(a[(aIdx) + 4 * I4_KS]); \
    float a5 = float(a[(aIdx) + 5 * I4_KS]); \
    float a6 = float(a[(aIdx) + 6 * I4_KS]); \
    float a7 = float(a[(aIdx) + 7 * I4_KS]); \
    uint  w0 = bp[(wIdx)]; \
    uint  w1 = bp[(wIdx) + wStep]; \
    uint  w2 = bp[(wIdx) + 2 * wStep]; \
    uint  w3 = bp[(wIdx) + 3 * wStep]; \
    uint  w4 = bp[(wIdx) + 4 * wStep]; \
    uint  w5 = bp[(wIdx) + 5 * wStep]; \
    uint  w6 = bp[(wIdx) + 6 * wStep]; \
    uint  w7 = bp[(wIdx) + 7 * wStep];
#define I4_FMA8(sLo, sHi) \
    acc0 += a0 * nibLo(w0) * (sLo); acc1 += a0 * nibHi(w0) * (sHi); \
    acc0 += a1 * nibLo(w1) * (sLo); acc1 += a1 * nibHi(w1) * (sHi); \
    acc0 += a2 * nibLo(w2) * (sLo); acc1 += a2 * nibHi(w2) * (sHi); \
    acc0 += a3 * nibLo(w3) * (sLo); acc1 += a3 * nibHi(w3) * (sHi); \
    acc0 += a4 * nibLo(w4) * (sLo); acc1 += a4 * nibHi(w4) * (sHi); \
    acc0 += a5 * nibLo(w5) * (sLo); acc1 += a5 * nibHi(w5) * (sHi); \
    acc0 += a6 * nibLo(w6) * (sLo); acc1 += a6 * nibHi(w6) * (sHi); \
    acc0 += a7 * nibLo(w7) * (sLo); acc1 += a7 * nibHi(w7) * (sHi);
// One k step on the group scales held in s0/s1.
#define I4_STEP1(aIdx, wIdx) { \
    float ak = float(a[(aIdx)]); \
    uint  wv = bp[(wIdx)]; \
    acc0 += ak * nibLo(wv) * s0; \
    acc1 += ak * nibHi(wv) * s1; \
  }

void main() {
  int row = int(gl_WorkGroupID.y);                              // output row (flattened batch, M == 1)
  int n0  = (int(gl_WorkGroupID.x) * I4_NX + int(gl_LocalInvocationID.x)) * 8;
  int ky  = int(gl_LocalInvocationID.y);
  bool live  = n0 < pc.N;
  bool full8 = n0 + 8 <= pc.N; // this lane's whole 8-output block is interior
  int aBase = row * pc.K;
  int wcol  = n0 / 8;          // this lane's packed word column
  int wStep = I4_KS * pc.rowWords;

  // Guarded per-column scale fetch: the tail block past N reads 0, so its padding nibbles stay 0.
  #define SCALE4(g4, off) vec4( \
      n0 + off + 0 < pc.N ? float(sc[(g4) * pc.N + n0 + off + 0]) : 0.0, \
      n0 + off + 1 < pc.N ? float(sc[(g4) * pc.N + n0 + off + 1]) : 0.0, \
      n0 + off + 2 < pc.N ? float(sc[(g4) * pc.N + n0 + off + 2]) : 0.0, \
      n0 + off + 3 < pc.N ? float(sc[(g4) * pc.N + n0 + off + 3]) : 0.0)

  vec4 acc0 = vec4(0.0), acc1 = vec4(0.0);
  if (live) {
    if (full8 && pc.group == I4_U * I4_KS) {
      // Whole-group path: each full group is exactly one I4_U-deep slice per lane.
      int nFull = pc.K / pc.group; // groups whose slice is a complete unrolled body
      vec4 s0 = scaleQuad(n0), s1 = scaleQuad(n0 + 4);
      int aIdx = aBase + ky;
      int wIdx = ky * pc.rowWords + wcol;
      int wGroupStep = pc.group * pc.rowWords;
      for (int g = 0; g < nFull; ++g) {
        I4_LOAD8(aIdx, wIdx)
        // Next group's scales issue before the FMA chain (rationale in matmul_gemv_i4.comp).
        int scNext = min(g + 1, pc.nGroups - 1) * pc.N + n0;
        vec4 sn0 = scaleQuad(scNext), sn1 = scaleQuad(scNext + 4);
        I4_FMA8(s0, s1)
        s0 = sn0; s1 = sn1;
        aIdx += pc.group;
        wIdx += wGroupStep;
      }
      // Trailing partial group (K % group != 0): strided single steps on the prefetched scales.
      for (int k = nFull * pc.group + ky; k < pc.K; k += I4_KS)
        I4_STEP1(aBase + k, k * pc.rowWords + wcol)
    } else {
      // Generic path: any group size >= 1, and the tail lane of a non-multiple-of-8 N.
      for (int g = 0; g < pc.nGroups; ++g) {
        vec4 s0, s1;
        if (full8) {
          int scIdx = g * pc.N + n0;
          s0 = scaleQuad(scIdx); s1 = scaleQuad(scIdx + 4);
        } else {
          s0 = SCALE4(g, 0); s1 = SCALE4(g, 4);
        }
        int kEnd = min(pc.K, (g + 1) * pc.group);
        int k = g * pc.group + ky;
        for (; k + (I4_U - 1) * I4_KS < kEnd; k += I4_U * I4_KS) {
          I4_LOAD8(aBase + k, k * pc.rowWords + wcol)
          I4_FMA8(s0, s1)
        }
        for (; k < kEnd; k += I4_KS)
          I4_STEP1(aBase + k, k * pc.rowWords + wcol)
      }
    }
    // Outlier columns, split over the ky lanes (rationale in matmul_gemv_i4.comp).
    if (full8) {
      for (int j = int(ky); j < pc.nOut; j += I4_KS) {
        float av = float(a[aBase + oi[j]]);
        int ovIdx = j * pc.N + n0;
        acc0 += av * vec4(float(ov[ovIdx]),     float(ov[ovIdx + 1]),
                          float(ov[ovIdx + 2]), float(ov[ovIdx + 3]));
        acc1 += av * vec4(float(ov[ovIdx + 4]), float(ov[ovIdx + 5]),
                          float(ov[ovIdx + 6]), float(ov[ovIdx + 7]));
      }
    } else {
      for (int j = int(ky); j < pc.nOut; j += I4_KS) {
        float av = float(a[aBase + oi[j]]);
        for (int t = 0; t < 4; ++t) {
          if (n0 + t < pc.N)     acc0[t] += av * float(ov[j * pc.N + n0 + t]);
          if (n0 + 4 + t < pc.N) acc1[t] += av * float(ov[j * pc.N + n0 + 4 + t]);
        }
      }
    }
  }
  // Every invocation stores (dead lanes store 0) so barrier() stays in uniform control flow.
  part0[ky][gl_LocalInvocationID.x] = acc0;
  part1[ky][gl_LocalInvocationID.x] = acc1;
  barrier();
  if (ky != 0 || !live) return;

  vec4 s0 = vec4(0.0), s1 = vec4(0.0);
  for (int i = 0; i < I4_KS; ++i) {
    s0 += part0[i][gl_LocalInvocationID.x];
    s1 += part1[i][gl_LocalInvocationID.x];
  }
  int dBase = row * pc.N;
  if (full8) {
    s0 += vec4(float(bias[n0]),     float(bias[n0 + 1]),
               float(bias[n0 + 2]), float(bias[n0 + 3]));
    s1 += vec4(float(bias[n0 + 4]), float(bias[n0 + 5]),
               float(bias[n0 + 6]), float(bias[n0 + 7]));
    for (int t = 0; t < 4; ++t) {
      int n = n0 + t;
#ifdef PW_EPI
      d[dBase + n] = TO_STORE(pw_apply(s0[t], dBase + n));
#else
      d[dBase + n] = TO_STORE(s0[t]);
#endif
      n = n0 + 4 + t;
#ifdef PW_EPI
      d[dBase + n] = TO_STORE(pw_apply(s1[t], dBase + n));
#else
      d[dBase + n] = TO_STORE(s1[t]);
#endif
    }
  } else {
    for (int t = 0; t < 4; ++t) {
      if (n0 + t < pc.N)     s0[t] += float(bias[n0 + t]);
      if (n0 + 4 + t < pc.N) s1[t] += float(bias[n0 + 4 + t]);
    }
    for (int t = 0; t < 4; ++t) {
      int n = n0 + t;
      if (n < pc.N) {
#ifdef PW_EPI
        d[dBase + n] = TO_STORE(pw_apply(s0[t], dBase + n));
#else
        d[dBase + n] = TO_STORE(s0[t]);
#endif
      }
      n = n0 + 4 + t;
      if (n < pc.N) {
#ifdef PW_EPI
        d[dBase + n] = TO_STORE(pw_apply(s1[t], dBase + n));
#else
        d[dBase + n] = TO_STORE(s1[t]);
#endif
      }
    }
  }
}
