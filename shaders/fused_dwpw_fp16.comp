#version 450
// Fused depthwise + 1x1-project (NC4HW4, fp16). One workgroup per output pixel: phase A computes
// the depthwise output for all expanded channel-blocks of this pixel into LDS, phase B does the 1x1
// project reading from LDS. The expanded intermediate stays in LDS and never touches global memory.
// Each LDS lane is rounded through TO_STORE — the byte the unfused depthwise kernel
// (dwconv_fp16.comp) stores to its fp16 output tensor — so the projection reads exactly the values
// the unfused 1x1 conv would load; phase B then sums in the same partition (pwKParts/pwChunk, from
// pw_splitk_rule.h) the unfused 1x1 kernel for this shape uses, so the fused output is
// byte-identical to the unfused fp16 pipeline. This is the small-spatial fallback of the tiled
// kernel (fused_dwpw_t_fp16.comp).
// Parallelism = N*OH*OW workgroups.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"
#ifdef PW_EPI
#define STORE float16_t
#define PW_EPI_BASE 7
#include "pw_epilogue.glsl"
#endif
layout(constant_id = 0) const int HAS_RES = 0;
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly  buffer Exp { f16vec4 expb[]; };
layout(std430, binding = 1) readonly  buffer DwW { f16vec4 dww[]; };
layout(std430, binding = 2) readonly  buffer DwB { f16vec4 dwb[]; };
layout(std430, binding = 3) readonly  buffer PwW { f16vec4 pww[]; };
layout(std430, binding = 4) readonly  buffer PwB { f16vec4 pwb[]; };
layout(std430, binding = 5) writeonly buffer Dst { f16vec4 dst[]; };
layout(std430, binding = 6) readonly  buffer Res { f16vec4 res[]; };
layout(push_constant) uniform PC {
  int N, E, H, W, Cout, OH, OW, KH, KW, SH, SW, PT, PL, DH, DW_, dwAct, pwAct;
  // Project-stage reduction partition (see phase B): pwKParts chunks of pwChunk channel-blocks.
  int pwKParts, pwChunk;
  float pwLo, pwHi;
} pc;
// Depthwise output for this pixel (E channels), scalar SoA. Sized by the same E cap as the tiled
// kernels (kDwPwMaxExpanded in src/core/fused_dwpw.h); each value is fp16-rounded (see header) but
// held widened in a float lane — bit-identical to staging f16, since widening fp16 is exact.
#define MAX_E 1152
shared float comm[MAX_E];

void main() {
  int Eb = (pc.E + 3) / 4;
  int Coutb = (pc.Cout + 3) / 4;
  int OHW = pc.OH * pc.OW;
  // 2-term recovery: an oversized 1D dispatch is split into (x, y) by ComputePipeline::dispatch.
  uint wg = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
  if (wg >= uint(pc.N * OHW)) return;
  int pix = int(wg) % OHW;
  int n = int(wg) / OHW;
  int oy = pix / pc.OW, ox = pix % pc.OW;
  int tid = int(gl_LocalInvocationID.x);

  // Phase A: depthwise 3x3 for every channel-block at this output pixel -> LDS.
  for (int eb = tid; eb < Eb; eb += 64) {
    vec4 acc = vec4(dwb[eb]);
    int sb = (n * Eb + eb) * pc.H * pc.W;
    for (int ky = 0; ky < pc.KH; ++ky) {
      int iy = oy * pc.SH - pc.PT + ky * pc.DH;
      if (iy < 0 || iy >= pc.H) continue;
      for (int kx = 0; kx < pc.KW; ++kx) {
        int ix = ox * pc.SW - pc.PL + kx * pc.DW_;
        if (ix < 0 || ix >= pc.W) continue;
        acc += vec4(expb[sb + iy * pc.W + ix]) * vec4(dww[(eb * pc.KH + ky) * pc.KW + kx]);
      }
    }
    comm[eb * 4 + 0] = float(TO_STORE(vx_act(acc.x, pc.dwAct, 0.0, 6.0)));
    comm[eb * 4 + 1] = float(TO_STORE(vx_act(acc.y, pc.dwAct, 0.0, 6.0)));
    comm[eb * 4 + 2] = float(TO_STORE(vx_act(acc.z, pc.dwAct, 0.0, 6.0)));
    comm[eb * 4 + 3] = float(TO_STORE(vx_act(acc.w, pc.dwAct, 0.0, 6.0)));
  }
  barrier();

  // Phase B: 1x1 project for every output channel-block at this pixel.
  for (int ocb = tid; ocb < Coutb; ocb += 64) {
    vec4 acc = vec4(pwb[ocb]);
    int wbase = ocb * 4 * Eb;
    bool split = pc.pwKParts > 1;
    int chunk = split ? pc.pwChunk : Eb;
    for (int k = 0; k < max(pc.pwKParts, 1); ++k) {
      int e0 = k * chunk, e1 = min(e0 + chunk, Eb);
      vec4 part = split ? vec4(0.0) : acc;
      for (int eb = e0; eb < e1; ++eb) {
        vec4 d = vec4(comm[eb * 4], comm[eb * 4 + 1], comm[eb * 4 + 2], comm[eb * 4 + 3]);
        part.x += dot(d, vec4(pww[wbase + 0 * Eb + eb]));
        part.y += dot(d, vec4(pww[wbase + 1 * Eb + eb]));
        part.z += dot(d, vec4(pww[wbase + 2 * Eb + eb]));
        part.w += dot(d, vec4(pww[wbase + 3 * Eb + eb]));
      }
      acc = split ? acc + part : part;
    }
    int dbase = (n * Coutb + ocb) * OHW + pix;
    if (HAS_RES != 0) acc += vec4(res[dbase]);
    vec4 v = vec4(vx_act(acc.x, pc.pwAct, pc.pwLo, pc.pwHi),
                  vx_act(acc.y, pc.pwAct, pc.pwLo, pc.pwHi),
                  vx_act(acc.z, pc.pwAct, pc.pwLo, pc.pwHi),
                  vx_act(acc.w, pc.pwAct, pc.pwLo, pc.pwHi));
#ifdef PW_EPI
    v = pw_apply4(v, dbase);
#endif
    dst[dbase] = TO_STORE4(v);
  }
}
