#version 450
// VKNN_NO_RTE keeps the float-controls RTE execution mode out of this module: the driver compiles
// float arithmetic differently under it, splitting this VM's bytes from the standalone elementwise
// kernels (which are all VKNN_NO_RTE) on erf-class step chains. Stores stay exact — every stored
// value is already PW_ROUND-rounded.
#define VKNN_NO_RTE 1
#include "precision.glsl"
#define PW_EPI_BASE 2
// This kernel IS the pointwise unit, so it takes the full operand budget (kPwMaxOperands);
// the epilogue form inlined into producer kernels keeps the narrower default.
#define PW_OPERAND_SLOTS 9
#include "pw_epilogue.glsl"
layout(local_size_x=256, local_size_x_id=25) in; // spec 25 = device-resolved family width (0..24 carry the plan)
layout(std430,binding=0) readonly buffer Prim { STORE prim[]; };
layout(std430,binding=1) writeonly buffer Dst { STORE dst[]; };
layout(push_constant) uniform PC { int total, items; } pc;
// Monomorphization spec constants (host: fused_pointwise.cpp). PW_NS = 0 — the default, and the
// value an empty spec vector leaves in place — keeps the runtime interpreter (pw_apply). PW_NS in
// [1,8] compiles a specialized unit: the driver unrolls the step loop at pipeline creation and
// folds each step's kind/code/params to constants, leaving only the operand refs and broadcast
// geometry as uniform plan-SSBO reads. PW_K[s] packs (kind << 16) | (code & 0xffff); params arrive
// as float bits in the same 4-byte spec words. The rounding discipline is the shader variant's
// (-DPW_RELAX), same as the interpreter.
layout(constant_id=0) const int PW_NS = 0;
layout(constant_id=1) const uint PW_K0=0u; layout(constant_id=2) const uint PW_K1=0u;
layout(constant_id=3) const uint PW_K2=0u; layout(constant_id=4) const uint PW_K3=0u;
layout(constant_id=5) const uint PW_K4=0u; layout(constant_id=6) const uint PW_K5=0u;
layout(constant_id=7) const uint PW_K6=0u; layout(constant_id=8) const uint PW_K7=0u;
layout(constant_id=9)  const float PW_P0_0=0.; layout(constant_id=10) const float PW_P0_1=0.;
layout(constant_id=11) const float PW_P0_2=0.; layout(constant_id=12) const float PW_P0_3=0.;
layout(constant_id=13) const float PW_P0_4=0.; layout(constant_id=14) const float PW_P0_5=0.;
layout(constant_id=15) const float PW_P0_6=0.; layout(constant_id=16) const float PW_P0_7=0.;
layout(constant_id=17) const float PW_P1_0=0.; layout(constant_id=18) const float PW_P1_1=0.;
layout(constant_id=19) const float PW_P1_2=0.; layout(constant_id=20) const float PW_P1_3=0.;
layout(constant_id=21) const float PW_P1_4=0.; layout(constant_id=22) const float PW_P1_5=0.;
layout(constant_id=23) const float PW_P1_6=0.; layout(constant_id=24) const float PW_P1_7=0.;
// The fp32-chained discipline as a foldable constant (mirrors the interpreter variant compiled
// into this SPIR-V).
#ifdef PW_RELAX
#define PW_CHAINED 1
#else
#define PW_CHAINED 0
#endif
// Spec constants are not indexable as an array; each if-chain folds to one constant per unrolled
// iteration.
uint pwSpecK(int s){ if(s==0)return PW_K0; if(s==1)return PW_K1; if(s==2)return PW_K2; if(s==3)return PW_K3;
  if(s==4)return PW_K4; if(s==5)return PW_K5; if(s==6)return PW_K6; return PW_K7; }
float pwSpecP0(int s){ if(s==0)return PW_P0_0; if(s==1)return PW_P0_1; if(s==2)return PW_P0_2; if(s==3)return PW_P0_3;
  if(s==4)return PW_P0_4; if(s==5)return PW_P0_5; if(s==6)return PW_P0_6; return PW_P0_7; }
float pwSpecP1(int s){ if(s==0)return PW_P1_0; if(s==1)return PW_P1_1; if(s==2)return PW_P1_2; if(s==3)return PW_P1_3;
  if(s==4)return PW_P1_4; if(s==5)return PW_P1_5; if(s==6)return PW_P1_6; return PW_P1_7; }
// Specialized twin of the pw_apply interpreter: identical op order and rounding placement, with
// the per-step kind dispatch and params folded to constants. Strict rounds every compute step
// through PW_ROUND (a kind-4 load passes through unrounded in both disciplines); fp32-chained
// leaves steps unrounded and rounds once per stored stream (each export + the returned value).
float pw_apply_mono(float entryRaw, int outIdx){
  float entry=float(TO_STORE(entryRaw));
  float acc=entry; float r0=0.,r1=0.,r2=0.,r3=0.;
  for(int o=0;o<plan.numOuts;++o){ if(plan.outStep[o]==PW_REF_ENTRY) pwStoreOut(o,outIdx,entry); }
  for(int s=0;s<PW_NS;++s){
    int kind=int(pwSpecK(s)>>16), code=int(pwSpecK(s)&0xffffu);
    float p0=pwSpecP0(s), p1=pwSpecP1(s);
    int a=plan.step[s*PW_STEP_FIELDS+2],b=plan.step[s*PW_STEP_FIELDS+3],c=plan.step[s*PW_STEP_FIELDS+4];
    int dr=plan.step[s*PW_STEP_FIELDS+5],bc=plan.step[s*PW_STEP_FIELDS+6],bsrc=plan.step[s*PW_STEP_FIELDS+7];
    float va,vb=0.,vc=0.;
    if(a<=PW_REF_OP0)      va=pwLoad(PW_REF_OP0-a,pwFlatIdx(s,bsrc==1?bc:0,outIdx));
    else if(a==PW_REF_ACC) va=acc; else if(a==PW_REF_ENTRY) va=entry;
    else if(a==PW_REF_REG0) va=r0; else if(a==PW_REF_REG0-1) va=r1; else if(a==PW_REF_REG0-2) va=r2; else va=r3;
    if(b<=PW_REF_OP0)      vb=pwLoad(PW_REF_OP0-b,pwFlatIdx(s,bsrc==2?bc:0,outIdx));
    else if(b==PW_REF_ACC) vb=acc; else if(b==PW_REF_ENTRY) vb=entry;
    else if(b==PW_REF_REG0) vb=r0; else if(b==PW_REF_REG0-1) vb=r1; else if(b==PW_REF_REG0-2) vb=r2; else if(b==PW_REF_REG0-3) vb=r3;
    if(c<=PW_REF_OP0)      vc=pwLoad(PW_REF_OP0-c,pwFlatIdx(s,bsrc==3?bc:0,outIdx));
    else if(c==PW_REF_ACC) vc=acc; else if(c==PW_REF_ENTRY) vc=entry;
    else if(c==PW_REF_REG0) vc=r0; else if(c==PW_REF_REG0-1) vc=r1; else if(c==PW_REF_REG0-2) vc=r2; else if(c==PW_REF_REG0-3) vc=r3;
    float v;
    if(kind==PW_KIND_BINARY)      v=vx_binary(va,vb,code);
    else if(kind==PW_KIND_UNARY) v=vx_unary(va,code,p0,p1);
    else if(kind==PW_KIND_ACT) v=vx_act(va,code,p0,p1);
    else if(kind==PW_KIND_SELECT) v=va!=0.?vb:vc;
    else             v=va;
    acc=(kind==PW_KIND_LOAD||PW_CHAINED!=0)?v:PW_ROUND(v);
    if(dr==0)r0=acc; else if(dr==1)r1=acc; else if(dr==2)r2=acc; else if(dr==3)r3=acc;
    for(int o=0;o<plan.numOuts;++o){ if(plan.outStep[o]==s) pwStoreOut(o,outIdx,PW_CHAINED!=0?PW_ROUND(acc):acc); }
  }
  return PW_CHAINED!=0?PW_ROUND(acc):acc; }
// pc.items elements per lane, one slot apart -- the same reason as the NC4HW4 twin: the applier's
// runtime tracks its step count rather than its byte count, which is a chain waiting on memory
// latency, and independent items per lane are what covers it. Slots are strided by the lane count,
// so every item stays a coalesced wave-wide access.
void main(){ uint gid=gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*gl_NumWorkGroups.x*gl_WorkGroupSize.x;
  int slot=(pc.total+pc.items-1)/pc.items;
  if(gid>=uint(slot)) return;
  for(int k=0;k<pc.items;++k){
    int i=int(gid)+k*slot;
    if(i>=pc.total) break;
    float v=float(prim[i]);
    dst[i]=STORE(PW_NS>0?pw_apply_mono(v,i):pw_apply(v,i)); }}
