#version 450
#define VKNN_NO_RTE 1 // this kernel avoids the float-controls execution mode (miscompiled by some drivers); TO_STORE rounds explicitly
#include "precision.glsl"
#ifdef PW_EPI
#define PW_EPI_BASE 4
#include "pw_epilogue.glsl"
#endif
#include "common.glsl"
// Compile-time {128,128,16} twin of matmul_tiled.comp. The literal #defines make the register
// accumulator acc[8][8] and the LDS panels As/Bs[16][128] compile-time-sized, so the driver fully
// unrolls the inner K loop and keeps the micro-tile in registers instead of spilling — measurably
// faster on the target mobile driver than the spec-constant kernel at the identical geometry (ADR-0011:
// prefer compile-time shader variants over runtime-parameterized shaders). matmul.cpp dispatches
// this variant for the default tile (the Tuning::None geometry and the race's usual winner) and
// keeps matmul_tiled.comp only for a non-default tile the race picks. Byte-identical to
// matmul_tiled.comp at {128,128,16}: same ascending-k fp32 accumulation, same TO_STORE rounding.

#define TM 128
#define TN 128
#define TK 16
#define TILE 16        // threads per dim (16x16 = 256)
#define RM (TM / TILE) // 8 output rows per thread
#define RN (TN / TILE) // 8 output cols per thread

layout(local_size_x = TILE, local_size_y = TILE) in;
layout(std430, binding = 0) readonly buffer A { STORE a[]; };
layout(std430, binding = 1) readonly buffer B { STORE b[]; };
layout(std430, binding = 2) writeonly buffer D { STORE d[]; };
layout(std430, binding = 3) readonly buffer G { int g[]; } geom;
layout(push_constant) uniform PC {
  int rank, total, M, N, K, aK, bK;
} pc;

// LDS holds the staged panels in storage precision (fp16 when half) to halve LDS traffic, the GEMM's
// bottleneck; the math is still fp32 (each load is widened with float()).
shared STORE As[TK][TM]; // transposed (k-major) so the inner loop reads As[kk][m] across threads
shared STORE Bs[TK][TN];

void main() {
  int M = pc.M, N = pc.N, K = pc.K;
  // Batch base offsets: decompose the workgroup's batch index over the batch dims g[0..rank-3).
  int batch = int(gl_WorkGroupID.z);
  int aBase = 0, bBase = 0, rem = batch;
  for (int k = pc.rank - 3; k >= 0; --k) {
    int c = rem % geom.g[k];
    rem /= geom.g[k];
    aBase += c * geom.g[pc.rank + k];
    bBase += c * geom.g[2 * pc.rank + k];
  }
  int dBase = batch * M * N;

  int tileM = int(gl_WorkGroupID.y) * TM;
  int tileN = int(gl_WorkGroupID.x) * TN;
  int tx  = int(gl_LocalInvocationID.x);
  int ty  = int(gl_LocalInvocationID.y);
  int tid = ty * TILE + tx;

  float acc[RM][RN];
  for (int i = 0; i < RM; ++i)
    for (int j = 0; j < RN; ++j)
      acc[i][j] = 0.0;

  for (int k0 = 0; k0 < K; k0 += TK) {
    // Cooperative coalesced load of the A panel (transposed into As[k][m]) and the B panel.
    for (int t = 0; t < (TM * TK) / (TILE * TILE); ++t) {
      int idx = tid + t * (TILE * TILE); // 0 .. TM*TK-1, laid out as m*TK + k
      int m = idx / TK, k = idx % TK;
      int gm = tileM + m, gk = k0 + k;
      As[k][m] = (gm < M && gk < K) ? a[aBase + gm * K + gk] : STORE(0.0);
    }
    for (int t = 0; t < (TK * TN) / (TILE * TILE); ++t) {
      int idx = tid + t * (TILE * TILE); // 0 .. TK*TN-1, laid out as k*TN + n
      int k = idx / TN, n = idx % TN;
      int gk = k0 + k, gn = tileN + n;
      Bs[k][n] = (gk < K && gn < N) ? b[bBase + gk * N + gn] : STORE(0.0);
    }
    barrier();
    for (int kk = 0; kk < TK; ++kk) {
      float av[RM], bv[RN];
      for (int i = 0; i < RM; ++i)
        av[i] = float(As[kk][ty * RM + i]);
      for (int j = 0; j < RN; ++j)
        bv[j] = float(Bs[kk][tx * RN + j]);
      for (int i = 0; i < RM; ++i)
        for (int j = 0; j < RN; ++j)
          acc[i][j] += av[i] * bv[j];
    }
    barrier();
  }

  for (int i = 0; i < RM; ++i) {
    int m = tileM + ty * RM + i;
    if (m >= M) continue;
    for (int j = 0; j < RN; ++j) {
      int n = tileN + tx * RN + j;
      if (n >= N) continue;
      int idx = dBase + m * N + n;
#ifdef PW_EPI
      d[idx] = TO_STORE(pw_apply(acc[i][j], idx));
#else
      d[idx] = TO_STORE(acc[i][j]);
#endif
    }
  }
}
