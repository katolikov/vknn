#version 450
#define VKNN_NO_RTE 1 // avoids the float-controls execution mode (miscompiled on GEMM-shaped kernels); TO_STORE rounds explicitly
#include "precision.glsl"
#ifdef PW_EPI
#define PW_EPI_BASE 4
#include "pw_epilogue.glsl"
#endif
#include "common.glsl"
// Implicit-GEMM convolution: out[m, oc] = sum_k patch(m, k) * Wt[k, oc] with m = oy*OW + ox over one
// image and k = (ky*KW + kx)*C + ic over the receptive field. k is channel-fastest, so a 4-aligned
// k quad is one aligned NC4HW4 channel block of a single tap whenever it does not straddle a block
// boundary — the A panel then gathers whole blocks in one transaction instead of 4 scalar loads
// with 4 separate index decodes. The weights arrive repacked to row-major [K][Cout] in the same k
// order (lowerConv at convert time, or ConvOp's plan-time repack). The patch is gathered from the
// NC4HW4 input on the fly (no im2col buffer); both panels stage through LDS in storage precision so
// each global element is read once per tile, unlike the direct kernel's per-thread streaming.
// The K reduction runs in fp32 registers in a fixed chunked order (deterministic; the order differs
// from the direct kernel's, so the output is fp16-floor equivalent to Conv, not byte-identical).
// Dispatch: (ceil(Cout/TN), ceil(OH*OW/TM), N). Output is NC4HW4; each thread's RN=4 channels are
// one aligned channel block.

// M tile edge as a specialization constant: 16, 32, or 64 output pixels per workgroup (RM = TM/16
// pixels per thread). A small-M shape picks a narrow tile so the M axis still spreads across
// workgroups. TM is bit-neutral: it only remaps threads to outputs, never the per-output K order.
layout(constant_id = 0) const int TM = 64;
#include "conv_gemm_tiles.glsl"

// Whole-channel-block element type of the NC4HW4 source (the A panel's vectorized load unit).
#ifdef USE_FP16
#define STORE4 f16vec4
#else
#define STORE4 vec4
#endif

layout(local_size_x = TILE, local_size_y = TILE) in;
layout(std430, binding = 0) readonly buffer Src { STORE4 s[]; };  // NC4HW4 activations, one channel block per element
layout(std430, binding = 1) readonly buffer Wt { STORE w[]; };   // [K][Cout] repacked weights
layout(std430, binding = 2) readonly buffer Bs { STORE bias[]; };
layout(std430, binding = 3) writeonly buffer Dst { STORE d[]; }; // NC4HW4
layout(push_constant) uniform PC {
  int C, H, W, Cout, OH, OW, KH, KW, SH, SW, PT, PL, DH, DW_;
  int act, hasBias;
  float actLo, actHi;
} pc;

shared STORE As[TK][TM_MAX]; // transposed (k-major): the inner loop reads As[kk][m] across threads
shared STORE Ws[TK][TN];

void main() {
  int M = pc.OH * pc.OW;
  int K = pc.C * pc.KH * pc.KW;
  int Cinb = (pc.C + 3) / 4, Coutb = (pc.Cout + 3) / 4;
  int n = int(gl_WorkGroupID.z);
  int tileM = int(gl_WorkGroupID.y) * TM;
  int tileN = int(gl_WorkGroupID.x) * TN;
  int tx = int(gl_LocalInvocationID.x);
  int ty = int(gl_LocalInvocationID.y);
  int tid = ty * TILE + tx;

  float acc[TM_MAX / TILE][RN];
  for (int i = 0; i < RM; ++i)
    for (int j = 0; j < RN; ++j)
      acc[i][j] = 0.0;

  for (int k0 = 0; k0 < K; k0 += TK) {
    // A panel: gather TM patch rows for this K chunk from the NC4HW4 input (implicit im2col).
    // Each iteration owns one k quad (4 consecutive k) of one row m; TM * TK/4 quads cover the
    // panel. k0 is TK-aligned, so every quad is 4-aligned in k.
    for (int q = tid; q < TM * (TK / 4); q += TILE * TILE) {
      int m = q >> 2;
      int k = (q & 3) << 2;
      int gm = tileM + m, gk = k0 + k;
      int ic = (gk < K) ? gk % pc.C : 0;
      // Fast path: quad fully in range, all 4 k in one tap's aligned channel block. One block load
      // (or one zero splat for a padded pixel) replaces 4 scalar decodes + loads.
      if (gm < M && gk + 3 < K && (ic & 3) == 0 && ic + 3 < pc.C) {
        int p = gk / pc.C;
        int ky = p / pc.KW, kx = p - ky * pc.KW;
        int oy = gm / pc.OW, ox = gm - oy * pc.OW;
        int iy = oy * pc.SH - pc.PT + ky * pc.DH;
        int ix = ox * pc.SW - pc.PL + kx * pc.DW_;
        vec4 v = vec4(0.0);
        if (iy >= 0 && iy < pc.H && ix >= 0 && ix < pc.W)
          v = vec4(s[((n * Cinb + (ic >> 2)) * pc.H + iy) * pc.W + ix]);
        As[k + 0][m] = STORE(v.x);
        As[k + 1][m] = STORE(v.y);
        As[k + 2][m] = STORE(v.z);
        As[k + 3][m] = STORE(v.w);
      } else {
        // Edge quad (K tail, or a quad straddling a channel block when C % 4 != 0): per-element decode.
        for (int j = 0; j < 4; ++j) {
          int gkj = gk + j;
          float v = 0.0;
          if (gm < M && gkj < K) {
            int icj = gkj % pc.C, pj = gkj / pc.C;
            int ky = pj / pc.KW, kx = pj - ky * pc.KW;
            int oy = gm / pc.OW, ox = gm - oy * pc.OW;
            int iy = oy * pc.SH - pc.PT + ky * pc.DH;
            int ix = ox * pc.SW - pc.PL + kx * pc.DW_;
            if (iy >= 0 && iy < pc.H && ix >= 0 && ix < pc.W) {
              STORE4 blk = s[((n * Cinb + (icj >> 2)) * pc.H + iy) * pc.W + ix];
              v = float(blk[icj & 3]);
            }
          }
          As[k + j][m] = STORE(v);
        }
      }
    }
    // W panel: contiguous [K][Cout] rows.
    for (int t = 0; t < (TK * TN) / (TILE * TILE); ++t) {
      int idx = tid + t * (TILE * TILE); // laid out as k*TN + n
      int k = idx / TN, c = idx % TN;
      int gk = k0 + k, gc = tileN + c;
      Ws[k][c] = (gk < K && gc < pc.Cout) ? w[gk * pc.Cout + gc] : STORE(0.0);
    }
    barrier();
    for (int kk = 0; kk < TK; ++kk) {
      float av[TM_MAX / TILE], wv[RN];
      for (int i = 0; i < RM; ++i)
        av[i] = float(As[kk][ty * RM + i]);
      for (int j = 0; j < RN; ++j)
        wv[j] = float(Ws[kk][tx * RN + j]);
      for (int i = 0; i < RM; ++i)
        for (int j = 0; j < RN; ++j)
          acc[i][j] += av[i] * wv[j];
    }
    barrier();
  }

  // The thread's RN=4 channels are one aligned block: oc0 = tileN + tx*4, ocb = oc0/4. Lanes past
  // Cout are pad lanes and store 0 (the buffer pool reuses memory; a pad lane must never carry a
  // stale value).
  int oc0 = tileN + tx * RN;
  int ocb = oc0 >> 2;
  vec4 b4 = vec4(0.0);
  if (pc.hasBias != 0) {
    b4 = vec4(oc0 + 0 < pc.Cout ? float(bias[oc0 + 0]) : 0.0, oc0 + 1 < pc.Cout ? float(bias[oc0 + 1]) : 0.0,
              oc0 + 2 < pc.Cout ? float(bias[oc0 + 2]) : 0.0, oc0 + 3 < pc.Cout ? float(bias[oc0 + 3]) : 0.0);
  }
  for (int i = 0; i < RM; ++i) {
    int m = tileM + ty * RM + i;
    if (m >= M || ocb >= Coutb) continue;
    int oy = m / pc.OW, ox = m % pc.OW;
    vec4 v = vec4(acc[i][0], acc[i][1], acc[i][2], acc[i][3]) + b4;
    v = vec4(vx_act(v.x, pc.act, pc.actLo, pc.actHi), vx_act(v.y, pc.act, pc.actLo, pc.actHi),
             vx_act(v.z, pc.act, pc.actLo, pc.actHi), vx_act(v.w, pc.act, pc.actLo, pc.actHi));
    v = vec4(oc0 + 0 < pc.Cout ? v.x : 0.0, oc0 + 1 < pc.Cout ? v.y : 0.0,
             oc0 + 2 < pc.Cout ? v.z : 0.0, oc0 + 3 < pc.Cout ? v.w : 0.0);
    int di = ((n * Coutb + ocb) * pc.OH + oy) * pc.OW + ox;
#ifdef PW_EPI
    v = pw_apply4(v, di);
#endif
    d[(di << 2) + 0] = TO_STORE(v.x);
    d[(di << 2) + 1] = TO_STORE(v.y);
    d[(di << 2) + 2] = TO_STORE(v.z);
    d[(di << 2) + 3] = TO_STORE(v.w);
  }
}
