#version 450
#define VKNN_NO_RTE 1 // integer-valued store; round via vknnRte16 to match the elementwise-store convention
#include "precision.glsl"
// QuantizeLinear on the flat row-major buffer: y = saturate(roundEven(x / scale) + zero_point). The
// rounding is round-half-to-even (ONNX-specified; roundEven matches the CPU op's std::nearbyint under
// the default round-to-nearest-even mode), and the result saturates into the output integer type's
// range [qLo, qHi] (int8 [-128,127], uint8 [0,255], int32 effectively unbounded). The integer result
// is written as integer-valued fp32 (STORE is fp16 in the _fp16 variant). Per-tensor (sCount == 1) and
// per-axis (sCount > 1, channel by the flat index / inner stride) both apply; an absent zero_point is 0.
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer X { STORE x[]; };
layout(std430, binding = 1) readonly  buffer S { float scale[]; };  // scale + zero_point stay fp32
layout(std430, binding = 2) readonly  buffer Z { float zp[]; };
layout(std430, binding = 3) writeonly buffer Y { STORE y[]; };
// total: flat element count. sCount: scale element count (1 == per-tensor). zCount: zero_point element
// count (0 == absent). inner: per-axis stride. qLo/qHi: output-dtype saturation range.
layout(push_constant) uniform PC { int total, sCount, zCount, inner; float qLo, qHi; } pc;

void main() {
  uint g = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (g >= uint(pc.total)) return;
  int c = pc.sCount == 1 ? 0 : (int(g) / pc.inner) % pc.sCount;
  float z = pc.zCount == 0 ? 0.0 : zp[pc.zCount == 1 ? 0 : c];
  float q = roundEven(float(x[g]) / scale[c]) + z;
  q = clamp(q, pc.qLo, pc.qHi);
  y[g] = TO_STORE(q);
}
