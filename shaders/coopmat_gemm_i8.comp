#version 450
#define VKNN_NO_RTE 1 // gemm family avoids the float-controls execution mode (miscompiled by some drivers)
// Cooperative-matrix GEMM with int8 operands: D[M,N] = (A8[M,K] * B8[K,N]) * (sA * sB), int32
// accumulation, fp16 store. Opt-in via Hint::CoopmatGemm = Mode::Int8Coop - numerics intentionally
// differ from the fp16 kernels. A8 is the activation operand quantized on-device per dispatch
// (lowp_absmax + lowp_quant_i8, symmetric, scale = absmax / 127); B8 is the weight operand
// quantized on the host at prepare time. scales[0] = sA (device-written), scales[1] = sB
// (host-written). Tile geometry matches coopmat_gemm.comp.
#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
layout(local_size_x = 32) in;

layout(std430, binding = 0) readonly buffer ABuf { int8_t aBuf[]; };
layout(std430, binding = 1) readonly buffer BBuf { int8_t bBuf[]; };
layout(std430, binding = 2) writeonly buffer DBuf { float16_t dBuf[]; };
layout(std430, binding = 3) readonly buffer Scales { float scales[]; };
layout(push_constant) uniform PC { int M, N, K; }
pc;

void main() {
  const uint colTile = gl_WorkGroupID.x * 32u;
  const uint rowTile = gl_WorkGroupID.y * 32u;
  const uint lda = uint(pc.K);
  const uint ldb = uint(pc.N);

  coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc00 = coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
  coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc01 = coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
  coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc10 = coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
  coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc11 = coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);

  for (uint k = 0u; k < uint(pc.K); k += 16u) {
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a0, a1;
    coopMatLoad(a0, aBuf, rowTile * lda + k, lda, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(a1, aBuf, (rowTile + 16u) * lda + k, lda, gl_CooperativeMatrixLayoutRowMajor);
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b0, b1;
    coopMatLoad(b0, bBuf, k * ldb + colTile, ldb, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(b1, bBuf, k * ldb + colTile + 16u, ldb, gl_CooperativeMatrixLayoutRowMajor);
    acc00 = coopMatMulAdd(a0, b0, acc00);
    acc01 = coopMatMulAdd(a0, b1, acc01);
    acc10 = coopMatMulAdd(a1, b0, acc10);
    acc11 = coopMatMulAdd(a1, b1, acc11);
  }

  const float dequant = scales[0] * scales[1];
  const uint ldd = uint(pc.N);
  coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> f;
  coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> h;
  f = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc00) * dequant;
  h = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(f);
  coopMatStore(h, dBuf, rowTile * ldd + colTile, ldd, gl_CooperativeMatrixLayoutRowMajor);
  f = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc01) * dequant;
  h = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(f);
  coopMatStore(h, dBuf, rowTile * ldd + colTile + 16u, ldd, gl_CooperativeMatrixLayoutRowMajor);
  f = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc10) * dequant;
  h = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(f);
  coopMatStore(h, dBuf, (rowTile + 16u) * ldd + colTile, ldd, gl_CooperativeMatrixLayoutRowMajor);
  f = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc11) * dequant;
  h = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(f);
  coopMatStore(h, dBuf, (rowTile + 16u) * ldd + colTile + 16u, ldd, gl_CooperativeMatrixLayoutRowMajor);
}
