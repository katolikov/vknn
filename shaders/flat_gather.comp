#version 450
#include "precision.glsl"
// Flat row-major gather: out[i] = in[base + sum_k outCoord_k * inStride_k]. Drives Transpose
// (inStride = permuted input strides) and Slice (base = start offset, inStride = step*inputStride).
// A fused pointwise chain (fusePointwiseChains folding a Transpose/Slice's consumers into its store)
// is applied at the store in the _epi variant — one dispatch, and the intermediate never materializes.
// Geometry (outDim/inStride) rides a content-deduped SSBO (binding 2), not the push constant, so the
// decodable rank is unbounded (see flat::uploadFlatGeom). Arrays pack back-to-back:
// outDim = g[0..rank), inStride = g[rank..2*rank). The fused epilogue's bindings start after it.
#include "common.glsl"
#ifdef PW_EPI
#define PW_EPI_BASE 3
#include "pw_epilogue.glsl"
#endif
layout(local_size_x = 256, local_size_x_id = 0) in; // spec 0 = device-resolved family width
layout(std430, binding = 0) readonly  buffer S { STORE s[]; };
layout(std430, binding = 1) writeonly buffer D { STORE d[]; };
layout(std430, binding = 2) readonly  buffer G { int g[]; } geom;
// pc.outPad is the output buffer's PHYSICAL last-axis extent and pc.outLast its logical one, both
// zero unless the segment allocated this output as a virtualized activation at roundUpVec4(last) so
// its consuming tiled MatMul can take the vec4-load kernels (core/matmul_tile.h). The grid then
// covers the PHYSICAL element count: a lane whose column falls in the pad stores zero, and every
// other lane keeps the logical flat index — so the fused epilogue still indexes the flat row-major
// output world it was planned against, and only the destination address moves. The pad is rewritten
// every run because the liveness pool hands the same buffer to different tensors between runs.
layout(push_constant) uniform PC { int rank, total, base, outPad, outLast; } pc;

// ITEMS elements per lane, one slot apart (the fused_pw walk): independent items cover the
// per-element div/mod chain's memory latency; slots stride by the lane count so every item stays
// a coalesced wave-wide access. ITEMS is a specialization constant (the host resolves it per node
// at load, same rule as before), so the common single-item pipeline compiles the straight-line
// body below with no loop or slot division — the runtime-bound loop was measured to cost the
// driver its div/mod-chain optimization even at one item. The workgroup width is spec constant 0,
// resolved by the host at load from device caps (env.flatLocalSize).
layout(constant_id = 1) const int ITEMS = 1;
void processOne(uint gid) {
    int outIdx = int(gid), dstIdx = int(gid);
    if (pc.outPad > 0) {
      int row = int(gid) / pc.outPad, col = int(gid) % pc.outPad;
      if (col >= pc.outLast) { d[dstIdx] = STORE(0.0); return; }
      outIdx = row * pc.outLast + col;
    }
    int rem = outIdx, inIdx = pc.base;
    for (int k = pc.rank - 1; k >= 0; --k) {
      int c = rem % geom.g[k];
      rem /= geom.g[k];
      inIdx += c * geom.g[pc.rank + k];
    }
  #ifdef PW_EPI
    d[dstIdx] = STORE(pw_apply(float(s[inIdx]), outIdx));
  #else
    d[dstIdx] = s[inIdx];
  #endif
}

void main() {
  uint lane = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (ITEMS == 1) {
    if (lane >= uint(pc.total)) return;
    processOne(lane);
    return;
  }
  uint slot = (uint(pc.total) + uint(ITEMS) - 1u) / uint(ITEMS);
  if (lane >= slot) return;
  for (int it = 0; it < ITEMS; ++it) {
    uint gid = lane + uint(it) * slot;
    if (gid >= uint(pc.total)) break;
    processOne(gid);
  }
}
