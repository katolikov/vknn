#version 450
// In-place global exclusive scan over a uint array, shared by two rasterizer stages:
//  - radix sort (writeTotal 0): scans the digit-major histogram raster_radix_count wrote, turning
//    histogram[digit * numGroups + group] into the global scatter base for that pair.
//  - tile binning (writeTotal 1): scans the per-gaussian tile-entry counts into per-gaussian emit
//    offsets and writes the grand total (the exact tile-entry count) to total[0], where the sort
//    passes and the host read it.
// One workgroup walks the array in 256-element tiles, scans each tile in shared memory
// (Hillis-Steele), and carries the running sum across tiles. Single-workgroup and sequential
// across tiles: fully deterministic, and fast enough for both arrays (256 bins per 4096-entry
// chunk, one count per gaussian).
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Data { uint data[]; };   // [totalBins], scanned in place
layout(std430, binding = 1) writeonly buffer Total { uint total[]; }; // [1] (writeTotal 1)
layout(push_constant) uniform PC {
  uint totalBins;  // element count
  uint writeTotal; // 1 = write the grand total to total[0]
} pc;

shared uint tileValues[256];
shared uint carryTotal;

void main() {
  uint lane = gl_LocalInvocationID.x;
  if (lane == 0u) carryTotal = 0u;
  barrier();
  uint tiles = (pc.totalBins + 255u) / 256u;
  for (uint tile = 0u; tile < tiles; ++tile) {
    uint index = tile * 256u + lane;
    uint value = index < pc.totalBins ? data[index] : 0u;
    tileValues[lane] = value;
    barrier();
    for (uint offset = 1u; offset < 256u; offset <<= 1u) { // inclusive Hillis-Steele scan
      uint addend = lane >= offset ? tileValues[lane - offset] : 0u;
      barrier();
      tileValues[lane] += addend;
      barrier();
    }
    uint inclusive = tileValues[lane];
    if (index < pc.totalBins) data[index] = inclusive - value + carryTotal;
    barrier();
    if (lane == 255u) carryTotal += inclusive; // lane 255's inclusive sum = the tile total
    barrier();
  }
  if (pc.writeTotal == 1u && lane == 0u) total[0] = carryTotal;
}
