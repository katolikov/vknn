#version 450
#include "precision.glsl"
// Flat broadcasting GreaterOrEqual (out = (a >= b) ? 1 : 0).
// Geometry (outDim/aStride/bStride) rides a content-deduped SSBO (binding 3), not the push constant,
// so the decodable rank is unbounded (see flat::uploadFlatGeom). Arrays pack back-to-back:
// outDim = g[0..rank), aStride = g[rank..2*rank), bStride = g[2*rank..3*rank).
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer A { STORE a[]; };
layout(std430, binding = 1) readonly  buffer B { STORE b[]; };
layout(std430, binding = 2) writeonly buffer D { STORE d[]; };
layout(std430, binding = 3) readonly  buffer G { int g[]; } geom;
layout(push_constant) uniform PC { int rank, total; } pc;

void main() {
  uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (gid >= uint(pc.total)) return;
  int rem = int(gid), ai = 0, bi = 0;
  for (int k = pc.rank - 1; k >= 0; --k) {
    int c = rem % geom.g[k];
    rem /= geom.g[k];
    ai += c * geom.g[pc.rank + k];
    bi += c * geom.g[2 * pc.rank + k];
  }
  d[gid] = STORE((float(a[ai]) >= float(b[bi])) ? 1.0 : 0.0);
}
