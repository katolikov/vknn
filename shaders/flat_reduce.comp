#version 450
#include "precision.glsl"
#ifdef PW_EPI
#define PW_EPI_BASE 3
#include "pw_epilogue.glsl"
#endif
// Flat row-major reduce. Geometry (inDim/inStride/reduce) rides a content-deduped SSBO (binding 2),
// not the push constant, so the decodable rank is unbounded (see flat::uploadFlatGeom). Arrays pack
// back-to-back: inDim = g[0..rank), inStride = g[rank..2*rank), reduce = g[2*rank..3*rank). The fused
// epilogue's bindings start after it.
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer S { STORE s[]; };
layout(std430, binding = 1) writeonly buffer D { STORE d[]; };
layout(std430, binding = 2) readonly  buffer G { int g[]; } geom;
layout(push_constant) uniform PC {
  int rank, total, op;
} pc;

void main() {
  uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (gid >= uint(pc.total)) return;

  int rem = int(gid);
  int base = 0;
  for (int k = pc.rank - 1; k >= 0; --k) {
    if (geom.g[2 * pc.rank + k] != 0) continue;
    int c = rem % geom.g[k];
    rem /= geom.g[k];
    base += c * geom.g[pc.rank + k];
  }

  int rcount = 1, nRed = 0, singleStride = 0;
  for (int k = 0; k < pc.rank; ++k) if (geom.g[2 * pc.rank + k] != 0) { rcount *= geom.g[k]; nRed++; singleStride = geom.g[pc.rank + k]; }

  float acc = (pc.op == 2) ? -3.4e38 : (pc.op == 3) ? 3.4e38 : (pc.op == 4) ? 1.0 : 0.0;
  // Fast path for a single reduced axis (the common global-min/max/sum-over-one-axis case): the reduced
  // element offset is base + r*stride, so the per-element multi-dim index recompute below is unneeded.
  // Same iteration order as the general path, so byte-identical for every op.
  if (nRed == 1) {
    for (int r = 0; r < rcount; ++r) {
      float v = float(s[base + r * singleStride]);
      if (pc.op == 2) acc = max(acc, v);
      else if (pc.op == 3) acc = min(acc, v);
      else if (pc.op == 4) acc *= v;
      else if (pc.op == 5) acc += v * v;
      else acc += v;
    }
  } else
  for (int r = 0; r < rcount; ++r) {
    int rr = r, off = base;
    for (int k = pc.rank - 1; k >= 0; --k) {
      if (geom.g[2 * pc.rank + k] == 0) continue;
      int c = rr % geom.g[k];
      rr /= geom.g[k];
      off += c * geom.g[pc.rank + k];
    }
    float v = float(s[off]);
    if (pc.op == 2) acc = max(acc, v);
    else if (pc.op == 3) acc = min(acc, v);
    else if (pc.op == 4) acc *= v;
    else if (pc.op == 5) acc += v * v;
    else acc += v;
  }
  if (pc.op == 0 && rcount > 0) acc /= float(rcount);
  else if (pc.op == 5) acc = sqrt(acc);
#ifdef PW_EPI
  acc = pw_apply(acc, int(gid));
#endif
  d[gid] = TO_STORE(acc); // saturating: a Sum/Prod reduction of in-range values can exceed the fp16 range
}
