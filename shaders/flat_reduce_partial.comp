#version 450
#include "precision.glsl"
// Pass 1 of the cooperative flat reduce (see reduce.cpp). Splits each output's reduced extent into
// `groups` contiguous chunks and assigns one workgroup per (output, chunk): its 256 lanes stride the
// chunk and tree-reduce a partial into the fp32 scratch buffer at scratch[outIdx*groups + chunk]. Pass 2
// (flat_reduce_combine) folds the `groups` partials per output and finalises. Many workgroups per
// output fill the GPU for the pathological small-output / huge-reduced-extent case that the scalar
// flat_reduce.comp serialises on a single lane. Geometry SSBO layout matches flat_reduce.comp:
// inDim[0..rank), inStride[rank..2*rank), reduce[2*rank..3*rank). Partials are raw (no mean-divide /
// L2-sqrt): Mean stores the sum, L2 stores the sum of squares; the combine pass finalises.
#include "common.glsl"
layout(local_size_x = 256, local_size_x_id = 0) in; // spec = device-resolved width (pow2 for the tree fold)
layout(std430, binding = 0) readonly  buffer S { STORE s[]; };
layout(std430, binding = 1) writeonly buffer P { float part[]; };
layout(std430, binding = 2) readonly  buffer G { int g[]; } geom;
layout(push_constant) uniform PC {
  int rank, total, op, groups;
} pc;

// Reduce wire codes carried in pc.op (kept in sync with vknn::ReduceType, include/vknn/reduce_type.h).
#define REDUCE_MEAN 0
#define REDUCE_SUM  1
#define REDUCE_MAX  2
#define REDUCE_MIN  3
#define REDUCE_PROD 4
#define REDUCE_L2   5

#define WG_MAX 256 // shared-array ceiling: must be >= the spec-0 width; the host guarantees
                   // flatLocalSize = min(256, caps), pow2-clamped for the tree fold (vk_op_env.h)
shared float red[WG_MAX];

void main() {
  // One workgroup per (output, chunk). The linear id folds a y-spill (ComputePipeline::dispatch).
  uint wg  = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
  uint outIdx = wg / uint(pc.groups);
  uint gi  = wg % uint(pc.groups);
  if (outIdx >= uint(pc.total)) return;

  // Kept-axes base offset for this output (identical to flat_reduce.comp).
  int rem = int(outIdx);
  int base = 0;
  for (int k = pc.rank - 1; k >= 0; --k) {
    if (geom.g[2 * pc.rank + k] != 0) continue;
    int c = rem % geom.g[k];
    rem /= geom.g[k];
    base += c * geom.g[pc.rank + k];
  }

  int rcount = 1, nRed = 0, singleStride = 0;
  for (int k = 0; k < pc.rank; ++k) if (geom.g[2 * pc.rank + k] != 0) { rcount *= geom.g[k]; nRed++; singleStride = geom.g[pc.rank + k]; }

  // This workgroup owns the reduced-index chunk [start, end).
  int chunk = (rcount + pc.groups - 1) / pc.groups;
  int start = int(gi) * chunk;
  int end   = min(start + chunk, rcount);

  uint t = gl_LocalInvocationID.x;
  float acc = (pc.op == REDUCE_MAX) ? VX_NEG_INF : (pc.op == REDUCE_MIN) ? VX_POS_INF : (pc.op == REDUCE_PROD) ? 1.0 : 0.0;
  if (nRed == 1) {
    for (int r = start + int(t); r < end; r += int(gl_WorkGroupSize.x)) {
      float v = float(s[base + r * singleStride]);
      if (pc.op == REDUCE_MAX) acc = max(acc, v);
      else if (pc.op == REDUCE_MIN) acc = min(acc, v);
      else if (pc.op == REDUCE_PROD) acc *= v;
      else if (pc.op == REDUCE_L2) acc += v * v;
      else acc += v; // REDUCE_SUM / REDUCE_MEAN
    }
  } else {
    for (int r = start + int(t); r < end; r += int(gl_WorkGroupSize.x)) {
      int rr = r, off = base;
      for (int k = pc.rank - 1; k >= 0; --k) {
        if (geom.g[2 * pc.rank + k] == 0) continue;
        int c = rr % geom.g[k];
        rr /= geom.g[k];
        off += c * geom.g[pc.rank + k];
      }
      float v = float(s[off]);
      if (pc.op == REDUCE_MAX) acc = max(acc, v);
      else if (pc.op == REDUCE_MIN) acc = min(acc, v);
      else if (pc.op == REDUCE_PROD) acc *= v;
      else if (pc.op == REDUCE_L2) acc += v * v;
      else acc += v; // REDUCE_SUM / REDUCE_MEAN
    }
  }

  red[t] = acc;
  barrier();
  for (uint stride = gl_WorkGroupSize.x / 2u; stride > 0u; stride >>= 1) {
    if (t < stride) {
      float a = red[t], b = red[t + stride];
      red[t] = (pc.op == REDUCE_MAX) ? max(a, b) : (pc.op == REDUCE_MIN) ? min(a, b) : (pc.op == REDUCE_PROD) ? a * b : a + b;
    }
    barrier();
  }
  if (t == 0u) part[wg] = red[0];   // scratch[outIdx*groups + gi]
}
