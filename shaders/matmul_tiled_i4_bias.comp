#version 450
#define VKNN_NO_RTE 1 // this kernel avoids the float-controls execution mode (miscompiled by some drivers); TO_STORE rounds explicitly
#include "precision.glsl"
#ifdef PW_EPI
#define PW_EPI_BASE 7
#include "pw_epilogue.glsl"
#endif
#include "common.glsl"
// matmul_tiled_i4.comp with a fused rank-1 [N] bias at binding 6 (WQ_BIAS in the shared head/core),
// added once per output in the store loop (after the packed and outlier accumulation). Structure,
// weight addressing, and the block-granular B staging are documented in the head/core includes.
#define WQ_BIAS 1
#include "matmul_tiled_wq_head.glsl"

// Sign-extended int4 at word `w`, lane `slot` (0..7).
float nib(uint w, int slot) {
  return float(bitfieldExtract(int(w), slot * 4, 4));
}

#define WQ_WORD_T uint
#define WQ_ZERO 0u
#define WQ_LOAD_W(idx) bp[idx]
#define WQ_DEC(w, s) nib(w, s)
#define WQ_BLOCK_COL(n) ((n) >> 3) // one word per 8-column block

#include "matmul_tiled_wq_core.glsl"
