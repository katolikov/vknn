#version 450
#define VKNN_NO_RTE 1 // this kernel avoids the float-controls execution mode (miscompiled by some drivers); TO_STORE rounds explicitly
#include "precision.glsl"
#ifdef PW_EPI
#define PW_EPI_BASE 7
#include "pw_epilogue.glsl"
#endif
#include "common.glsl"
// matmul_tiled_i4.comp with a fused rank-1 [N] bias at binding 6, added once per output in the
// store loop (after the packed and outlier accumulation). Structure and weight addressing are
// documented in matmul_tiled_i4.comp.

#define TM 128
#define TN 128
#define TK 16
#define TILE 16        // threads per dim (16x16 = 256)
#define RM (TM / TILE) // 8 output rows per thread
#define RN (TN / TILE) // 8 output cols per thread

layout(local_size_x = TILE, local_size_y = TILE) in;
layout(std430, binding = 0) readonly  buffer A  { STORE a[]; };
layout(std430, binding = 1) readonly  buffer BP { uint bp[]; };
layout(std430, binding = 2) writeonly buffer D  { STORE d[]; };
layout(std430, binding = 3) readonly  buffer SC { STORE sc[]; };
layout(std430, binding = 4) readonly  buffer OI { int oi[]; };
layout(std430, binding = 5) readonly  buffer OV { STORE ov[]; };
layout(std430, binding = 6) readonly  buffer BS { STORE bias[]; };
layout(push_constant) uniform PC {
  int total, M, N, K, group, nOut, rowWords, nGroups;
} pc;

shared STORE As[TK][TM];
shared STORE Bs[TK][TN];

float nib(uint w, int slot) {
  return float(bitfieldExtract(int(w), slot * 4, 4));
}

void main() {
  int M = pc.M, N = pc.N, K = pc.K;
  int batch = int(gl_WorkGroupID.z); // dense batch: B is shared, A/D step by whole matrices
  int aBase = batch * M * K;
  int dBase = batch * M * N;

  int tileM = int(gl_WorkGroupID.y) * TM;
  int tileN = int(gl_WorkGroupID.x) * TN;
  int tx  = int(gl_LocalInvocationID.x);
  int ty  = int(gl_LocalInvocationID.y);
  int tid = ty * TILE + tx;

  float acc[RM][RN];
  for (int i = 0; i < RM; ++i)
    for (int j = 0; j < RN; ++j)
      acc[i][j] = 0.0;

  for (int k0 = 0; k0 < K; k0 += TK) {
    for (int t = 0; t < (TM * TK) / (TILE * TILE); ++t) {
      int idx = tid + t * (TILE * TILE); // 0 .. TM*TK-1, laid out as m*TK + k
      int m = idx / TK, k = idx % TK;
      int gm = tileM + m, gk = k0 + k;
      As[k][m] = (gm < M && gk < K) ? a[aBase + gm * K + gk] : STORE(0.0);
    }
    for (int t = 0; t < (TK * TN) / (TILE * TILE); ++t) {
      int idx = tid + t * (TILE * TILE); // 0 .. TK*TN-1, laid out as k*TN + n
      int k = idx / TN, n = idx % TN;
      int gk = k0 + k, gn = tileN + n;
      if (gk < K && gn < N) {
        uint  w = bp[gk * pc.rowWords + gn / 8];
        float s = float(sc[(gk / pc.group) * N + gn]);
        Bs[k][n] = STORE(nib(w, gn % 8) * s);
      } else {
        Bs[k][n] = STORE(0.0);
      }
    }
    barrier();
    for (int kk = 0; kk < TK; ++kk) {
      float av[RM], bv[RN];
      for (int i = 0; i < RM; ++i)
        av[i] = float(As[kk][ty * RM + i]);
      for (int j = 0; j < RN; ++j)
        bv[j] = float(Bs[kk][tx * RN + j]);
      for (int i = 0; i < RM; ++i)
        for (int j = 0; j < RN; ++j)
          acc[i][j] += av[i] * bv[j];
    }
    barrier();
  }

  for (int j0 = 0; j0 < pc.nOut; j0 += TK) {
    for (int t = 0; t < (TM * TK) / (TILE * TILE); ++t) {
      int idx = tid + t * (TILE * TILE);
      int m = idx / TK, k = idx % TK;
      int gm = tileM + m, gj = j0 + k;
      As[k][m] = (gm < M && gj < pc.nOut) ? a[aBase + gm * K + oi[gj]] : STORE(0.0);
    }
    for (int t = 0; t < (TK * TN) / (TILE * TILE); ++t) {
      int idx = tid + t * (TILE * TILE);
      int k = idx / TN, n = idx % TN;
      int gj = j0 + k, gn = tileN + n;
      Bs[k][n] = (gj < pc.nOut && gn < N) ? ov[gj * N + gn] : STORE(0.0);
    }
    barrier();
    for (int kk = 0; kk < TK; ++kk) {
      float av[RM], bv[RN];
      for (int i = 0; i < RM; ++i)
        av[i] = float(As[kk][ty * RM + i]);
      for (int j = 0; j < RN; ++j)
        bv[j] = float(Bs[kk][tx * RN + j]);
      for (int i = 0; i < RM; ++i)
        for (int j = 0; j < RN; ++j)
          acc[i][j] += av[i] * bv[j];
    }
    barrier();
  }

  for (int i = 0; i < RM; ++i) {
    int m = tileM + ty * RM + i;
    if (m >= M) continue;
    for (int j = 0; j < RN; ++j) {
      int n = tileN + tx * RN + j;
      if (n >= N) continue;
      int idx = dBase + m * N + n;
      float v = acc[i][j] + float(bias[n]);
#ifdef PW_EPI
      d[idx] = TO_STORE(pw_apply(v, idx));
#else
      d[idx] = TO_STORE(v);
#endif
    }
  }
}
