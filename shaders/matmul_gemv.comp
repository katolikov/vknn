#version 450
#define VKNN_NO_RTE 1 // this kernel avoids the float-controls execution mode (miscompiled by some drivers); TO_STORE rounds explicitly
#include "precision.glsl"
#ifdef PW_EPI
#define PW_EPI_BASE 4
#include "pw_epilogue.glsl"
#endif
// Split-K batched mat-vec: out[...,n] = sum_k A[...,k]*B[...,k,n] for a single output row (M == 1).
// matmul.comp gives each output element one thread, so a mat-vec launches only N threads and leaves
// the GPU idle whenever N is small — its time then scales with K at fixed occupancy (a K=4864,N=896
// projection runs 5x longer than the K=896,N=896 one at the same bytes/second). Here GEMV_KS threads
// share each output: lane ky sums the k == ky (mod GEMV_KS) terms into an fp32 partial, and the
// partials reduce through shared memory in ascending lane order (a fixed order, so the result is
// deterministic; the k chain is regrouped, so it is NOT bit-identical to matmul.comp).
//
// Thread (x, ky) owns output gid = wg*GEMV_NX + x, so the GEMV_NX lanes of a row read B contiguously
// along n (bStride[nAxis] == 1) and keep the coalesced access matmul.comp has. Geometry rides the
// same content-deduped SSBO (binding 3) as matmul.comp: outDim = g[0..rank), aStride = g[rank..2*rank),
// bStride = g[2*rank..3*rank).
//
// The kernel is DRAM-latency bound, not ALU bound: it streams K*N halves of B and does one FMA per
// half. Its achieved bandwidth is (bytes a wave keeps in flight) * (waves) / (DRAM latency), so the
// k loop is unrolled GEMV_U-wide with all GEMV_U loads issued ahead of the FMA chain.
// shaders/matmul_gemv4.comp keeps the same k partition and per-output accumulation order and instead
// gives each lane GEMV_VEC adjacent n, trading waves for load width; both kernels produce identical
// bits and matmul.cpp picks between them on N's divisibility.
#include "common.glsl"
#define GEMV_NX 64 // lanes along n: one coalesced 128-byte fp16 burst of B per row
#define GEMV_KS 16 // lanes reducing over k; GEMV_NX * GEMV_KS == 1024 == maxComputeWorkGroupInvocations
#define GEMV_U 4   // k steps a lane loads before it consumes any of them (memory-level parallelism)
layout(local_size_x = GEMV_NX, local_size_y = GEMV_KS) in;
layout(std430, binding = 0) readonly  buffer A { STORE a[]; };
layout(std430, binding = 1) readonly  buffer B { STORE b[]; };
layout(std430, binding = 2) writeonly buffer D { STORE d[]; };
layout(std430, binding = 3) readonly buffer G { int g[]; } geom;
layout(push_constant) uniform PC {
  int rank, total, M, N, K, aK, bK;
} pc;

shared float part[GEMV_KS][GEMV_NX];

void main() {
  // The 1-D output grid is spilled into y when it overflows maxWorkGroupCount[0]; local y is the
  // k-split, so the workgroup id — not gl_GlobalInvocationID.y — carries the overflow.
  uint gid = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * GEMV_NX + gl_LocalInvocationID.x;
  uint ky  = gl_LocalInvocationID.y;
  bool live = gid < uint(pc.total);

  int aBase = 0, bBase = 0;
  if (live) {
    int rem = int(gid);
    for (int k = pc.rank - 1; k >= 0; --k) {
      int c = rem % geom.g[k];
      rem /= geom.g[k];
      aBase += c * geom.g[pc.rank + k];
      bBase += c * geom.g[2 * pc.rank + k];
    }
  }

  // GEMV_U k steps load into registers before the accumulator consumes any of them, so every wave
  // holds GEMV_U B requests in flight rather than one. B is the streamed operand (K*N elements
  // against A's K), so in-flight B bytes are what bound this kernel's achieved bandwidth. The
  // accumulator still walks k in ascending order, term by term. The four steps are spelled out
  // rather than looped over a register array: an array indexed by a loop variable lands in scratch
  // memory unless the driver unrolls it.
  float acc = 0.0;
  if (live) {
    int k = int(ky);
    for (; k + (GEMV_U - 1) * GEMV_KS < pc.K; k += GEMV_U * GEMV_KS) {
      float a0 = float(a[aBase + k * pc.aK]);
      float a1 = float(a[aBase + (k + GEMV_KS) * pc.aK]);
      float a2 = float(a[aBase + (k + 2 * GEMV_KS) * pc.aK]);
      float a3 = float(a[aBase + (k + 3 * GEMV_KS) * pc.aK]);
      float b0 = float(b[bBase + k * pc.bK]);
      float b1 = float(b[bBase + (k + GEMV_KS) * pc.bK]);
      float b2 = float(b[bBase + (k + 2 * GEMV_KS) * pc.bK]);
      float b3 = float(b[bBase + (k + 3 * GEMV_KS) * pc.bK]);
      acc += a0 * b0;
      acc += a1 * b1;
      acc += a2 * b2;
      acc += a3 * b3;
    }
    for (; k < pc.K; k += GEMV_KS)
      acc += float(a[aBase + k * pc.aK]) * float(b[bBase + k * pc.bK]);
  }
  // Every invocation stores (dead lanes store 0) so barrier() stays in uniform control flow.
  part[ky][gl_LocalInvocationID.x] = acc;
  barrier();
  if (ky != 0 || !live) return;

  float s = 0.0;
  for (int i = 0; i < GEMV_KS; ++i)
    s += part[i][gl_LocalInvocationID.x];
#ifdef PW_EPI
  d[gid] = TO_STORE(pw_apply(s, int(gid)));
#else
  d[gid] = TO_STORE(s);
#endif
}
