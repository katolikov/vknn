#version 450
#include "precision.glsl"
// Flat elementwise boolean NOT (out = (x != 0) ? 0 : 1), the operand read by logicalIsTrue. A pure 1:1
// map over the packed buffer with no broadcasting, so it needs no geometry SSBO: one invocation per
// element, bounds-checked on the tail.
#include "common.glsl"
#include "logical_truth.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer Operand { STORE operand[]; };
layout(std430, binding = 1) writeonly buffer Result { STORE result[]; };
layout(push_constant) uniform PC { int total; } pc;

void main() {
  uint elementIndex = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (elementIndex >= uint(pc.total)) return;
  result[elementIndex] = STORE(logicalIsTrue(float(operand[elementIndex])) ? kLogicalFalse : kLogicalTrue);
}
