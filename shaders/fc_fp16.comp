#version 450
#define VKNN_NO_RTE 1 // this kernel avoids the float-controls execution mode (miscompiled by some drivers); TO_STORE rounds explicitly
// Fully-connected / Gemm, fp16. Input is NC4HW4 with H=W=1 (so the packed buffer is just the
// channel vector). f16vec4 loads over the contraction, fp32 accumulate.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"
#ifdef PW_EPI
#define STORE float16_t
#define PW_EPI_BASE 4
#include "pw_epilogue.glsl"
#endif
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Src { f16vec4 src[]; };
layout(std430, binding = 1) readonly buffer Wt { f16vec4 wt[]; };
layout(std430, binding = 2) readonly buffer Bs { float16_t bias[]; };
layout(std430, binding = 3) writeonly buffer Dst { float16_t dst[]; };
layout(push_constant) uniform PC {
  int Cin, Cout, M, srcStride, dstStride, act;
  float actLo, actHi;
}
pc;

void main() {
  uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (gid >= uint(pc.M) * uint(pc.Cout)) return;
  uint m = gid / uint(pc.Cout);
  uint oc = gid % uint(pc.Cout);
  int cb = (pc.Cin + 3) / 4;                  // contraction length in f16vec4 units
  uint wrow = oc * uint(cb);
  uint srow = m * uint(pc.srcStride) / 4u;    // srcStride is in float elems; src is f16vec4
  vec4 acc = vec4(0.0);
  for (int j = 0; j < cb; ++j) acc += vec4(src[srow + uint(j)]) * vec4(wt[wrow + uint(j)]);
  float r = acc.x + acc.y + acc.z + acc.w + float(bias[oc]);
  float v = vx_act(r, pc.act, pc.actLo, pc.actHi);
#ifdef PW_EPI
  int di = int(m * uint(pc.dstStride) + oc);
  v = (plan.worldFlat != 0) ? pw_apply(float(TO_STORE(v)), di) : pw_apply_nc4(float(TO_STORE(v)), di);
#endif
  dst[m * uint(pc.dstStride) + oc] = TO_STORE(v);
}
