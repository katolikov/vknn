#version 450
// Resize (spatial) over NC4HW4 (fp16). nearest + bilinear + cubic; the mode/coord codes, the
// integer nearest index and the cubic weight fan are the rules in src/core/resize_rule.h,
// copied here because GLSL cannot include the C++ header. Both sides must agree element for element.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"
#ifdef PW_EPI
#define STORE float16_t
#define PW_EPI_BASE 2
#include "pw_epilogue.glsl"
#endif
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly  buffer Src { f16vec4 src[]; };
layout(std430, binding = 1) writeonly buffer Dst { f16vec4 dst[]; };
layout(push_constant) uniform PC { int N, C, IH, IW, OH, OW, mode, cm; float cubicA; int excludeOutside, perPixel, nm; } pc;

float coord(int d, int outS, int inS, int cm) {
  float scale = float(outS) / float(inS);
  if (cm == 1) return outS > 1 ? float(d) * float(inS - 1) / float(outS - 1) : 0.0;
  if (cm == 2) return float(d) / scale;
  if (cm == 3) return outS > 1 ? (float(d) + 0.5) / scale - 0.5 : 0.0;
  return (float(d) + 0.5) / scale - 0.5;
}
int clampi(int v, int lo, int hi) { return clamp(v, lo, hi); }
// Largest factor narrowMulDiv multiplies directly -- kResizeNarrowFactorMax in
// src/core/resize_rule.h, the greatest k whose square fits a 32-bit signed int.
#define RESIZE_NARROW_FACTOR_MAX 46340
// Bits of the left factor the bit-scanned path walks -- kResizeNarrowProductBits in
// src/core/resize_rule.h.
#define RESIZE_NARROW_PRODUCT_BITS 31
// floor(a * b / den) into q and the remainder in [0, den) into r, in 32-bit ints only, which is
// the arithmetic a Vulkan kernel is guaranteed -- resizeNarrowMulDiv in
// src/backend/cpu/ops/resize.cpp, kept identical here. Preconditions: a >= 0, b >= 0, den > 0,
// a <= den. Splitting b into whole multiples of den plus a residue below den leaves two factors
// each at most den: the direct path takes their product when both fit RESIZE_NARROW_FACTOR_MAX,
// and the bit-scanned path accumulates it from the top bit of a down otherwise, holding the
// running remainder inside [0, den) so no intermediate ever leaves the range one int holds.
void narrowMulDiv(int a, int b, int den, out int q, out int r) {
  int wholeSteps = b / den;
  int residue = b - wholeSteps * den;
  if (a <= RESIZE_NARROW_FACTOR_MAX && residue <= RESIZE_NARROW_FACTOR_MAX) {
    int product = a * residue;
    int direct = product / den;
    q = a * wholeSteps + direct;
    r = product - direct * den;
    return;
  }
  int tileQuotient = 0, rem = 0;
  for (int bit = RESIZE_NARROW_PRODUCT_BITS - 1; bit >= 0; --bit) {
    int headroom = den - rem;   // doubles rem by comparison, never by forming 2 * rem
    tileQuotient += tileQuotient;
    if (rem >= headroom) { rem -= headroom; ++tileQuotient; } else { rem += rem; }
    if (((a >> bit) & 1) != 0) {   // fold in one more copy of the residue, carrying the same way
      int slack = den - residue;
      if (rem >= slack) { rem -= slack; ++tileQuotient; } else { rem += residue; }
    }
  }
  q = a * wholeSteps + tileQuotient;
  r = rem;
}
// Nearest source index in exact integer arithmetic -- vxResizeNearestSrcNarrow in
// src/backend/cpu/ops/resize.cpp, kept identical here. coord() cannot decide it: an integer
// downsample factor under half_pixel puts every output pixel exactly on the round_prefer_floor
// tie, this driver evaluates the divide through a reciprocal, and one ulp there moves the sample
// a whole pixel. Integers make the index a pure function of the shape on any driver.
int nearestSrc(int d, int outS, int inS, int cm, int nm) {
  if (inS <= 0) return 0;   // an input axis of zero extent holds no pixel any rounding lands on
  // Each coordinate transform is one fraction (leftFactor * rightFactor - shift) / den. The shift
  // stays outside the product so narrowMulDiv sees two non-negative factors.
  int leftFactor, rightFactor, den, shift;
  if (cm == 1)      { leftFactor = d;         rightFactor = inS - 1; den = outS - 1; shift = 0; }
  else if (cm == 2) { leftFactor = d;         rightFactor = inS;     den = outS;     shift = 0; }
  else              { leftFactor = 2 * d + 1; rightFactor = inS;     den = 2 * outS; shift = outS; }
  if (den <= 0 || (cm == 3 && outS <= 1)) return 0;
  int q, r;
  narrowMulDiv(leftFactor, rightFactor, den, q, r);
  // The numerator's shift applies after the division: it is smaller than den, so it borrows at
  // most one whole step, which is the floor the rule needs.
  r -= shift;
  if (r < 0) { r += den; --q; }
  // The four ONNX nearest_mode roundings over the exact fraction q + r/den (codes in
  // src/core/resize_rule.h): 0 round_prefer_floor, 1 round_prefer_ceil, 2 floor, 3 ceil. The
  // midpoint tests read against den - r rather than 2 * r, which a denominator near the top of
  // the int range would not hold.
  if (nm == 1) return r >= den - r ? q + 1 : q;
  if (nm == 2) return q;
  if (nm == 3) return r > 0 ? q + 1 : q;
  return r > den - r ? q + 1 : q;
}

// Cubic taps for one axis -- vxResizeCubicWeights + the exclude_outside handling in
// src/backend/cpu/ops/resize.cpp. Returns the first tap index (floor - 1, unclamped) and fills the
// four weights; exclude_outside drops the taps that fall outside and renormalizes the axis.
int cubicAxis(float f, int inS, out float w[4]) {
  float fl = floor(f), t = f - fl;
  float t1 = 1.0 + t, t2 = 2.0 - t, tc = 1.0 - t, a = pc.cubicA;
  w[0] = a * t1 * t1 * t1 - 5.0 * a * t1 * t1 + 8.0 * a * t1 - 4.0 * a;
  w[1] = (a + 2.0) * t * t * t - (a + 3.0) * t * t + 1.0;
  w[2] = (a + 2.0) * tc * tc * tc - (a + 3.0) * tc * tc + 1.0;
  w[3] = a * t2 * t2 * t2 - 5.0 * a * t2 * t2 + 8.0 * a * t2 - 4.0 * a;
  int first = int(fl) - 1;
  if (pc.excludeOutside != 0) {
    float sum = 0.0;
    for (int k = 0; k < 4; ++k) { int tp = first + k; w[k] = (tp < 0 || tp >= inS) ? 0.0 : w[k]; sum += w[k]; }
    if (sum != 0.0) { for (int k = 0; k < 4; ++k) w[k] /= sum; }
  }
  return first;
}

void main() {
  int Cb = (pc.C + 3) / 4;
  // Two lane maps, chosen by the shape rule in resize.cpp (pc.perPixel) and byte-identical to each
  // other. perPixel: one lane per output PIXEL, looping the channel blocks inside -- the coordinate
  // transform, the integer nearest index and (in cubic mode) the two weight fans carry no channel
  // term, so the block-pixel map replays all of it Cb times in waves OH*OW apart that share no
  // cache. Otherwise: one lane per NC4HW4 block-pixel, which keeps a wave inside ONE channel block
  // and streams the source better -- what a shrinking output map wants, since it reads more than it
  // writes. The bound below must stay one expression: it is the lane count resize.cpp dispatches.
  uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (i >= uint(pc.perPixel != 0 ? pc.N * pc.OH * pc.OW : pc.N * Cb * pc.OH * pc.OW)) return;
  // A source plane with no elements has no pixel any arm can sample, and the tap clamps below
  // would fold to an empty range. src/backend/vulkan/ops/resize.cpp refuses that geometry; the
  // lane exits rather than resolving an index into a plane that holds nothing.
  if (pc.IH <= 0 || pc.IW <= 0) return;
  int ox = int(i) % pc.OW;
  int oy = (int(i) / pc.OW) % pc.OH;
  int cbFirst = 0, cbCount = Cb;
  int n;
  if (pc.perPixel != 0) {
    n = int(i) / (pc.OW * pc.OH);
  } else {
    cbFirst = (int(i) / (pc.OW * pc.OH)) % Cb;
    cbCount = 1;
    n = int(i) / (pc.OW * pc.OH * Cb);
  }
  // Source geometry and tap weights: identical fp32 arithmetic to the per-block form, once per pixel.
  int nearY = 0, nearX = 0, firstY = 0, firstX = 0, iy0 = 0, ix0 = 0;
  float wyc[4], wxc[4];
  float wyl = 0.0, wxl = 0.0;
  if (pc.mode == 0) {
    nearY = clampi(nearestSrc(oy, pc.OH, pc.IH, pc.cm, pc.nm), 0, pc.IH - 1);
    nearX = clampi(nearestSrc(ox, pc.OW, pc.IW, pc.cm, pc.nm), 0, pc.IW - 1);
  } else if (pc.mode == 2) {
    firstY = cubicAxis(coord(oy, pc.OH, pc.IH, pc.cm), pc.IH, wyc);
    firstX = cubicAxis(coord(ox, pc.OW, pc.IW, pc.cm), pc.IW, wxc);
  } else {
    float fy = coord(oy, pc.OH, pc.IH, pc.cm);
    float fx = coord(ox, pc.OW, pc.IW, pc.cm);
    iy0 = int(floor(fy)); ix0 = int(floor(fx));
    wyl = fy - float(iy0); wxl = fx - float(ix0);
  }
  for (int cb = cbFirst; cb < cbFirst + cbCount; ++cb) {
  int sb = (n * Cb + cb) * pc.IH * pc.IW;
  vec4 v;
  if (pc.mode == 0) {
    v = vec4(src[sb + nearY * pc.IW + nearX]);
  } else if (pc.mode == 2) {
    // Cubic convolution: 4 taps per axis at floor-1..floor+2, separable weights. Out-of-range taps
    // read the border pixel. The row-then-column summation order matches the CPU oracle's.
    v = vec4(0.0);
    for (int ty = 0; ty < 4; ++ty) {
      int row = sb + clampi(firstY + ty, 0, pc.IH - 1) * pc.IW;
      vec4 acc = vec4(0.0);
      for (int tx = 0; tx < 4; ++tx) acc += wxc[tx] * vec4(src[row + clampi(firstX + tx, 0, pc.IW - 1)]);
      v += wyc[ty] * acc;
    }
  } else {
    int cy0 = clampi(iy0, 0, pc.IH - 1), cx0 = clampi(ix0, 0, pc.IW - 1);
    int iy1 = clampi(iy0 + 1, 0, pc.IH - 1), ix1 = clampi(ix0 + 1, 0, pc.IW - 1);
    vec4 a = vec4(src[sb + cy0 * pc.IW + cx0]), b = vec4(src[sb + cy0 * pc.IW + ix1]);
    vec4 c = vec4(src[sb + iy1 * pc.IW + cx0]), d = vec4(src[sb + iy1 * pc.IW + ix1]);
    v = a * (1.0 - wyl) * (1.0 - wxl) + b * (1.0 - wyl) * wxl + c * wyl * (1.0 - wxl) + d * wyl * wxl;
  }
  int outIdx = (n * Cb + cb) * pc.OH * pc.OW + oy * pc.OW + ox;
#ifdef PW_EPI
  v = pw_apply4(v, outIdx);
#endif
  dst[outIdx] = f16vec4(v);
  }
}
