#version 450
// Resize (spatial) over NC4HW4 (fp16). nearest + bilinear + cubic; the mode/coord codes, the
// integer nearest index and the cubic weight fan are the rules in src/core/resize_rule.h,
// copied here because GLSL cannot include the C++ header. Both sides must agree element for element.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"
#ifdef PW_EPI
#define STORE float16_t
#define PW_EPI_BASE 2
#include "pw_epilogue.glsl"
#endif
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly  buffer Src { f16vec4 src[]; };
layout(std430, binding = 1) writeonly buffer Dst { f16vec4 dst[]; };
layout(push_constant) uniform PC { int N, C, IH, IW, OH, OW, mode, cm; float cubicA; int excludeOutside; } pc;

float coord(int d, int outS, int inS, int cm) {
  float scale = float(outS) / float(inS);
  if (cm == 1) return outS > 1 ? float(d) * float(inS - 1) / float(outS - 1) : 0.0;
  if (cm == 2) return float(d) / scale;
  if (cm == 3) return outS > 1 ? (float(d) + 0.5) / scale - 0.5 : 0.0;
  return (float(d) + 0.5) / scale - 0.5;
}
int clampi(int v, int lo, int hi) { return clamp(v, lo, hi); }
// Nearest source index in exact integer arithmetic -- vxResizeNearestSrc in
// src/backend/cpu/ops/resize.cpp, kept identical here. coord() cannot decide it: an integer
// downsample factor under half_pixel puts every output pixel exactly on the round_prefer_floor
// tie, this driver evaluates the divide through a reciprocal, and one ulp there moves the sample
// a whole pixel. Integers make the index a pure function of the shape on any driver.
int nearestSrc(int d, int outS, int inS, int cm) {
  int num, den;
  if (cm == 1)      { num = d * (inS - 1);            den = outS - 1; }
  else if (cm == 2) { num = d * inS;                  den = outS; }
  else              { num = (2 * d + 1) * inS - outS; den = 2 * outS; }
  if (den <= 0 || (cm == 3 && outS <= 1)) return 0;
  int q = num / den, r = num - q * den;
  if (r < 0) { q--; r += den; }   // GLSL division truncates toward zero; the rule needs floor
  return 2 * r > den ? q + 1 : q;
}

// Cubic taps for one axis -- vxResizeCubicWeights + the exclude_outside handling in
// src/backend/cpu/ops/resize.cpp. Returns the first tap index (floor - 1, unclamped) and fills the
// four weights; exclude_outside drops the taps that fall outside and renormalizes the axis.
int cubicAxis(float f, int inS, out float w[4]) {
  float fl = floor(f), t = f - fl;
  float t1 = 1.0 + t, t2 = 2.0 - t, tc = 1.0 - t, a = pc.cubicA;
  w[0] = a * t1 * t1 * t1 - 5.0 * a * t1 * t1 + 8.0 * a * t1 - 4.0 * a;
  w[1] = (a + 2.0) * t * t * t - (a + 3.0) * t * t + 1.0;
  w[2] = (a + 2.0) * tc * tc * tc - (a + 3.0) * tc * tc + 1.0;
  w[3] = a * t2 * t2 * t2 - 5.0 * a * t2 * t2 + 8.0 * a * t2 - 4.0 * a;
  int first = int(fl) - 1;
  if (pc.excludeOutside != 0) {
    float sum = 0.0;
    for (int k = 0; k < 4; ++k) { int tp = first + k; w[k] = (tp < 0 || tp >= inS) ? 0.0 : w[k]; sum += w[k]; }
    if (sum != 0.0) { for (int k = 0; k < 4; ++k) w[k] /= sum; }
  }
  return first;
}

void main() {
  int Cb = (pc.C + 3) / 4;
  uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (i >= uint(pc.N * Cb * pc.OH * pc.OW)) return;
  int ox = int(i) % pc.OW;
  int oy = (int(i) / pc.OW) % pc.OH;
  int cb = (int(i) / (pc.OW * pc.OH)) % Cb;
  int n = int(i) / (pc.OW * pc.OH * Cb);
  int sb = (n * Cb + cb) * pc.IH * pc.IW;
  vec4 v;
  if (pc.mode == 0) {
    int iy = nearestSrc(oy, pc.OH, pc.IH, pc.cm), ix = nearestSrc(ox, pc.OW, pc.IW, pc.cm);
    iy = clampi(iy, 0, pc.IH - 1); ix = clampi(ix, 0, pc.IW - 1);
    v = vec4(src[sb + iy * pc.IW + ix]);
  } else if (pc.mode == 2) {
    // Cubic convolution: 4 taps per axis at floor-1..floor+2, separable weights. Out-of-range taps
    // read the border pixel. The row-then-column summation order matches the CPU oracle's.
    float wy[4], wx[4];
    int firstY = cubicAxis(coord(oy, pc.OH, pc.IH, pc.cm), pc.IH, wy);
    int firstX = cubicAxis(coord(ox, pc.OW, pc.IW, pc.cm), pc.IW, wx);
    v = vec4(0.0);
    for (int ty = 0; ty < 4; ++ty) {
      int row = sb + clampi(firstY + ty, 0, pc.IH - 1) * pc.IW;
      vec4 acc = vec4(0.0);
      for (int tx = 0; tx < 4; ++tx) acc += wx[tx] * vec4(src[row + clampi(firstX + tx, 0, pc.IW - 1)]);
      v += wy[ty] * acc;
    }
  } else {
    float fy = coord(oy, pc.OH, pc.IH, pc.cm);
    float fx = coord(ox, pc.OW, pc.IW, pc.cm);
    int iy0 = int(floor(fy)), ix0 = int(floor(fx));
    float wy = fy - float(iy0), wx = fx - float(ix0);
    int cy0 = clampi(iy0, 0, pc.IH - 1), cx0 = clampi(ix0, 0, pc.IW - 1);
    int iy1 = clampi(iy0 + 1, 0, pc.IH - 1), ix1 = clampi(ix0 + 1, 0, pc.IW - 1);
    vec4 a = vec4(src[sb + cy0 * pc.IW + cx0]), b = vec4(src[sb + cy0 * pc.IW + ix1]);
    vec4 c = vec4(src[sb + iy1 * pc.IW + cx0]), d = vec4(src[sb + iy1 * pc.IW + ix1]);
    v = a * (1.0 - wy) * (1.0 - wx) + b * (1.0 - wy) * wx + c * wy * (1.0 - wx) + d * wy * wx;
  }
#ifdef PW_EPI
  v = pw_apply4(v, (n * Cb + cb) * pc.OH * pc.OW + oy * pc.OW + ox);
#endif
  dst[(n * Cb + cb) * pc.OH * pc.OW + oy * pc.OW + ox] = f16vec4(v);
}
