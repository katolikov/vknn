#version 450
// GridSample on the GPU (NC4HW4 fp16 data + flat grid). The data path samples whole channel-blocks
// (a vec4 per output pixel for every channel), so the channel axis is never permuted. The grid is a flat
// buffer (2 coords per output pixel) read as raw words: GRID_FP32 selects fp32 (a constant grid uploads
// fp32, and pinGridSampleGridFp32 pins a runtime grid's storage to fp32) or fp16 decode — normalized
// coordinates quantized to fp16 drift up to ~0.5 px at 1920-wide inputs, so the grid rides fp32 whenever
// the storage allows. MODE: 0=bilinear 1=nearest 2=cubic. PADMODE: 0=zeros 1=border 2=reflection.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"
#ifdef PW_EPI
#define STORE float16_t
#define PW_EPI_BASE 3
#include "pw_epilogue.glsl"
#endif
layout(constant_id = 0) const int MODE = 0;
layout(constant_id = 1) const int PADMODE = 0;
layout(constant_id = 2) const int GRID_FP32 = 0;
layout(local_size_x = 64, local_size_x_id = 3) in; // trailing spec = device-resolved lane width (env.convLocalSize)
layout(std430, binding = 0) readonly  buffer Src { f16vec4 src[]; };
layout(std430, binding = 1) readonly  buffer Grid { uint gridWords[]; };
layout(std430, binding = 2) writeonly buffer Dst { f16vec4 dst[]; };
layout(push_constant) uniform PC { int N, C, Hin, Win, OH, OW, align; } pc;

// Grid coordinate i decoded at the grid buffer's storage precision. Grid elements come in pairs
// (2 coords per output pixel), so an fp16 grid's element count is even and the word index never
// straddles the buffer end.
float gridAt(int i) {
  if (GRID_FP32 == 1) return uintBitsToFloat(gridWords[i]);
  return unpackHalf2x16(gridWords[i >> 1])[i & 1];
}

#include "gridsample_taps.glsl"
// A resolved tap read from a column index and a row offset. Only the zeros padding mode can
// produce an OOB axis, so the test compiles out of the border/reflection variants (PADMODE is a
// specialization constant) and their per-tap cost is a single add + load.
vec4 tapAt(int sb, int xr, int yw) {
  if (PADMODE == 0 && (xr < 0 || yw < 0)) return vec4(0.0);
  return vec4(src[sb + yw + xr]);
}

void main() {
  int Cb = (pc.C + 3) / 4;
  // One lane per output PIXEL, looping the channel blocks inside: the grid fetch, the coordinate
  // normalize/handle and (in cubic mode) the two weight fans carry no channel term, so a lane-per
  // block-pixel map replayed all of it Cb times in waves OH*OW apart that share no cache. The lane
  // count in gridsample.cpp is N*OH*OW and every variant of this kernel must agree with it.
  uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  if (i >= uint(pc.N * pc.OH * pc.OW)) return;
  int ox = int(i) % pc.OW;
  int oy = (int(i) / pc.OW) % pc.OH;
  int n = int(i) / (pc.OW * pc.OH);
  int gi = 2 * (n * pc.OH * pc.OW + oy * pc.OW + ox);
  int a = pc.align == 1 ? 1 : 0, b = 1 - a;
  float ix = handle(((1.0 + gridAt(gi + 0)) * float(pc.Win - a) - float(b)) * 0.5, pc.Win);
  float iy = handle(((1.0 + gridAt(gi + 1)) * float(pc.Hin - a) - float(b)) * 0.5, pc.Hin);
  // Tap axes and weights: identical fp32 arithmetic to the per-block form, resolved once per
  // pixel per axis (the tap grid is separable). The channel-block loop below is then pure
  // gather + accumulate — one add per tap, no padding or address math per block.
  int xr0 = 0, xr1 = 0, yw0 = 0, yw1 = 0;
  int cubicXr[GS_CUBIC_TAPS], cubicYw[GS_CUBIC_TAPS];
  float wxc[GS_CUBIC_TAPS], wyc[GS_CUBIC_TAPS];
  float wxl = 0.0, wyl = 0.0;
  if (MODE == 1) {
    xr0 = resolveTapX(int(floor(ix + 0.5)));
    yw0 = resolveTapRow(int(floor(iy + 0.5)));
  } else if (MODE == 2) {
    int x0 = int(floor(ix)), y0 = int(floor(iy));
    cubicW(ix - float(x0), wxc);
    cubicW(iy - float(y0), wyc);
    for (int t = 0; t < GS_CUBIC_TAPS; ++t) {
      cubicXr[t] = resolveTapX(x0 - 1 + t);
      cubicYw[t] = resolveTapRow(y0 - 1 + t);
    }
  } else {
    int x0 = int(floor(ix)), y0 = int(floor(iy));
    wxl = ix - float(x0); wyl = iy - float(y0);
    xr0 = resolveTapX(x0); xr1 = resolveTapX(x0 + 1);
    yw0 = resolveTapRow(y0); yw1 = resolveTapRow(y0 + 1);
  }
  for (int cb = 0; cb < Cb; ++cb) {
    int sb = (n * Cb + cb) * pc.Hin * pc.Win;
    vec4 v;
    if (MODE == 1) {
      v = tapAt(sb, xr0, yw0);
    } else if (MODE == 2) {
      v = vec4(0.0);
      for (int j = 0; j < GS_CUBIC_TAPS; ++j)
        for (int i2 = 0; i2 < GS_CUBIC_TAPS; ++i2)
          v += wyc[j] * wxc[i2] * tapAt(sb, cubicXr[i2], cubicYw[j]);
    } else {
      vec4 v00 = tapAt(sb, xr0, yw0), v01 = tapAt(sb, xr1, yw0);
      vec4 v10 = tapAt(sb, xr0, yw1), v11 = tapAt(sb, xr1, yw1);
      v = (1.0 - wyl) * ((1.0 - wxl) * v00 + wxl * v01) + wyl * ((1.0 - wxl) * v10 + wxl * v11);
    }
    int outIdx = (n * Cb + cb) * pc.OH * pc.OW + oy * pc.OW + ox;
#ifdef PW_EPI
    v = pw_apply4(v, outIdx);
#endif
    // TO_STORE4 saturates the cubic kernel's negative-lobe overshoot (up to ~1.06x the input range),
    // so a near-fp16-max activation never stores as +/-inf; byte-identical for in-range values.
    dst[outIdx] = TO_STORE4(v);
  }
}
