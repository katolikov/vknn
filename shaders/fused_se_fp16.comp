#version 450
// fp16-storage twin of fused_se.comp: the (transposed) weights, biases and the stored scale are
// fp16; the pooled partial sums stay fp32 and all arithmetic is fp32. See fused_se.comp.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "store16.glsl"
#include "common.glsl"
#define SE_MAX_CHANNELS 4096
#define SE_MAX_SQUEEZE 1024
#define SE_ACT_RELU 0
#define SE_ACT_SILU 1
#define SE_ACT_HARDSWISH 2
#define SE_GATE_HARDSIGMOID 0
#define SE_GATE_SIGMOID 1
#define SE_WORKGROUP 256
#include "se_codes.glsl"
layout(local_size_x = SE_WORKGROUP) in;
layout(std430, binding = 0) readonly  buffer P { vec4 part[]; };         // fp32 partial sums, [(n*Cb+cb)*groups + split]
layout(std430, binding = 1) readonly  buffer W1 { float16_t w1t[]; };    // [C][Cr] (FC1 weights, transposed)
layout(std430, binding = 2) readonly  buffer B1 { float16_t b1[]; };     // [Cr]
layout(std430, binding = 3) readonly  buffer W2 { float16_t w2t[]; };    // [Cr][C] (FC2 weights, transposed)
layout(std430, binding = 4) readonly  buffer B2 { float16_t b2[]; };     // [C]
layout(std430, binding = 5) writeonly buffer Scale { f16vec4 scale[]; }; // [N][Cb] blocked scale
layout(push_constant) uniform PC { int N, C, Cr, groups, hw, act, gate; float alpha, beta; } pc;
shared float chan[SE_MAX_CHANNELS]; // the pooled vector, then the gated FC2 outputs
shared float s1[SE_MAX_SQUEEZE];    // FC1 activations
shared float red[SE_WORKGROUP];     // FC1 slice partials
void main() {
  int Cb  = (pc.C + 3) / 4;
  int n   = int(gl_WorkGroupID.x);
  int tid = int(gl_LocalInvocationID.x);
  for (int cb = tid; cb < Cb; cb += SE_WORKGROUP) {
    vec4 acc  = vec4(0.0);
    int  base = (n * Cb + cb) * pc.groups;
    for (int g = 0; g < pc.groups; ++g) acc += part[base + g];
    vec4 a = acc / float(pc.hw);
    for (int l = 0; l < 4; ++l) if (cb * 4 + l < pc.C) chan[cb * 4 + l] = a[l];
  }
  barrier();
  int slices = max(SE_WORKGROUP / pc.Cr, 1);
  if (slices > 1) {
    int   j          = tid % pc.Cr;
    int   s          = tid / pc.Cr;
    float partialSum = 0.0;
    if (s < slices) {
      for (int c = s; c < pc.C; c += slices) partialSum += float(w1t[c * pc.Cr + j]) * chan[c];
    }
    red[tid] = partialSum;
    barrier();
    for (int jj = tid; jj < pc.Cr; jj += SE_WORKGROUP) {
      float acc = float(b1[jj]);
      for (int ss = 0; ss < slices; ++ss) acc += red[jj + ss * pc.Cr];
      s1[jj] = seAct(pc.act, acc);
    }
  } else {
    for (int jj = tid; jj < pc.Cr; jj += SE_WORKGROUP) {
      float acc = float(b1[jj]);
      for (int c = 0; c < pc.C; ++c) acc += float(w1t[c * pc.Cr + jj]) * chan[c];
      s1[jj] = seAct(pc.act, acc);
    }
  }
  barrier();
  for (int k = tid; k < pc.C; k += SE_WORKGROUP) {
    float acc = float(b2[k]);
    for (int j = 0; j < pc.Cr; ++j) acc += float(w2t[j * pc.C + k]) * s1[j];
    chan[k] = seGate(pc.gate, acc, pc.alpha, pc.beta);
  }
  barrier();
  for (int cb = tid; cb < Cb; cb += SE_WORKGROUP) {
    vec4 o = vec4(0.0);
    for (int l = 0; l < 4; ++l) if (cb * 4 + l < pc.C) o[l] = chan[cb * 4 + l];
    scale[n * Cb + cb] = f16vec4(o);
  }
}
