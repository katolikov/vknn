#version 450
#define VKNN_NO_RTE 1 // this kernel avoids the float-controls execution mode (miscompiled by some drivers); TO_STORE rounds explicitly
#include "precision.glsl"
#ifdef PW_EPI
#define PW_EPI_BASE 5
#include "pw_epilogue.glsl"
#endif
// Vector-load split-K mat-vec with a fused rank-1 [N] bias: out[...,n] = sum_k A*B + bias[n]. Mirrors
// matmul_gemv4.comp with binding 3 = bias; matmul.cpp selects this variant when a mat-vec MatMul with
// an N divisible by GEMV_VEC has a fused bias. The bias enters the reduction once, in the lane that
// stores, so it is added exactly once regardless of GEMV_KS.
#include "common.glsl"
#define GEMV_VEC 4 // adjacent n per lane, loaded as one vector element of B
#define GEMV_NX 16 // lanes along n; GEMV_NX * GEMV_VEC == 64 outputs per workgroup (matmul.cpp's kGemvNx)
#define GEMV_KS 16 // lanes reducing over k; GEMV_NX * GEMV_KS == 256 threads
#define GEMV_U 4   // k steps a lane loads before it consumes any of them (memory-level parallelism)
#ifdef USE_FP16
#define STORE4 f16vec4
#else
#define STORE4 vec4
#endif
layout(local_size_x = GEMV_NX, local_size_y = GEMV_KS) in;
layout(std430, binding = 0) readonly  buffer A  { STORE a[]; };
layout(std430, binding = 1) readonly  buffer B  { STORE4 b4[]; };
layout(std430, binding = 2) writeonly buffer D  { STORE d[]; };
layout(std430, binding = 3) readonly  buffer Bs { STORE bias[]; };
layout(std430, binding = 4) readonly buffer G { int g[]; } geom;
layout(push_constant) uniform PC {
  int rank, total, M, N, K, aK, bK;
} pc;

shared float part[GEMV_KS][GEMV_VEC][GEMV_NX];

void main() {
  uint blk = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
  uint x   = gl_LocalInvocationID.x;
  uint gid = blk * (GEMV_NX * GEMV_VEC) + x * GEMV_VEC;
  uint ky  = gl_LocalInvocationID.y;
  bool live = gid < uint(pc.total);

  int aBase = 0, bBase = 0;
  if (live) {
    int rem = int(gid);
    for (int k = pc.rank - 1; k >= 0; --k) {
      int c = rem % geom.g[k];
      rem /= geom.g[k];
      aBase += c * geom.g[pc.rank + k];
      bBase += c * geom.g[2 * pc.rank + k];
    }
  }
  int bVec  = bBase / GEMV_VEC;
  int bStep = pc.bK / GEMV_VEC;

  vec4 acc = vec4(0.0);
  if (live) {
    int k = int(ky);
    for (; k + (GEMV_U - 1) * GEMV_KS < pc.K; k += GEMV_U * GEMV_KS) {
      float a0 = float(a[aBase + k * pc.aK]);
      float a1 = float(a[aBase + (k + GEMV_KS) * pc.aK]);
      float a2 = float(a[aBase + (k + 2 * GEMV_KS) * pc.aK]);
      float a3 = float(a[aBase + (k + 3 * GEMV_KS) * pc.aK]);
      vec4  b0 = vec4(b4[bVec + k * bStep]);
      vec4  b1 = vec4(b4[bVec + (k + GEMV_KS) * bStep]);
      vec4  b2 = vec4(b4[bVec + (k + 2 * GEMV_KS) * bStep]);
      vec4  b3 = vec4(b4[bVec + (k + 3 * GEMV_KS) * bStep]);
      acc += a0 * b0;
      acc += a1 * b1;
      acc += a2 * b2;
      acc += a3 * b3;
    }
    for (; k < pc.K; k += GEMV_KS)
      acc += float(a[aBase + k * pc.aK]) * vec4(b4[bVec + k * bStep]);
  }
  part[ky][0][x] = acc.x;
  part[ky][1][x] = acc.y;
  part[ky][2][x] = acc.z;
  part[ky][3][x] = acc.w;
  barrier();
  if (ky != 0 || !live) return;

  int  n0 = int(gid) % pc.N; // N is the contiguous last output dim, and N % GEMV_VEC == 0
  vec4 s  = vec4(float(bias[n0]), float(bias[n0 + 1]), float(bias[n0 + 2]), float(bias[n0 + 3]));
  for (int i = 0; i < GEMV_KS; ++i) {
    s.x += part[i][0][x];
    s.y += part[i][1][x];
    s.z += part[i][2][x];
    s.w += part[i][3][x];
  }
#ifdef PW_EPI
  d[gid + 0u] = TO_STORE(pw_apply(s.x, int(gid) + 0));
  d[gid + 1u] = TO_STORE(pw_apply(s.y, int(gid) + 1));
  d[gid + 2u] = TO_STORE(pw_apply(s.z, int(gid) + 2));
  d[gid + 3u] = TO_STORE(pw_apply(s.w, int(gid) + 3));
#else
  d[gid + 0u] = TO_STORE(s.x);
  d[gid + 1u] = TO_STORE(s.y);
  d[gid + 2u] = TO_STORE(s.z);
  d[gid + 3u] = TO_STORE(s.w);
#endif
}
