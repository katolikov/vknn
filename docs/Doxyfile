# Doxygen configuration for the VKNN API docs. Run: ./build.sh --docs  (or ./scripts/gen_docs.sh)
PROJECT_NAME           = "VKNN"
PROJECT_BRIEF          = "Vulkan Neural Network — on-device inference engine (CNNs, transformers, 3D Gaussian Splatting)"
OUTPUT_DIRECTORY       = docs/api
INPUT                  = include/vknn src
FILE_PATTERNS          = *.h *.hpp *.cpp *.glsl *.comp
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
GENERATE_LATEX         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
JAVADOC_AUTOBRIEF      = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
SOURCE_BROWSER         = YES

# Doxygen documents only the C++/GLSL sources — the Markdown docs are rendered by the static site
# (scripts/gen_site.py), so feeding them here only produced spurious \ref warnings for their links.
WARN_IF_DOC_ERROR      = NO

# Stock Doxygen theme, default color style (HTML_COLORSTYLE stays unset: doxygen older than 1.9.5
# rejects the tag). The hand-built site (docs/site, via ./build.sh --docs) is the primary docs;
# this C++ API reference is secondary and linked from it.
GENERATE_TREEVIEW      = YES

# Include graphs render only where Graphviz dot is installed; the widest included-by graph
# (op.h) reaches ~72 nodes, above the default cap of 50.
DOT_GRAPH_MAX_NODES    = 100
